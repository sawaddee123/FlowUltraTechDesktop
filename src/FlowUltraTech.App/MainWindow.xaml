                                                                                        Tag="{Binding OverlayEndpointUrl}" />
                                                                            </DockPanel>
                                                                        </Border>

                                                                        <!-- COLUMN 2: Horological Design & Camera Physics Controls -->
                                                                        <Border Grid.Column="2" Background="{DynamicResource Surface2Brush}" CornerRadius="8" Padding="14,12">
                                                                            <StackPanel>
                                                                                <!-- Section Title -->
                                                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,10">
                                                                                    <Path Width="14" Height="14" Stretch="Uniform" Stroke="{DynamicResource LineBrush}" StrokeThickness="1.7"
                                                                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" Margin="0,0,7,0" VerticalAlignment="Center"
                                                                                          Data="M 8,1.5 A 6.5,6.5 0 1 1 7.99,1.5 Z M 8,4.2 L 8,8 L 10.6,9.6" />
                                                                                    <TextBlock Text="รูปแบบนาฬิกา" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource FgBrush}" VerticalAlignment="Center" />
                                                                                </StackPanel>

                                                                                <!-- Row 1: Clock Mode & Background Style -->
                                                                                <Grid Margin="0,0,0,8">
                                                                                    <Grid.ColumnDefinitions>
                                                                                        <ColumnDefinition Width="1.25*" />
                                                                                        <ColumnDefinition Width="10" />
                                                                                        <ColumnDefinition Width="0.75*" />
                                                                                    </Grid.ColumnDefinitions>
                                                                                    <StackPanel Grid.Column="0">
                                                                                        <TextBlock Text="รูปแบบนาฬิกา" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,4" />
