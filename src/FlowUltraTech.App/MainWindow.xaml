                                            <ui:SymbolIcon Symbol="Folder16" Foreground="{DynamicResource MutedBrush}" Margin="0,0,6,0" />
                                            <TextBlock Text="โฟลเดอร์ภาพ Captcha" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>

                                    <Button Style="{StaticResource PrimaryCtaButton}" Command="{Binding ScanAllCaptchasCommand}" Padding="14,6">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <ui:SymbolIcon Symbol="ShieldCheckmark16" Foreground="{DynamicResource OnPrimaryBrush}" Margin="0,0,6,0" />
                                            <TextBlock Text="ตรวจหาทุกบัญชี" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>

                            <!-- Master-Detail Dual Pane Grid -->
                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="260" />
                                    <ColumnDefinition Width="14" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- Left Column: Accounts List -->
                                <Border Grid.Column="0" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="8" Padding="10">
                                    <DockPanel LastChildFill="True">
                                        <TextBlock DockPanel.Dock="Top" Text="รายชื่อบัญชี" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="4,0,0,8" />

                                        <ListBox ItemsSource="{Binding Instances}" SelectedItem="{Binding SelectedCaptchaInstance}" SelectedIndex="0">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                        </Grid.RowDefinitions>

                                                        <!-- Row 0: Name & Port -->
                                                        <DockPanel Grid.Row="0" LastChildFill="True">
                                                            <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource FgBrush}" />
                                                        </DockPanel>

                                                        <!-- Row 1: Status Badge -->
                                                        <Border Grid.Row="1" CornerRadius="4" Padding="6,2" Margin="0,6,0,6" HorizontalAlignment="Left">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Background" Value="{DynamicResource Surface2Brush}" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsCaptchaAlertVisible}" Value="True">
                                                                            <Setter Property="Background" Value="{DynamicResource BadSoftBrush}" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                                            <Setter Property="Background" Value="{DynamicResource OkSoftBrush}" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <TextBlock FontSize="10" FontWeight="SemiBold">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Text" Value="สแตนด์บาย" />
                                                                        <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsCaptchaAlertVisible}" Value="True">
                                                                                <Setter Property="Text" Value="{Binding DetectedCaptchaCount, StringFormat='พบ Captcha ({0})'}" />
                                                                                <Setter Property="Foreground" Value="{DynamicResource BadBrush}" />
                                                                            </DataTrigger>
                                                                            <MultiDataTrigger>
                                                                                <MultiDataTrigger.Conditions>
                                                                                    <Condition Binding="{Binding IsRunning}" Value="True" />
                                                                                    <Condition Binding="{Binding IsCaptchaAlertVisible}" Value="False" />
                                                                                </MultiDataTrigger.Conditions>
                                                                                <Setter Property="Text" Value="ปกติ (เฝ้าระวัง)" />
                                                                                <Setter Property="Foreground" Value="{DynamicResource OkBrush}" />
                                                                            </MultiDataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </Border>

                                                        <!-- Row 2: Micro Buttons -->
                                                        <StackPanel Grid.Row="2" Orientation="Horizontal">
                                                            <Button Style="{StaticResource MicroButton}" Content="ตรวจหา" Command="{Binding ScanCaptchaNowCommand}" IsEnabled="{Binding IsRunning}" ToolTip="กดเริ่มทำงานบัญชีนี้ก่อน" ToolTipService.ShowOnDisabled="True" Margin="0,0,4,0" />
                                                        </StackPanel>
                                                    </Grid>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </DockPanel>
                                </Border>

                                <!-- Right Column: Detail Inspector for Selected Account -->
                                <Border Grid.Column="2" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="8" Padding="14">
                                    <Grid>
                                        <!-- State 1: When No Account is Selected -->
                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="{Binding NoSelectedCaptchaVisibility}">
                                            <ui:SymbolIcon Symbol="ShieldCheckmark24" FontSize="36" Foreground="{DynamicResource SubtleBrush}" HorizontalAlignment="Center" Margin="0,0,0,10" />
                                            <TextBlock Text="เลือกบัญชีจากรายการทางซ้ายเพื่อดูรายละเอียด Captcha" FontSize="13" FontWeight="Medium" HorizontalAlignment="Center" Foreground="{DynamicResource MutedBrush}" />
                                        </StackPanel>

                                        <!-- State 2: When an Account is Selected -->
                                        <Grid DataContext="{Binding SelectedCaptchaInstance}" Visibility="{Binding DataContext.HasSelectedCaptchaVisibility, RelativeSource={RelativeSource AncestorType=Window}}">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="160" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="*" />
                                            </Grid.RowDefinitions>

                                            <!-- Top Toolbar -->
                                            <DockPanel Grid.Row="0" Margin="0,0,0,12">
                                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="15" Foreground="{DynamicResource FgBrush}" Margin="0,0,8,0" />
                                                    <Button Style="{StaticResource PrimaryCtaButton}" Content="ตรวจหาเดี๋ยวนี้" Command="{Binding ScanCaptchaNowCommand}" IsEnabled="{Binding IsRunning}" ToolTip="กดเริ่มทำงานบัญชีนี้ก่อน" ToolTipService.ShowOnDisabled="True" Margin="0,0,6,0" Padding="10,4" />
                                                    <Button Style="{StaticResource ActionDarkButton}" Content="ล้างผลลัพธ์" Command="{Binding ClearCaptchaResultsCommand}" Margin="0,0,10,0" />
                                                </StackPanel>

                                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                                                    <CheckBox Content="ตรวจหาอัตโนมัติ" IsChecked="{Binding IsCaptchaAutoDetect}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                                </StackPanel>
                                            </DockPanel>

                                            <!-- Visual Captcha Display Card -->
                                            <Border Grid.Row="1" Background="{DynamicResource Surface2Brush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,10">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasCaptchaImage}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsCaptchaAlertVisible}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="240" />
                                                        <ColumnDefinition Width="16" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>

                                                    <!-- Left: Captcha Image Box -->
                                                    <Border Grid.Column="0" Background="{DynamicResource BgBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="6" Padding="4" MaxHeight="180" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <Grid>
                                                            <Image Source="{Binding CaptchaImageSource}" Stretch="Uniform" MaxHeight="170" />
                                                            <TextBlock Text="กำลังรอรูปภาพ..." Foreground="{DynamicResource SubtleBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding HasCaptchaImage}" Value="False">
                                                                                <Setter Property="Visibility" Value="Visible" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </Grid>
                                                    </Border>

                                                    <!-- Right: Captcha Metadata & Actions -->
                                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                        <DockPanel LastChildFill="False" Margin="0,0,0,6">
                                                            <Border Background="{DynamicResource BadBrush}" CornerRadius="4" Padding="8,2" VerticalAlignment="Center">
                                                                <TextBlock Text="พบ Captcha" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource OnPrimaryBrush}" />
                                                            </Border>
                                                            <Border Background="{DynamicResource Surface3Brush}" CornerRadius="4" Padding="6,2" Margin="8,0,0,0" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding DetectedCaptchaTypeDescription}" FontSize="11" Foreground="{DynamicResource WarnBrush}" FontWeight="SemiBold" />
                                                            </Border>
                                                        </DockPanel>

                                                        <StackPanel Orientation="Horizontal" Margin="0,2,0,4">
                                                            <TextBlock Text="เวลานับถอยหลัง: " FontSize="12" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" />
                                                            <TextBlock Text="{Binding DetectedCaptchaCountdown, FallbackValue='00:00'}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource BadBrush}" VerticalAlignment="Center" Margin="4,0,0,0" />
                                                        </StackPanel>

                                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                            <TextBlock Text="รหัสโจทย์: " FontSize="11" Foreground="{DynamicResource SubtleBrush}" VerticalAlignment="Center" />
                                                            <TextBlock Text="{Binding DetectedCaptchaSessionId, FallbackValue='-'}" FontSize="11" FontFamily="{StaticResource MonoFont}" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="4,0,0,0" />
                                                        </StackPanel>

                                                        <TextBlock Text="{Binding LastCapturedImagePath, StringFormat='ไฟล์: {0}'}" FontSize="10" FontFamily="{StaticResource MonoFont}" Foreground="{DynamicResource OkBrush}" TextTrimming="CharacterEllipsis" Margin="0,0,0,8" />

                                                        <StackPanel Orientation="Horizontal">
                                                            <Button Style="{StaticResource ActionDarkButton}" Content="ปิดเสียงเตือน" Command="{Binding SilenceAlertCommand}" Margin="0,0,6,0" />
                                                            <Button Style="{StaticResource PrimaryCtaButton}" Content="เปิดโฟลเดอร์ภาพ" Command="{Binding OpenCaptchaImageFolderCommand}" Margin="0,0,6,0" Padding="10,4" />
                                                            <Button Style="{StaticResource ActionDarkButton}" Content="คัดลอกรูปภาพ" Command="{Binding CopyCaptchaImageCommand}" Margin="0,0,6,0" />
                                                            <Button Style="{StaticResource ActionDarkButton}" Content="บันทึกภาพ" Command="{Binding SaveCaptchaImageAsCommand}" />
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>

                                            <!-- Elements DataGrid -->

                                            <!-- HTML Preview Header -->

                                            <!-- Code Viewer -->
                                        </Grid>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Grid>
                    </Grid>

                    <!-- VIEW 2: NETWORK & NATIVE PROXY POOL -->
                    <Grid Visibility="{Binding IsNavProxies, Converter={StaticResource BoolToVis}}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!-- VIEW HEADER: Title (Left) + Action buttons (Right) -->
                            <Grid Grid.Row="0" Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="Proxy" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource FgBrush}" VerticalAlignment="Center" />
                                    <Border Background="{DynamicResource Surface2Brush}" CornerRadius="10" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Proxies.Count, StringFormat='{}{0} รายการ'}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryBrush}" />
                                    </Border>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Button Style="{StaticResource ActionDarkButton}" Content="บันทึกและใช้งาน" Command="{Binding ApplyNativeProxiesCommand}" Margin="0,0,8,0" Padding="12,6" />
                                    <Button Style="{StaticResource PrimaryCtaButton}" Content="เพิ่ม Proxy" Command="{Binding AddProxyCommand}" Padding="14,6" />
                                </StackPanel>
                            </Grid>

                            <Border Grid.Row="1" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,0,10">
                                <TextBlock Text="ตั้ง Proxy ไว้ที่นี่ แล้วเลือกใช้กับแต่ละบัญชีได้ที่แท็บ «บัญชี» ของบัญชีนั้น" FontSize="11" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" />
                            </Border>

                            <!-- Proxies List -->
                            <DataGrid Grid.Row="2" ItemsSource="{Binding Proxies}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="ชื่อ Proxy" Binding="{Binding Name}" Width="140" />
                                    <DataGridTextColumn Header="ประเภท" Binding="{Binding Protocol}" Width="145" />
                                    <DataGridTextColumn Header="ที่อยู่ (IP)" Binding="{Binding Host}" Width="160" />
                                    <DataGridTextColumn Header="พอร์ต" Binding="{Binding Port}" Width="75" />
                                    <DataGridTextColumn Header="ชื่อผู้ใช้" Binding="{Binding Username}" Width="115" />
                                    <DataGridTextColumn Header="รหัสผ่าน" Binding="{Binding Password}" Width="115" />
                                    <DataGridCheckBoxColumn Header="เปิดใช้งาน" Binding="{Binding IsActive}" Width="85" />
                                    <DataGridTemplateColumn Header="จัดการ / ทดสอบ" Width="*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <Button Style="{StaticResource MicroButton}" Content="ทดสอบ"
                                                            Command="{Binding DataContext.TestProxyItemCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                            CommandParameter="{Binding}" Margin="0,0,6,0" />
                                                    <Button Style="{StaticResource MicroButton}" Content="ลบ"
                                                            Command="{Binding DataContext.RemoveProxyCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                            CommandParameter="{Binding}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Grid>

                    <!-- VIEW 3: AUTO-REPLY RULES -->
                    <Grid Visibility="{Binding IsNavRules, Converter={StaticResource BoolToVis}}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!-- VIEW HEADER: Title (Left) + Action buttons (Right) -->
                            <Grid Grid.Row="0" Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="ตอบแชทอัตโนมัติ" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource FgBrush}" VerticalAlignment="Center" />
                                    <Border Background="{DynamicResource Surface2Brush}" CornerRadius="10" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Rules.Count, StringFormat='{}{0} กฎ'}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryBrush}" />
                                    </Border>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Button Style="{StaticResource PrimaryCtaButton}" Content="เพิ่มกฎ" Command="{Binding AddRuleCommand}" Padding="14,6" />
                                </StackPanel>
                            </Grid>

                            <DataGrid Grid.Row="1" ItemsSource="{Binding Rules}">
                                <DataGrid.Columns>
                                    <DataGridCheckBoxColumn Header="เปิดใช้" Binding="{Binding IsEnabled}" Width="70" />
                                    <DataGridTextColumn Header="ชื่อกฎ" Binding="{Binding Name}" Width="160" />
                                    <DataGridComboBoxColumn Header="เงื่อนไข" SelectedItemBinding="{Binding TriggerType}" Width="150">
                                        <DataGridComboBoxColumn.ElementStyle>
                                            <Style TargetType="ComboBox">
                                                <Setter Property="ItemsSource" Value="{Binding DataContext.RuleTriggerTypes, RelativeSource={RelativeSource AncestorType=DataGrid}}" />
                                            </Style>
                                        </DataGridComboBoxColumn.ElementStyle>
                                        <DataGridComboBoxColumn.EditingElementStyle>
                                            <Style TargetType="ComboBox">
                                                <Setter Property="ItemsSource" Value="{Binding DataContext.RuleTriggerTypes, RelativeSource={RelativeSource AncestorType=DataGrid}}" />
                                            </Style>
                                        </DataGridComboBoxColumn.EditingElementStyle>
                                    </DataGridComboBoxColumn>
                                    <DataGridTextColumn Header="คำค้นหา" Binding="{Binding Pattern}" Width="140" />
                                    <DataGridTextColumn Header="เพชรขั้นต่ำ" Binding="{Binding MinDiamonds}" Width="90" />
                                    <DataGridTextColumn Header="ข้อความตอบกลับ" Binding="{Binding ResponseTemplate}" Width="*" />
                                    <DataGridTextColumn Header="เว้นระยะ (วิ)" Binding="{Binding CooldownSeconds}" Width="90" />
                                    <DataGridTemplateColumn Header="" Width="70">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Style="{StaticResource MicroButton}" Content="ลบ" ToolTip="ลบกฎนี้"
                                                        Command="{Binding DataContext.RemoveRuleCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                        CommandParameter="{Binding}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Grid>

                    <!-- VIEW 4: SETTINGS -->
                    <Grid Visibility="{Binding IsNavSettings, Converter={StaticResource BoolToVis}}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!-- VIEW HEADER: Title (Left) + Action buttons (Right) -->
                            <Grid Grid.Row="0" Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="ตั้งค่า" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource FgBrush}" VerticalAlignment="Center" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Button Style="{StaticResource PrimaryCtaButton}" Content="บันทึกการตั้งค่า" Command="{Binding SaveSettingsCommand}" Padding="18,6" />
                                </StackPanel>
                            </Grid>

                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="0,0,12,0">
                                    <!-- ============================================================== -->
                                    <!-- CARD 1 (PRIORITY 1): USER ACCOUNT & LICENSE MANAGEMENT        -->
                                    <!-- ============================================================== -->
                                    <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1.5" CornerRadius="10" Margin="0,0,0,14" Padding="18">
                                        <StackPanel>
                                            <DockPanel LastChildFill="True" Margin="0,0,0,14">
                                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                                                    <Button Style="{StaticResource ActionDarkButton}" Content="ตรวจสิทธิ์ใหม่" Command="{Binding RefreshLicenseCommand}" Margin="0,0,8,0" Padding="14,6" ToolTip="ตรวจสิทธิ์การใช้งานล่าสุด" />
                                                    <Button Style="{StaticResource ActionDarkButton}" Content="ซิงค์ข้อมูล" Command="{Binding SyncWithCloudCommand}" Margin="0,0,8,0" Padding="14,6" ToolTip="ส่งข้อมูลบัญชีและการตั้งค่าไปเก็บไว้บนระบบ" />
                                                    <Button Style="{StaticResource StopDangerButton}" Content="ออกจากระบบ" Command="{Binding LogoutCommand}" Padding="14,6" ToolTip="ออกจากระบบและสลับไปยังหน้าต่างล็อกอิน" />
                                                </StackPanel>

                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Border Width="36" Height="36" CornerRadius="8" Background="{DynamicResource PrimarySoftBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" Margin="0,0,12,0">
                                                        <ui:SymbolIcon Symbol="Person20" FontSize="18" Foreground="{DynamicResource PrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                    <StackPanel VerticalAlignment="Center">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding LoggedInUsername, FallbackValue='ผู้ใช้งานระบบ'}" FontWeight="Bold" FontSize="16" Foreground="{DynamicResource FgBrush}" VerticalAlignment="Center" />
                                                            <Border Background="{DynamicResource PrimarySoftBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="4" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center">
<Border.Style><Style TargetType="Border"><Style.Triggers><DataTrigger Binding="{Binding LicenseRole}" Value=""><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></Border.Style>
                                                                <TextBlock Text="{Binding LicenseRole, FallbackValue='user'}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryBrush}" />
                                                            </Border>
                                                            <Border Background="{DynamicResource OkSoftBrush}" BorderBrush="{DynamicResource OkBrush}" BorderThickness="1" CornerRadius="4" Padding="8,2" Margin="6,0,0,0" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding LicensePlan, FallbackValue='Standard'}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource OkBrush}" />
                                                            </Border>
                                                        </StackPanel>
                                                        <TextBlock Text="บัญชีและสิทธิ์การใช้งานบนเครื่องนี้" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="0,2,0,0" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </DockPanel>

                                            <Separator Background="{DynamicResource Surface3Brush}" Margin="0,0,0,14" />

                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="180" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>

                                                <!-- Quota Info -->
                                                <TextBlock Grid.Row="0" Grid.Column="0" Text="จำนวนบัญชีที่ใช้ได้:" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="0,6" />
                                                <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,6">
                                                    <Border Background="{DynamicResource OkSoftBrush}" BorderBrush="{DynamicResource OkBrush}" BorderThickness="1" CornerRadius="6" Padding="12,3">
                                                        <TextBlock Text="{Binding MaxTiktokAccounts, StringFormat='{}{0} บัญชี (จอ)'}" FontWeight="Bold" Foreground="{DynamicResource OkBrush}" FontSize="13" />
                                                    </Border>
                                                    <TextBlock Text="{Binding QuotaStatusSummary, StringFormat='(กำลังทำงาน: {0})'}" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="10,0,0,0" VerticalAlignment="Center" />
                                                    <TextBlock Text="" Foreground="{DynamicResource SubtleBrush}" FontSize="11" Margin="8,0,0,0" VerticalAlignment="Center" />
                                                </StackPanel>

                                                <!-- Expiry Info -->
                                                <TextBlock Grid.Row="1" Grid.Column="0" Text="หมดอายุ:" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="0,6" />
                                                <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,6">
                                                    <TextBlock Text="{Binding LicenseExpiryText}" FontWeight="SemiBold" Foreground="{DynamicResource WarnBrush}" FontSize="12" VerticalAlignment="Center" />
                                                    <TextBlock Text=" (ต่ออายุได้ที่ผู้ดูแล)" Foreground="{DynamicResource SubtleBrush}" FontSize="11" Margin="8,0,0,0" VerticalAlignment="Center" />
                                                </StackPanel>

                                                <!-- Server Endpoint -->
                                                <TextBlock Grid.Row="2" Grid.Column="0" Text="การเชื่อมต่อ:" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="0,6" />
                                                <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,6">
                                                    <Border Width="6" Height="6" CornerRadius="3" Background="{DynamicResource OkBrush}" Margin="8,0,4,0" VerticalAlignment="Center" />
                                                    <TextBlock Text="เชื่อมต่อเรียบร้อย" Foreground="{DynamicResource OkBrush}" FontSize="11" VerticalAlignment="Center" />
                                                </StackPanel>

                                                <!-- Machine HWID -->
                                                <TextBlock Grid.Row="3" Grid.Column="0" Text="รหัสเครื่อง:" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="0,6" />
                                                <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,6">
                                                    <TextBlock Text="{Binding CurrentMachineHwid}" Foreground="{DynamicResource SubtleBrush}" FontSize="11" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Grid>

                                            <!-- Status / Error Notification -->
                                            <TextBlock Text="{Binding LoginErrorMessage}" Foreground="{DynamicResource PrimaryBrush}" FontSize="11" Margin="0,6,0,0" />
                                        </StackPanel>
                                    </Border>

                                    <!-- ============================================================== -->
                                    <!-- CARD 2 (PRIORITY 2): AUTOMATION & AI CAPTCHA SOLVER            -->
                                    <!-- ============================================================== -->
                                    <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="8" Margin="0,0,0,14" Padding="16">
                                        <StackPanel>
                                            <TextBlock Text="การแก้ Captcha และเสียงเตือน" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource FgBrush}" Margin="0,0,0,10" />

                                            <Grid Margin="0,0,0,10">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="180" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <!-- AI Engine Status -->
                                                <TextBlock Grid.Row="0" Grid.Column="0" Text="ตัวแก้ Captcha:" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="0,6" />
                                                <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,6">
                                                    <Border Background="{DynamicResource PrimarySoftBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="4" Padding="8,3">
                                                        <TextBlock Text="ระบบแก้ Captcha อัตโนมัติ" Foreground="{DynamicResource PrimaryBrush}" FontSize="11" FontWeight="SemiBold" />
                                                    </Border>
                                                    </StackPanel>


                                                <!-- Auto-Solve Toggle -->
                                                <TextBlock Grid.Row="2" Grid.Column="0" Text="แก้ Captcha:" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="0,6" />
                                                <StackPanel Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,6">
                                                    <CheckBox Content="แก้ให้อัตโนมัติเมื่อพบ Captcha" IsChecked="{Binding AutoSolveCaptcha}" VerticalAlignment="Center" />
                                                </StackPanel>

                                                <!-- Solve Delay Slider -->
                                                <TextBlock Grid.Row="3" Grid.Column="0" Text="รอก่อนแก้ (วินาที):" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="0,6" />
                                                <DockPanel Grid.Row="3" Grid.Column="1" Margin="0,6,8,6">
                                                    <TextBlock Text="{Binding AutoSolveDelaySeconds, StringFormat='{}{0} วินาที'}" DockPanel.Dock="Right" Width="60" TextAlignment="Right" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryBrush}" Margin="8,0,0,0" />
                                                    <Slider Minimum="0" Maximum="30" Value="{Binding AutoSolveDelaySeconds}" TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center" />
                                                </DockPanel>
                                                <TextBlock Grid.Row="3" Grid.Column="2" Text="แนะนำ 3-5 วินาที" Foreground="{DynamicResource SubtleBrush}" FontSize="11" VerticalAlignment="Center" />
                                            </Grid>

                                            <Separator Margin="0,4,0,10" Background="{DynamicResource Surface3Brush}" />

                                            <!-- Captcha Sound Alert Settings -->
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="180" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Grid.Row="0" Grid.Column="0" Text="เสียงแจ้งเตือน:" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="0,6" />
                                                <StackPanel Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <CheckBox Content="เปิดเสียงเมื่อตรวจพบ Captcha" IsChecked="{Binding EnableCaptchaSoundAlert}" VerticalAlignment="Center" Margin="0,0,16,0" />
                                                    <CheckBox Content="เล่นเสียงวนซ้ำจนกว่าจะแก้เสร็จ" IsChecked="{Binding LoopCaptchaSoundAlert}" VerticalAlignment="Center" />
                                                </StackPanel>

                                                <TextBlock Grid.Row="1" Grid.Column="0" Text="ระดับความดังเสียง:" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="0,6" />
                                                <DockPanel Grid.Row="1" Grid.Column="1" Margin="0,6,8,6">
                                                    <TextBlock Text="{Binding CaptchaSoundVolume, StringFormat='{}{0}%'}" DockPanel.Dock="Right" Width="40" TextAlignment="Right" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryBrush}" Margin="8,0,0,0" />
                                                    <Slider Minimum="0" Maximum="100" Value="{Binding CaptchaSoundVolume}" TickFrequency="5" IsSnapToTickEnabled="True" VerticalAlignment="Center" />
                                                </DockPanel>
                                                <StackPanel Grid.Row="1" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Button Style="{StaticResource ActionDarkButton}" Content="ทดสอบเสียง" Command="{Binding TestSoundCommand}" Margin="0,0,6,0" />
                                                    <Button Style="{StaticResource ActionDarkButton}" Content="หยุดเสียง" Command="{Binding StopSoundCommand}" />
                                                </StackPanel>

                                                <TextBlock Grid.Row="2" Grid.Column="0" Text="ไฟล์เสียงเตือน:" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="0,6" />
                                                <ui:TextBox Grid.Row="2" Grid.Column="1" Text="{Binding CaptchaSoundFilePath, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="เว้นว่างไว้เพื่อใช้เสียงมาตรฐานของระบบ" Margin="0,6,8,6" />
                                                <Button Grid.Row="2" Grid.Column="2" Style="{StaticResource ActionDarkButton}" Content="เลือกไฟล์..." Command="{Binding BrowseSoundFileCommand}" VerticalAlignment="Center" />
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <!-- ============================================================== -->
                                    <!-- CARD 3 (PRIORITY 3): TELEGRAM BOT NOTIFICATIONS                -->
                                    <!-- ============================================================== -->
                                    <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="8" Margin="0,0,0,14" Padding="16">
                                        <StackPanel>
                                            <TextBlock Text="แจ้งเตือนผ่าน Telegram" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource FgBrush}" Margin="0,0,0,10" />

                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="180" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Grid.Row="0" Grid.Column="0" Text="การแจ้งเตือน:" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="0,6" />
                                                <StackPanel Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <CheckBox Content="เปิดการแจ้งเตือนผ่าน Telegram" IsChecked="{Binding EnableTelegramAlert}" VerticalAlignment="Center" />
                                                </StackPanel>

                                                <TextBlock Grid.Row="1" Grid.Column="0" Text="โทเคนบอต:" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="0,6" />
                                                <ui:TextBox Grid.Row="1" Grid.Column="1" Text="{Binding TelegramBotToken, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="เช่น 123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ..." Margin="0,6,8,6" />
                                                <Button Grid.Row="1" Grid.Column="2" Style="{StaticResource ActionDarkButton}" Content="ทดสอบส่งข้อความ" Command="{Binding TestTelegramCommand}" VerticalAlignment="Center" />

                                                <TextBlock Grid.Row="2" Grid.Column="0" Text="รหัสแชทหรือกลุ่ม:" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="0,6" />
                                                <ui:TextBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding TelegramChatId, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="เช่น 987654321 หรือ -100123456789" Margin="0,6,0,6" />

                                                <TextBlock Grid.Row="3" Grid.Column="0" Text="เหตุการณ์ที่แจ้งเตือน:" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Top" Margin="0,8,0,0" />
                                                <StackPanel Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,6,0,6">
                                                    <CheckBox Content="แจ้งเตือนเมื่อตรวจพบ Captcha" IsChecked="{Binding TelegramAlertOnDetected}" Margin="0,2,0,4" />
                                                    <CheckBox Content="แนบรูป Captcha" IsChecked="{Binding TelegramSendPhoto}" Margin="20,0,0,6" />
                                                    <CheckBox Content="รายงานเมื่อแก้ Captcha สำเร็จ" IsChecked="{Binding TelegramAlertOnSolved}" Margin="0,2,0,4" />
                                                    <CheckBox Content="แจ้งเตือนเมื่อแก้ Captcha ล้มเหลว" IsChecked="{Binding TelegramAlertOnFailed}" Margin="0,2,0,4" />
                                                </StackPanel>

                                                <TextBlock Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding TelegramTestStatus}" Foreground="{DynamicResource PrimaryBrush}" FontSize="11" Margin="0,2,0,0" />
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <!-- ============================================================== -->
                                    <!-- CARD 4 (PRIORITY 4): STORAGE, PATHS & SYSTEM PERFORMANCE       -->
                                    <!-- ============================================================== -->
                                    <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="8" Margin="0,0,0,16" Padding="16">
                                        <StackPanel>
                                            <TextBlock Text="การจัดเก็บและประสิทธิภาพ" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource FgBrush}" Margin="0,0,0,10" />

                                            <!-- Captcha Image Storage -->
                                            <Grid Margin="0,0,0,10">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="180" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Grid.Row="0" Grid.Column="0" Text="บันทึกภาพ Captcha:" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="0,6" />
                                                <StackPanel Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <CheckBox Content="บันทึกภาพลงเครื่องอัตโนมัติ" IsChecked="{Binding AutoSaveCaptchaImage}" VerticalAlignment="Center" />
                                                </StackPanel>

                                                <TextBlock Grid.Row="1" Grid.Column="0" Text="โฟลเดอร์บันทึกภาพ:" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="0,6" />
                                                <ui:TextBox Grid.Row="1" Grid.Column="1" Text="{Binding CaptchaSaveDirectory, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="โฟลเดอร์เก็บภาพ Captcha" Margin="0,6,8,6" />
                                                <StackPanel Grid.Row="1" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Button Style="{StaticResource ActionDarkButton}" Content="เลือกโฟลเดอร์..." Command="{Binding BrowseSaveDirectoryCommand}" Margin="0,0,6,0" />
                                                    <Button Style="{StaticResource ActionDarkButton}" Content="เปิดโฟลเดอร์" Command="{Binding OpenCaptchaFolderCommand}" Margin="0,0,6,0" />
                                                    <Button Style="{StaticResource ActionDarkButton}" Content="โฟลเดอร์บันทึก" Command="{Binding OpenLogsFolderCommand}" ToolTip="เปิดโฟลเดอร์บันทึกระบบสำหรับส่งให้ผู้ดูแลตรวจสอบ" />
                                                </StackPanel>
                                            </Grid>

                                            <Separator Margin="0,2,0,10" Background="{DynamicResource Surface3Brush}" />

                                            <!-- Executable Paths -->
                                            <Grid Margin="0,0,0,10">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="180" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Grid.Row="0" Grid.Column="0" Text="ตำแหน่งโปรแกรม TikTok LIVE Studio:" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="0,6" />
                                                <ui:TextBox Grid.Row="0" Grid.Column="1" Text="{Binding StudioExePath, UpdateSourceTrigger=PropertyChanged}" Margin="0,6" />


                                            </Grid>

                                            <Separator Margin="0,2,0,10" Background="{DynamicResource Surface3Brush}" />

                                            <!-- Performance Setting -->
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="180" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="ประสิทธิภาพ:" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="0,6" />
                                                <CheckBox Grid.Column="1" Content="ซ่อนหน้าต่างสตูดิโอเมื่อเริ่มทำงาน (ช่วยให้เครื่องเบาขึ้น)" IsChecked="{Binding AutoHideOnLaunch}" VerticalAlignment="Center" Margin="0,6" />
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- 3. BOTTOM STATUS BAR (FULL WIDTH) -->
        <Border Grid.Row="2" Background="{DynamicResource SurfaceBrush}" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource LineBrush}" Padding="16,6">
            <DockPanel LastChildFill="False">
                <!-- Left: Last Log & Status -->
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                    <Border Width="7" Height="7" CornerRadius="3.5" Background="{DynamicResource OkBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />
                    <TextBlock Text="สถานะ: " Foreground="{DynamicResource MutedBrush}" FontSize="11" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding StatusNotification}" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryBrush}" FontSize="11" VerticalAlignment="Center" />
                </StackPanel>

                <!-- Right: Stats -->
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Instances.Count, StringFormat='บัญชี: {0}'}" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,0,14,0" />
                    <TextBlock Text="{Binding Proxies.Count, StringFormat='Proxy: {0}'}" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,0,14,0" />
                    <TextBlock Text="{Binding Rules.Count, StringFormat='กฎ: {0}'}" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,0,14,0" />
                    
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
    </Border>
</Window>
