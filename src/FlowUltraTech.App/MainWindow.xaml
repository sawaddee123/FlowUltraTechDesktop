<Window x:Class="FlowUltraTech.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:models="clr-namespace:FlowUltraTech.Core.Models;assembly=FlowUltraTech.Core"
        mc:Ignorable="d"
        Title="{Binding WindowTitle, FallbackValue='FlowUltraTech'}" 
        Icon="Assets/app.ico"
        Height="820" Width="1260"
        MinHeight="680" MinWidth="1000"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        Topmost="False"
        ShowInTaskbar="True"
        Background="{DynamicResource BgBrush}"
        Foreground="{DynamicResource FgBrush}"
        FontFamily="{StaticResource AppFont}"
        TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <Style x:Key="PageTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="26" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource FgBrush}" />
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource FgBrush}" />
            <Setter Property="Margin" Value="0,0,0,14" />
        </Style>
        <Style x:Key="HintText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="SectionCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="20,18" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>
        <!-- ป้ายสถานะบัญชี: สีตาม CardStatusTone -->
        <Style x:Key="StatusBadge" TargetType="Border">
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="9,3" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Background" Value="{DynamicResource Surface3Brush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding CardStatusTone}" Value="ok"><Setter Property="Background" Value="{DynamicResource OkSoftBrush}" /></DataTrigger>
                <DataTrigger Binding="{Binding CardStatusTone}" Value="warn"><Setter Property="Background" Value="{DynamicResource WarnSoftBrush}" /></DataTrigger>
                <DataTrigger Binding="{Binding CardStatusTone}" Value="bad"><Setter Property="Background" Value="{DynamicResource BadSoftBrush}" /></DataTrigger>
                <DataTrigger Binding="{Binding CardStatusTone}" Value="info"><Setter Property="Background" Value="{DynamicResource PrimarySoftBrush}" /></DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="StatusBadgeText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding CardStatusTone}" Value="ok"><Setter Property="Foreground" Value="{DynamicResource OkBrush}" /></DataTrigger>
                <DataTrigger Binding="{Binding CardStatusTone}" Value="warn"><Setter Property="Foreground" Value="{DynamicResource WarnBrush}" /></DataTrigger>
                <DataTrigger Binding="{Binding CardStatusTone}" Value="bad"><Setter Property="Foreground" Value="{DynamicResource BadBrush}" /></DataTrigger>
                <DataTrigger Binding="{Binding CardStatusTone}" Value="info"><Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}" /></DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0"
                      ResizeBorderThickness="6"
                      CornerRadius="0"
                      GlassFrameThickness="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    
    
    <Border x:Name="RootBorder" Background="{DynamicResource BgBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1">
        <Grid Background="{DynamicResource BgBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 1. CUSTOM WINDOW HEADER & TITLE BAR (DRAGGABLE) -->
            <Border Grid.Row="0" Background="{DynamicResource SurfaceBrush}" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource LineBrush}" 
                    MouseLeftButtonDown="Header_MouseLeftButtonDown"
                    MouseMove="Header_MouseMove"
                    MouseLeftButtonUp="Header_MouseLeftButtonUp"
                    MouseLeave="Header_MouseLeave">
                <DockPanel LastChildFill="True">
                    
                    <!-- Right: Theme toggle + Window Controls -->
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Stretch">
                        <Button x:Name="ThemeToggleButton" Style="{StaticResource WindowControlButton}" Click="ThemeToggle_Click" ToolTip="สลับธีม มืด / สว่าง" AutomationProperties.Name="สลับธีม">
                            <ui:SymbolIcon x:Name="ThemeToggleIcon" Symbol="WeatherSunny16" FontSize="14" />
                        </Button>
                        <Rectangle Width="1" Height="18" Fill="{DynamicResource LineBrush}" VerticalAlignment="Center" Margin="2,0,2,0" />

                        <!-- Window Control Buttons -->
                        <Button Style="{StaticResource WindowControlButton}" Click="MinimizeWindow_Click" ToolTip="ย่อหน้าต่าง (Minimize)">
                            <ui:SymbolIcon Symbol="Subtract16" FontSize="12" />
                        </Button>
                        <Button x:Name="MaximizeButton" Style="{StaticResource WindowControlButton}" Click="MaximizeWindow_Click" ToolTip="ขยายเต็มจอ (Maximize)">
                            <ui:SymbolIcon x:Name="MaximizeIcon" Symbol="Maximize16" FontSize="12" />
                        </Button>
                        <Button Style="{StaticResource WindowCloseButton}" Click="CloseWindow_Click" ToolTip="ปิดโปรแกรม (Close)">
                            <ui:SymbolIcon Symbol="Dismiss16" FontSize="12" />
                        </Button>
                    </StackPanel>

                    <!-- Left: App Branding & Live Status -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,6,0,6">
                        <Image Source="{DynamicResource WordmarkImage}" Height="20" Margin="0,0,10,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" />
                        <Border Background="{DynamicResource Surface2Brush}" CornerRadius="6" Padding="6,1" Margin="0,0,12,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding AppVersionText, FallbackValue='v1.7.5'}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource MutedBrush}" />
                        </Border>

                        <TextBlock Text="{Binding StatusNotification}" FontSize="12" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="560" ToolTip="{Binding StatusNotification}" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="{DynamicResource SurfaceBrush}">
                    <DockPanel>
                        <Border DockPanel.Dock="Bottom" Background="{DynamicResource Surface2Brush}" CornerRadius="12" Padding="12,10" Margin="10,10,10,12">
                            <StackPanel>
                                <TextBlock Text="{Binding LoggedInUsername, FallbackValue='ผู้ใช้งาน'}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock FontSize="12" Foreground="{DynamicResource MutedBrush}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"><Run Text="แพ็กเกจ " /><Run Text="{Binding LicensePlan, Mode=OneWay}" /></TextBlock>
                                <TextBlock Text="{Binding PlanUsageText}" FontSize="12" Foreground="{DynamicResource SubtleBrush}" Margin="0,2,0,0" />
                            </StackPanel>
                        </Border>
                        <StackPanel Margin="10,14,10,0">
                            <Button Command="{Binding NavigateInstancesCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="0" Margin="0,2" Background="Transparent" BorderThickness="0" Cursor="Hand" AutomationProperties.Name="บัญชี">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="NavPill" CornerRadius="8" Padding="12,10" Background="Transparent">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <ui:SymbolIcon x:Name="NavIcon" Symbol="People24" FontSize="17" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,12,0" />
                                                <TextBlock x:Name="NavText" Grid.Column="1" Text="บัญชี" FontSize="14" FontWeight="Medium" Foreground="{DynamicResource FgBrush}" VerticalAlignment="Center" />
                                                <Border Grid.Column="2" Background="{DynamicResource WarnBrush}" CornerRadius="9" Padding="7,1" VerticalAlignment="Center" Visibility="{Binding HasNeedsHelp, Converter={StaticResource BoolToVis}}" ToolTip="บัญชีที่รอคุณช่วยแก้ Captcha">
                                                    <TextBlock Text="{Binding NeedsHelpCount}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource OnPrimaryBrush}" />
                                                </Border>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="NavPill" Property="Background" Value="{DynamicResource Surface2Brush}" />
                                            </Trigger>
                                            <DataTrigger Binding="{Binding IsNavInstances}" Value="True">
                                                <Setter TargetName="NavPill" Property="Background" Value="{DynamicResource Surface3Brush}" />
                                                <Setter TargetName="NavText" Property="FontWeight" Value="SemiBold" />
                                                <Setter TargetName="NavIcon" Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
                                            </DataTrigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                            <Button Command="{Binding NavigateSettingsCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="0" Margin="0,2" Background="Transparent" BorderThickness="0" Cursor="Hand" AutomationProperties.Name="ตั้งค่า">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="NavPill" CornerRadius="8" Padding="12,10" Background="Transparent">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <ui:SymbolIcon x:Name="NavIcon" Symbol="Settings24" FontSize="17" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,12,0" />
                                                <TextBlock x:Name="NavText" Grid.Column="1" Text="ตั้งค่า" FontSize="14" FontWeight="Medium" Foreground="{DynamicResource FgBrush}" VerticalAlignment="Center" />
                    
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="NavPill" Property="Background" Value="{DynamicResource Surface2Brush}" />
                                            </Trigger>
                                            <DataTrigger Binding="{Binding IsNavSettings}" Value="True">
                                                <Setter TargetName="NavPill" Property="Background" Value="{DynamicResource Surface3Brush}" />
                                                <Setter TargetName="NavText" Property="FontWeight" Value="SemiBold" />
                                                <Setter TargetName="NavIcon" Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
                                            </DataTrigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </StackPanel>
                    </DockPanel>
                </Border>
                <Border Grid.Column="1" Background="{DynamicResource BgBrush}" Padding="32,24,28,16">
                    <Grid>
                        <!-- หน้ารวมบัญชี -->
                        <Grid Visibility="{Binding ShowHome, Converter={StaticResource BoolToVis}}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <DockPanel Margin="0,0,0,20">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Visibility="{Binding HasInstances, Converter={StaticResource BoolToVis}}">
                                    <Button Style="{StaticResource ActionDarkButton}" Command="{Binding StopAllCommand}" Padding="14,8" Margin="0,0,8,0">
                                        <StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="Stop16" Foreground="{DynamicResource BadBrush}" Margin="0,0,6,0" /><TextBlock Text="หยุดทั้งหมด" VerticalAlignment="Center" /></StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource ActionDarkButton}" Command="{Binding StartAllCommand}" Padding="14,8" Margin="0,0,8,0">
                                        <StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="Play16" Foreground="{DynamicResource OkBrush}" Margin="0,0,6,0" /><TextBlock Text="เริ่มทั้งหมด" VerticalAlignment="Center" /></StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource PrimaryCtaButton}" Command="{Binding AddAccountAndLoginCommand}" Padding="16,8">
                                        <StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="Add16" Foreground="{DynamicResource OnPrimaryBrush}" Margin="0,0,6,0" /><TextBlock Text="เพิ่มบัญชี" VerticalAlignment="Center" /></StackPanel>
                                    </Button>
                                </StackPanel>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="บัญชี" Style="{StaticResource PageTitle}" />
                                    <TextBlock Text="{Binding RunningStatusSummary}" Style="{StaticResource HintText}" Margin="0,2,0,0" Visibility="{Binding HasInstances, Converter={StaticResource BoolToVis}}" />
                                </StackPanel>
                            </DockPanel>

                            <!-- สรุปรวมทุกบัญชี -->
                            <UniformGrid Grid.Row="1" Columns="3" Margin="0,0,-10,18" MaxWidth="1000" HorizontalAlignment="Left" Visibility="{Binding HasInstances, Converter={StaticResource BoolToVis}}">
                                <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="12" Padding="16,12" Margin="0,0,10,0">
                                    <StackPanel>
                                        <TextBlock Text="ผู้ชมตอนนี้" FontSize="12" Foreground="{DynamicResource MutedBrush}" />
                                        <TextBlock Text="{Binding TotalViewers, StringFormat={}{0:N0}}" FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource FgBrush}" Margin="0,2,0,0" />
                                    </StackPanel>
                                </Border>
                                <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="12" Padding="16,12" Margin="0,0,10,0">
                                    <StackPanel>
                                        <TextBlock Text="เพชรตั้งแต่เปิดโปรแกรม" FontSize="12" Foreground="{DynamicResource MutedBrush}" />
                                        <TextBlock Text="{Binding TotalDiamonds, StringFormat={}{0:N0}}" FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource FgBrush}" Margin="0,2,0,0" />
                                    </StackPanel>
                                </Border>
                                <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="12" Padding="16,12" Margin="0,0,10,0">
                                    <StackPanel>
                                        <TextBlock Text="Captcha ที่ AI แก้ให้" FontSize="12" Foreground="{DynamicResource MutedBrush}" />
                                        <TextBlock Text="{Binding TotalCaptchaSolved, StringFormat={}{0:N0}}" FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource FgBrush}" Margin="0,2,0,0" />
                                    </StackPanel>
                                </Border>
                            </UniformGrid>

                            <!-- ยังไม่มีบัญชี -->
                            <Border Grid.Row="1" Grid.RowSpan="2" Visibility="{Binding HasNoInstances, Converter={StaticResource BoolToVis}}" Background="{DynamicResource SurfaceBrush}" CornerRadius="16" Padding="40,36" MaxWidth="540" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <StackPanel HorizontalAlignment="Center">
                                    <Border Width="64" Height="64" CornerRadius="32" Background="{DynamicResource PrimarySoftBrush}" HorizontalAlignment="Center">
                                        <ui:SymbolIcon Symbol="PersonAdd24" FontSize="28" Foreground="{DynamicResource PrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Text="เริ่มจากเพิ่มบัญชี TikTok" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,18,0,0" />
                                    <TextBlock Text="ล็อกอินครั้งเดียว ที่เหลือโปรแกรมดูแลให้ ทั้งแก้ Captcha ซ่อนหน้าต่าง Studio และอ่านแชทสด" Style="{StaticResource HintText}" FontSize="14" TextAlignment="Center" Margin="0,8,0,0" />
                                    <Button Style="{StaticResource PrimaryCtaButton}" Command="{Binding AddAccountAndLoginCommand}" Padding="24,12" FontSize="15" HorizontalAlignment="Center" Margin="0,24,0,0">
                                        <StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="Add16" Foreground="{DynamicResource OnPrimaryBrush}" Margin="0,0,8,0" /><TextBlock Text="เพิ่มบัญชีแรก" VerticalAlignment="Center" /></StackPanel>
                                    </Button>
                                </StackPanel>
                            </Border>

                            <!-- การ์ดบัญชี -->
                            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Visibility="{Binding HasInstances, Converter={StaticResource BoolToVis}}">
                                <ItemsControl ItemsSource="{Binding Instances}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Width="320" Margin="0,0,14,14" Padding="18,16" CornerRadius="14" Background="{DynamicResource SurfaceBrush}" Cursor="Hand" ToolTip="เปิดดูบัญชีนี้">
                                                <Border.InputBindings>
                                                    <MouseBinding Gesture="LeftClick" Command="{Binding DataContext.OpenInstanceCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                                                </Border.InputBindings>
                                                <StackPanel>
                                                    <DockPanel>
                                                        <ui:SymbolIcon DockPanel.Dock="Right" Symbol="ChevronRight20" Foreground="{DynamicResource SubtleBrush}" VerticalAlignment="Center" />
                                                        <Grid DockPanel.Dock="Left" Margin="0,0,12,0" Width="44" Height="44" VerticalAlignment="Center">
                                                            <Border CornerRadius="22" Visibility="{Binding AvatarVisibility}" RenderOptions.BitmapScalingMode="HighQuality">
                                                                <Border.Background>
                                                                    <ImageBrush ImageSource="{Binding AvatarImageSource}" Stretch="UniformToFill" />
                                                                </Border.Background>
                                                            </Border>
                                                            <Border CornerRadius="22" Background="{DynamicResource Surface3Brush}" Visibility="{Binding FallbackAvatarVisibility}">
                                                                <ui:SymbolIcon Symbol="Person20" FontSize="19.8" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}" />
                                                            </Border>
                                                        </Grid>
                                                        <StackPanel VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding PrimaryDisplayName}" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Text="{Binding StreamerHandle}" FontSize="12.5" Foreground="{DynamicResource MutedBrush}" TextTrimming="CharacterEllipsis" />
                                                        </StackPanel>
                                                    </DockPanel>
                                                    <Border Style="{StaticResource StatusBadge}" Margin="0,14,0,0">
                                                        <TextBlock Text="{Binding CardStatusText}" Style="{StaticResource StatusBadgeText}" />
                                                    </Border>

                                                    <Border Visibility="{Binding NeedsHelp, Converter={StaticResource BoolToVis}}" Background="{DynamicResource WarnSoftBrush}" CornerRadius="10" Padding="12,8" Margin="0,12,0,0">
                                                        <DockPanel>
                                                            <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryCtaButton}" Content="แก้ตอนนี้" Padding="12,5" Command="{Binding DataContext.OpenInstanceCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                                                            <TextBlock Text="พบ Captcha ต้องให้คุณช่วย" Foreground="{DynamicResource WarnBrush}" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap" />
                                                        </DockPanel>
                                                    </Border>
                                                    <Border Visibility="{Binding ErrorVisibility}" Background="{DynamicResource BadSoftBrush}" CornerRadius="10" Padding="12,8" Margin="0,12,0,0">
                                                        <DockPanel>
                                                            <Button DockPanel.Dock="Right" Style="{StaticResource ActionDarkButton}" Content="ลองใหม่" Padding="12,5" Command="{Binding StartCommand}" IsEnabled="{Binding CanStart}" />
                                                            <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource BadBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding StatusMessage}" />
                                                        </DockPanel>
                                                    </Border>
                                                    <TextBlock Visibility="{Binding RunningVisibility}" FontSize="12.5" Foreground="{DynamicResource MutedBrush}" Margin="0,12,0,0">
                                                        <Run Text="แชท " /><Run Text="{Binding TotalChatCount, Mode=OneWay, StringFormat={}{0:N0}}" Foreground="{DynamicResource FgBrush}" /><Run Text="   ·   เพชร " /><Run Text="{Binding TotalDiamondsCount, Mode=OneWay, StringFormat={}{0:N0}}" Foreground="{DynamicResource FgBrush}" />
                                                    </TextBlock>

                                                    <DockPanel Margin="0,16,0,0">
                                                        <Button DockPanel.Dock="Right" Style="{StaticResource ActionDarkButton}" Command="{Binding ToggleVisibilityCommand}" Visibility="{Binding RunningVisibility}" ToolTip="{Binding ToggleWindowText}" Padding="10,7">
                                                            <ui:SymbolIcon Symbol="Window16" Foreground="{DynamicResource MutedBrush}" />
                                                        </Button>
                                                        <StackPanel Orientation="Horizontal">
                                                            <Button Style="{StaticResource PrimaryCtaButton}" Command="{Binding OpenStudioForLoginCommand}" Visibility="{Binding LoginButtonVisibility}" Padding="16,7" FontSize="13" Margin="0,0,8,0" ToolTip="เปิด TikTok LIVE Studio ให้ล็อกอิน ระบบจะรู้เองเมื่อล็อกอินเสร็จ">
                                                                <StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="PersonKey20" Foreground="{DynamicResource OnPrimaryBrush}" Margin="0,0,6,0" /><TextBlock Text="ล็อกอิน TikTok" VerticalAlignment="Center" /></StackPanel>
                                                            </Button>
                                                            <Button Style="{StaticResource PrimaryCtaButton}" Command="{Binding StartCommand}" Visibility="{Binding StartButtonVisibility}" IsEnabled="{Binding CanStart}" ToolTip="{Binding StartButtonToolTip}" ToolTipService.ShowOnDisabled="True" Padding="16,7" FontSize="13" Margin="0,0,8,0">
                                                                <StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="Play16" Foreground="{DynamicResource OnPrimaryBrush}" Margin="0,0,6,0" /><TextBlock Text="เริ่ม" VerticalAlignment="Center" /></StackPanel>
                                                            </Button>
                                                            <Button Style="{StaticResource StopDangerButton}" Command="{Binding StopCommand}" Visibility="{Binding StopButtonVisibility}" ToolTip="{Binding StopButtonToolTip}" Padding="16,7" FontSize="13" Margin="0,0,8,0">
                                                                <StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="Stop16" Foreground="{DynamicResource BadBrush}" Margin="0,0,6,0" /><TextBlock Text="หยุด" Foreground="{DynamicResource BadBrush}" VerticalAlignment="Center" /></StackPanel>
                                                            </Button>
                                                        </StackPanel>
                                                    </DockPanel>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                        <!-- หน้าบัญชี -->
                        <ContentControl Content="{Binding SelectedInstance}" Visibility="{Binding ShowDetail, Converter={StaticResource BoolToVis}}" Focusable="False">
                            <ContentControl.ContentTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <StackPanel Grid.Row="0">
                                            <Button Style="{StaticResource GhostButton}" HorizontalAlignment="Left" Padding="6,4" Margin="-6,0,0,10" Command="{Binding DataContext.GoBackCommand, RelativeSource={RelativeSource AncestorType=Window}}">
                                                <StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="ArrowLeft16" Margin="0,0,6,0" /><TextBlock Text="บัญชีทั้งหมด" VerticalAlignment="Center" /></StackPanel>
                                            </Button>
                                            <DockPanel>
                                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Button Style="{StaticResource ActionDarkButton}" Command="{Binding ToggleVisibilityCommand}" Visibility="{Binding RunningVisibility}" Padding="14,8" Margin="0,0,8,0">
                                                        <StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="Window16" Margin="0,0,6,0" /><TextBlock Text="{Binding ToggleWindowText}" VerticalAlignment="Center" /></StackPanel>
                                                    </Button>
                                                    <Button Style="{StaticResource PrimaryCtaButton}" Command="{Binding OpenStudioForLoginCommand}" Visibility="{Binding LoginButtonVisibility}" Padding="16,8" FontSize="13" Margin="0,0,8,0" ToolTip="เปิด TikTok LIVE Studio ให้ล็อกอิน ระบบจะรู้เองเมื่อล็อกอินเสร็จ">
                                                        <StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="PersonKey20" Foreground="{DynamicResource OnPrimaryBrush}" Margin="0,0,6,0" /><TextBlock Text="ล็อกอิน TikTok" VerticalAlignment="Center" /></StackPanel>
                                                    </Button>
                                                    <Button Style="{StaticResource PrimaryCtaButton}" Command="{Binding StartCommand}" Visibility="{Binding StartButtonVisibility}" IsEnabled="{Binding CanStart}" ToolTip="{Binding StartButtonToolTip}" ToolTipService.ShowOnDisabled="True" Padding="16,8" FontSize="13" Margin="0,0,8,0">
                                                        <StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="Play16" Foreground="{DynamicResource OnPrimaryBrush}" Margin="0,0,6,0" /><TextBlock Text="เริ่ม" VerticalAlignment="Center" /></StackPanel>
                                                    </Button>
                                                    <Button Style="{StaticResource StopDangerButton}" Command="{Binding StopCommand}" Visibility="{Binding StopButtonVisibility}" ToolTip="{Binding StopButtonToolTip}" Padding="16,8" FontSize="13" Margin="0,0,8,0">
