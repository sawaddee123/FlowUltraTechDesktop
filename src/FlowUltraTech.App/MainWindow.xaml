                                                                                    <CheckBox Content="เงาของนาฬิกา" IsChecked="{Binding OverlayEnableShadow, Mode=TwoWay}" Foreground="{DynamicResource FgBrush}" FontSize="11" Margin="0,0,14,6" />
                                                                                    <CheckBox Content="ภาพสั่นเล็กน้อยให้เหมือนกล้องจริง" IsChecked="{Binding OverlayEnableJitter, Mode=TwoWay}" Foreground="{DynamicResource FgBrush}" FontSize="11" Margin="0,0,14,6" />
                                                                                    <CheckBox Content="ป้ายจำนวนผู้ชม" IsChecked="{Binding OverlayEnableLiveTicker, Mode=TwoWay}" Foreground="{DynamicResource FgBrush}" FontSize="11" Margin="0,0,0,6" />
                                                                                </WrapPanel>
                                                                            </StackPanel>
                                                                        </Border>

                                                                        <!-- COLUMN 4: Fixed Endpoint, One-Click Auto-Inject & Flash Deal Countdown -->
                                                                        <StackPanel Grid.Column="4">
                                                                            <!-- Top Card: Endpoint & One-Click Auto-Inject -->
                                                                            <Border Background="{DynamicResource Surface2Brush}" CornerRadius="8" Padding="14,10" Margin="0,0,0,10">
                                                                                <StackPanel>
                                                                                    <DockPanel LastChildFill="False" Margin="0,0,0,6">
                                                                                        <TextBlock DockPanel.Dock="Left" Text="ลิงก์สำหรับใส่ในโปรแกรมไลฟ์" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource FgBrush}" VerticalAlignment="Center" />
                                                                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                                                                            <Ellipse Width="6" Height="6" Fill="{DynamicResource OkBrush}" Margin="0,0,5,0" VerticalAlignment="Center" />
                                                                                            <TextBlock Text="{Binding OverlayStatusText}" FontSize="10.5" Foreground="{DynamicResource OkBrush}" MaxWidth="175" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
