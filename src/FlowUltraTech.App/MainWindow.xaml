                    </Grid>

                    <!-- VIEW 1: CAPTCHA RADAR (Dual-Pane Master-Detail Hub) -->
                    <Grid Visibility="{Binding IsNavCaptcha, Converter={StaticResource BoolToVis}}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!-- VIEW HEADER: Title (Left) + Action buttons (Right) -->
                            <Grid Grid.Row="0" Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="Captcha" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource FgBrush}" VerticalAlignment="Center" />
                                    <Border Background="{DynamicResource BadSoftBrush}" BorderBrush="{DynamicResource BadBrush}" BorderThickness="1" CornerRadius="10" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center" Visibility="{Binding HasAnyCaptchaAlert, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="{Binding TotalCaptchaAlertCount, StringFormat='พบ {0} บัญชี'}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource BadBrush}" />
                                    </Border>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Button Style="{StaticResource ActionDarkButton}" Command="{Binding OpenCaptchaFolderCommand}" Margin="0,0,8,0" Padding="12,6">
