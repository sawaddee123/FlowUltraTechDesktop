                                                                                IsEnabled="{Binding CanInjectOverlay}" MinWidth="156" Margin="0,0,8,0" Padding="12,6">
                                                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                                <Path Width="13" Height="13" Stretch="Uniform" Stroke="{DynamicResource LineBrush}" StrokeThickness="1.8"
                                                                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" Margin="0,0,6,0" VerticalAlignment="Center"
                                                                                      Data="M 2,8 L 13,2 L 9,14 L 7,9 Z" />
                                                                                <TextBlock Text="{Binding InjectOverlayButtonText}" FontSize="11.5" VerticalAlignment="Center" />
                                                                            </StackPanel>
                                                                        </Button>

                                                                    </WrapPanel>
                                                                </StackPanel>
                                                            </Border>

                                                            <!-- Bottom Card: Flash Deal Countdown -->
                                                            <Border Background="{DynamicResource Surface2Brush}" CornerRadius="8" Padding="14,10">
                                                                <StackPanel>
                                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,6">
                                                                        <Path Width="13" Height="13" Stretch="Uniform" Stroke="{DynamicResource WarnBrush}" StrokeThickness="1.8"
                                                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" Margin="0,0,6,0" VerticalAlignment="Center"
                                                                              Data="M 9,1 L 3,9 L 8,9 L 7,15 L 13,7 L 8,7 Z" />
                                                                        <TextBlock Text="นาทีทอง (Flash Deal)" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource FgBrush}" VerticalAlignment="Center" />
                                                                    </StackPanel>

                                                                    <Grid>
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="*" />
                                                                            <ColumnDefinition Width="6" />
                                                                            <ColumnDefinition Width="64" />
                                                                            <ColumnDefinition Width="6" />
                                                                            <ColumnDefinition Width="Auto" />
                                                                            <ColumnDefinition Width="6" />
                                                                            <ColumnDefinition Width="Auto" />
                                                                        </Grid.ColumnDefinitions>
                                                                        <TextBox Grid.Column="0" Text="{Binding OverlayFlashDealTitle, UpdateSourceTrigger=PropertyChanged}"
                                                                                 ToolTip="หัวข้อโปรโมชันนาทีทอง" Background="{DynamicResource Surface2Brush}" Foreground="{DynamicResource FgBrush}" BorderBrush="{DynamicResource LineBrush}" Padding="7,4" FontSize="11" VerticalContentAlignment="Center" />
                                                                        <TextBox Grid.Column="2" Text="{Binding OverlayFlashDealDurationSeconds, UpdateSourceTrigger=PropertyChanged}"
                                                                                 ToolTip="เวลานับถอยหลัง (วินาที)" FontFamily="{StaticResource MonoFont}" Background="{DynamicResource Surface2Brush}" Foreground="{DynamicResource WarnBrush}" BorderBrush="{DynamicResource LineBrush}" Padding="6,4" FontSize="11" VerticalContentAlignment="Center" />
                                                                        <Button Grid.Column="4" Style="{StaticResource ActionDarkButton}" Content="เริ่มนาทีทอง"
                                                                                Command="{Binding TriggerFlashDealCommand}" Padding="10,4" FontSize="11" />
                                                                        <Button Grid.Column="6" Style="{StaticResource StopDangerButton}" Content="หยุด"
                                                                                Command="{Binding StopFlashDealCommand}" Padding="10,4" FontSize="11" />
                                                                    </Grid>
                                                                </StackPanel>
                                                            </Border>
                                                        </StackPanel>
                                                    </Grid>
                                                </ScrollViewer>
                                            </TabItem>
                                            <TabItem IsEnabled="False" ToolTip="บอทตอบแชทจะเปิดให้ใช้เร็วๆ นี้" ToolTipService.ShowOnDisabled="True">
                                                <TabItem.Header>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="บอทตอบแชท" VerticalAlignment="Center" Margin="0,0,8,0" />
                                                        <Border Background="{DynamicResource Surface3Brush}" CornerRadius="8" Padding="7,1"><TextBlock Text="เร็วๆ นี้" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource MutedBrush}" /></Border>
                                                    </StackPanel>
                                                </TabItem.Header>
                                            </TabItem>
                                        </TabControl>
                                    </Grid>
                                </DataTemplate>
                            </ContentControl.ContentTemplate>
                        </ContentControl>
                        <!-- หน้าขั้นสูงของบัญชี -->
                        <ContentControl Content="{Binding SelectedInstance}" Visibility="{Binding ShowAdvanced, Converter={StaticResource BoolToVis}}" Focusable="False">
                            <ContentControl.ContentTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <StackPanel Grid.Row="0" Margin="0,0,0,8">
                                            <Button Style="{StaticResource GhostButton}" HorizontalAlignment="Left" Padding="6,4" Margin="-6,0,0,10" Command="{Binding DataContext.GoBackCommand, RelativeSource={RelativeSource AncestorType=Window}}">
                                                <StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="ArrowLeft16" Margin="0,0,6,0" /><TextBlock Text="{Binding PrimaryDisplayName}" VerticalAlignment="Center" /></StackPanel>
                                            </Button>
                                            <DockPanel>
                                                <Button DockPanel.Dock="Right" Style="{StaticResource StopDangerButton}" Command="{Binding DataContext.RemoveInstanceCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Padding="14,8" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="Delete16" Foreground="{DynamicResource BadBrush}" Margin="0,0,6,0" /><TextBlock Text="ลบบัญชีนี้" Foreground="{DynamicResource BadBrush}" VerticalAlignment="Center" /></StackPanel>
                                                </Button>
                                                <StackPanel>
                                                    <TextBlock Text="ขั้นสูง" Style="{StaticResource PageTitle}" />
                                                    <TextBlock Text="ส่วนใหญ่ระบบจัดให้อัตโนมัติ เปิดดูเมื่อต้องแก้ปัญหา" Style="{StaticResource HintText}" Margin="0,2,0,0" />
                                                </StackPanel>
                                            </DockPanel>
                                        </StackPanel>
                                        <TabControl Grid.Row="1" SelectedIndex="{Binding SelectedAdvancedTabIndex}">
                                            <TabItem Header="บัญชีและ Proxy">
                                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                                    <Grid Margin="0,10,0,0">
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                        </Grid.RowDefinitions>

                                                        <!-- Session Toolbar: Actions & Identity Status (No duplicate avatar/name) -->
                                                        <Border Grid.Row="0" Background="{DynamicResource Surface2Brush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,0,10">
                                                            <DockPanel LastChildFill="True">
                                                                <!-- Right Action Buttons -->
                                                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                                                    <Button Style="{StaticResource ActionDarkButton}" Content="ใช้ล็อกอินจากสตูดิโอหลัก" Command="{Binding CloneSessionFromDefaultCommand}" Margin="0,0,6,0" Padding="10,5" />
                                                                    <Button Style="{StaticResource ActionDarkButton}" Content="เปิดสตูดิโอ" Command="{Binding OpenStudioForLoginCommand}" Visibility="{Binding LoggedInVisibility}" Margin="0,0,6,0" Padding="10,5" />
                                                                    <Button Style="{StaticResource PrimaryCtaButton}" Content="เปิดสตูดิโอเพื่อล็อกอิน" Command="{Binding OpenStudioForLoginCommand}" Visibility="{Binding NotLoggedInVisibility}" Margin="0,0,6,0" Padding="12,5" />
                                                                    <Button Style="{StaticResource ActionDarkButton}" Content="รีเฟรชสถานะ" Command="{Binding RefreshProfileCommand}" Padding="10,5" />
                                                                </StackPanel>

                                                                <!-- Left Session Status & UID Chip -->
                                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                    <Grid Margin="0,0,12,0" VerticalAlignment="Center">
                                                                        <Border Width="44" Height="44" CornerRadius="22" Visibility="{Binding AvatarVisibility}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1.5" RenderOptions.BitmapScalingMode="HighQuality">
                                                                            <Border.Background>
                                                                                <ImageBrush ImageSource="{Binding AvatarImageSource}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" />
                                                                            </Border.Background>
                                                                        </Border>
                                                                        <Border Width="44" Height="44" CornerRadius="22" Background="{DynamicResource Surface3Brush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1.5" Visibility="{Binding FallbackAvatarVisibility}">
                                                                            <ui:SymbolIcon Symbol="Person20" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}" />
                                                                        </Border>
                                                                    </Grid>

                                                                    <StackPanel VerticalAlignment="Center" Visibility="{Binding LoggedInVisibility}">
                                                                        <StackPanel Orientation="Horizontal">
                                                                            <TextBlock Text="{Binding LoggedInNickname}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource FgBrush}" VerticalAlignment="Center" />
                                                                            <TextBlock Text="{Binding StreamerHandle}" FontSize="12" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="8,0,0,0" />
                                                                            <Border Background="{DynamicResource OkSoftBrush}" CornerRadius="4" Padding="6,1" VerticalAlignment="Center" Margin="10,0,0,0">
                                                                                <TextBlock Text="ล็อกอินแล้ว" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource OkBrush}" />
                                                                            </Border>
                                                                        </StackPanel>
                                                                        <TextBlock Text="{Binding LoggedInUserId, StringFormat='UID {0}'}" FontSize="11" FontFamily="{StaticResource MonoFont}" Foreground="{DynamicResource SubtleBrush}" Margin="0,2,0,0" />
                                                                    </StackPanel>

                                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Visibility="{Binding NotLoggedInVisibility}">
                                                                        <TextBlock Text="ยังไม่ได้ล็อกอิน" FontSize="12" Foreground="{DynamicResource SubtleBrush}" VerticalAlignment="Center" />
                                                                    </StackPanel>
                                                                </StackPanel>
                                                            </DockPanel>
                                                        </Border>

                                                        <!-- Per-Instance Native Proxy Section (No Proxifier Required) -->
                                                        <Border Grid.Row="1" Background="{DynamicResource Surface2Brush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,10,0,0">
                                                            <StackPanel>
                                                                <DockPanel LastChildFill="False" Margin="0,0,0,8">
                                                                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                                                                        <ui:SymbolIcon Symbol="Globe20" Foreground="{DynamicResource PrimaryBrush}" Margin="0,0,7,0" VerticalAlignment="Center" />
                                                                        <TextBlock Text="Proxy ของบัญชีนี้" FontWeight="SemiBold" FontSize="11.5" Foreground="{DynamicResource FgBrush}" VerticalAlignment="Center" Margin="0,0,12,0" />
                                                                        <CheckBox Content="ใช้ Proxy" IsChecked="{Binding InstanceUseCustomProxy, Mode=TwoWay}" FontSize="11" Foreground="{DynamicResource FgBrush}" VerticalAlignment="Center" />
                                                                    </StackPanel>

                                                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                                                        <Button Style="{StaticResource ActionDarkButton}" Content="{Binding TestInstanceProxyButtonText}" Command="{Binding TestInstanceProxyCommand}" Padding="10,4" Margin="0,0,6,0" FontSize="11" />
                                                                        <Button Style="{StaticResource PrimaryCtaButton}" Content="บันทึก Proxy" Command="{Binding SaveInstanceProxyConfigCommand}" Padding="12,4" FontSize="11" />
                                                                    </StackPanel>
                                                                </DockPanel>

                                                                <Grid Margin="0,0,0,6">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="105" />
                                                                        <ColumnDefinition Width="8" />
                                                                        <ColumnDefinition Width="1.4*" />
                                                                        <ColumnDefinition Width="8" />
                                                                        <ColumnDefinition Width="85" />
                                                                        <ColumnDefinition Width="8" />
                                                                        <ColumnDefinition Width="1*" />
                                                                        <ColumnDefinition Width="8" />
                                                                        <ColumnDefinition Width="1*" />
                                                                    </Grid.ColumnDefinitions>

                                                                    <StackPanel Grid.Column="0">
                                                                        <TextBlock Text="ประเภท" FontSize="10.5" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,3" />
                                                                        <ComboBox ItemsSource="{Binding ProxyProtocolOptions}" SelectedIndex="{Binding InstanceProxyProtocolIndex, Mode=TwoWay}" Background="{DynamicResource Surface2Brush}" Foreground="{DynamicResource FgBrush}" BorderBrush="{DynamicResource LineBrush}" Padding="8,4" FontSize="11" />
                                                                    </StackPanel>

                                                                    <StackPanel Grid.Column="2">
                                                                        <TextBlock Text="ที่อยู่ (IP)" FontSize="10.5" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,3" />
                                                                        <ui:TextBox Text="{Binding InstanceProxyHost, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="เช่น 45.142.xx.xx" Padding="8,4" FontSize="11" />
                                                                    </StackPanel>

                                                                    <StackPanel Grid.Column="4">
                                                                        <TextBlock Text="พอร์ต" FontSize="10.5" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,3" />
                                                                        <ui:TextBox Text="{Binding InstanceProxyPort, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="8080" Padding="8,4" FontSize="11" />
                                                                    </StackPanel>

                                                                    <StackPanel Grid.Column="6">
                                                                        <TextBlock Text="ชื่อผู้ใช้ (ถ้ามี)" FontSize="10.5" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,3" />
                                                                        <ui:TextBox Text="{Binding InstanceProxyUsername, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="เว้นว่างได้" Padding="8,4" FontSize="11" />
                                                                    </StackPanel>

                                                                    <StackPanel Grid.Column="8">
                                                                        <TextBlock Text="รหัสผ่าน (ถ้ามี)" FontSize="10.5" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,3" />
                                                                        <ui:TextBox Text="{Binding InstanceProxyPassword, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="เว้นว่างได้" Padding="8,4" FontSize="11" />
                                                                    </StackPanel>
                                                                </Grid>

                                                                <TextBlock Text="{Binding InstanceProxyStatusText}" FontSize="11" Foreground="{DynamicResource PrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                                            </StackPanel>
                                                        </Border>
                                                    </Grid>
                                                </ScrollViewer>
                                            </TabItem>
                                            <TabItem Header="Captcha">
                                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                                    <Grid Margin="0,10,0,0">
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                        </Grid.RowDefinitions>

                                                        <Border Grid.Row="0" Visibility="{Binding NotRunningVisibility}" Background="{DynamicResource Surface3Brush}" CornerRadius="6" Padding="12,8" Margin="0,0,0,8">
                                                            <TextBlock Text="หน้าต่างนี้ยังไม่ได้เปิดทำงาน (กดเริ่มทำงานก่อนสแกนหา Captcha)" Foreground="{DynamicResource WarnBrush}" FontSize="12" />
                                                        </Border>

                                                        <Border Grid.Row="1" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,8">
                                                            <DockPanel LastChildFill="True">
                                                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                                                                    <Button Style="{StaticResource PrimaryCtaButton}" Content="ตรวจหาเดี๋ยวนี้" Command="{Binding ScanCaptchaNowCommand}" IsEnabled="{Binding IsRunning}" ToolTip="กดเริ่มทำงานบัญชีนี้ก่อน" ToolTipService.ShowOnDisabled="True" Margin="0,0,6,0" Padding="10,4" />
                                                                    <Button Style="{StaticResource ActionDarkButton}" Content="ล้างผลลัพธ์" Command="{Binding ClearCaptchaResultsCommand}" Margin="0,0,10,0" />
                                                                </StackPanel>

                                                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                                                                    <CheckBox Content="ตรวจหาอัตโนมัติ" IsChecked="{Binding IsCaptchaAutoDetect}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                                                    <CheckBox Content="แก้อัตโนมัติ" IsChecked="{Binding IsAutoSolveCaptcha}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                                                </StackPanel>
                                                            </DockPanel>
                                                        </Border>

                                                        <!-- Visual Preview -->
                                                        <Border Grid.Row="2" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,8">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding HasCaptchaImage}" Value="True">
                                                                            <Setter Property="Visibility" Value="Visible" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding HasDirectImage}" Value="True">
                                                                            <Setter Property="Visibility" Value="Visible" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding HasCroppedImage}" Value="True">
                                                                            <Setter Property="Visibility" Value="Visible" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding IsCaptchaAlertVisible}" Value="True">
                                                                            <Setter Property="Visibility" Value="Visible" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <Grid>
                                                                <Grid.RowDefinitions>
                                                                    <RowDefinition Height="Auto" />
                                                                    <RowDefinition Height="Auto" />
                                                                </Grid.RowDefinitions>

                                                                <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,8">
                                                                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                                                                        <Border Background="{DynamicResource BadBrush}" CornerRadius="4" Padding="8,2" VerticalAlignment="Center">
                                                                            <TextBlock Text="พบ Captcha" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource OnPrimaryBrush}" />
                                                                        </Border>
                                                                        <Border Background="{DynamicResource Surface3Brush}" CornerRadius="4" Padding="6,2" Margin="8,0,0,0" VerticalAlignment="Center">
                                                                            <TextBlock Text="{Binding DetectedCaptchaTypeDescription}" FontSize="11" Foreground="{DynamicResource WarnBrush}" FontWeight="SemiBold" />
                                                                        </Border>
                                                                        <TextBlock Text="เวลานับถอยหลัง: " FontSize="11" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="12,0,0,0" />
                                                                        <TextBlock Text="{Binding DetectedCaptchaCountdown, FallbackValue='00:00'}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource BadBrush}" VerticalAlignment="Center" Margin="2,0,0,0" />
                                                                    </StackPanel>

                                                                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                                                                        <Button Style="{StaticResource PrimaryCtaButton}" Content="แก้ Captcha" Command="{Binding SolveCaptchaCommand}" IsEnabled="{Binding CanSolveCaptcha}" Padding="10,4" Margin="0,0,6,0" />
                                                                        <Button Style="{StaticResource ActionDarkButton}" Content="ปิดเสียงเตือน" Command="{Binding SilenceAlertCommand}" Margin="0,0,6,0" />
                                                                        <Button Style="{StaticResource ActionDarkButton}" Content="เปิดโฟลเดอร์" Command="{Binding OpenCaptchaImageFolderCommand}" Margin="0,0,6,0" />
                                                                        <Button Style="{StaticResource ActionDarkButton}" Content="บันทึกภาพ" Command="{Binding SaveCaptchaImageAsCommand}" />
                                                                    </StackPanel>
                                                                </DockPanel>

                                                                <Grid Grid.Row="1">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="12" />
                                                                        <ColumnDefinition Width="*" />
                                                                    </Grid.ColumnDefinitions>

                                                                    <Border Grid.Column="0" Background="{DynamicResource BgBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="6" Padding="8">
                                                                        <Grid>
                                                                            <Grid.RowDefinitions>
                                                                                <RowDefinition Height="Auto" />
                                                                                <RowDefinition Height="160" />
                                                                            </Grid.RowDefinitions>
                                                                            <TextBlock Grid.Row="0" Text="ภาพต้นฉบับ" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource PrimaryBrush}" Margin="0,0,0,4" />
                                                                            <Image Grid.Row="1" Source="{Binding DirectCaptchaImageSource}" Stretch="Uniform" MaxHeight="150" />
                                                                        </Grid>
                                                                    </Border>

                                                                    <Border Grid.Column="2" Background="{DynamicResource BgBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="6" Padding="8">
                                                                        <Grid>
                                                                            <Grid.RowDefinitions>
                                                                                <RowDefinition Height="Auto" />
                                                                                <RowDefinition Height="160" />
                                                                            </Grid.RowDefinitions>
                                                                            <TextBlock Grid.Row="0" Text="ภาพที่ตัดแล้ว" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource OkBrush}" Margin="0,0,0,4" />
                                                                            <Image Grid.Row="1" Source="{Binding CroppedCaptchaImageSource}" Stretch="Uniform" MaxHeight="150" />
                                                                        </Grid>
                                                                    </Border>
                                                                </Grid>
                                                            </Grid>
                                                        </Border>

                                                        <!-- DataGrid -->


                                                    </Grid>
                                                </ScrollViewer>
                                            </TabItem>
                                            <TabItem Header="บันทึกการทำงาน">
                                                <Grid Margin="0,10,0,0">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="420" />
                                                    </Grid.RowDefinitions>

                                                    <DockPanel Grid.Row="0" Margin="0,0,0,6">
                                                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                                                            <Button Style="{StaticResource ActionDarkButton}" Content="ล้างรายการ" Command="{Binding ClearLogsCommand}" Margin="0,0,6,0" />
                                                            <Button Style="{StaticResource ActionDarkButton}" Content="คัดลอกทั้งหมด" Command="{Binding CopyAllLogsCommand}" Margin="0,0,6,0" />
                                                            <Button Style="{StaticResource ActionDarkButton}" Content="เปิดไฟล์บันทึก" Command="{Binding OpenLogFileCommand}" Margin="0,0,6,0" />
                                                            <Button Style="{StaticResource ActionDarkButton}" Content="โฟลเดอร์บันทึก" Command="{Binding OpenLogsFolderCommand}" />
                                                        </StackPanel>

                                                        <ui:TextBox DockPanel.Dock="Right" Text="{Binding LogSearchText, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="ค้นหา..." Width="180" Padding="8,4" FontSize="11" />
                                                    </DockPanel>

                                                    <DataGrid Grid.Row="1" ItemsSource="{Binding FilteredLogs}" SelectedItem="{Binding SelectedLog}"
                                                              FontSize="12">
                                                        <DataGrid.Columns>
                                                            <DataGridTextColumn Header="เวลา" Binding="{Binding FormattedTime}" Width="85" />
                                                            <DataGridTextColumn Header="ความสำคัญ" Binding="{Binding LevelDisplay}" Width="70" />
                                                            <DataGridTextColumn Header="ข้อความ" Binding="{Binding Message}" Width="*" />
                                                        </DataGrid.Columns>
                                                    </DataGrid>
                                                </Grid>
                                            </TabItem>
                                        </TabControl>
                                    </Grid>
                                </DataTemplate>
                            </ContentControl.ContentTemplate>
                        </ContentControl>
                        <!-- ตั้งค่า (บันทึกเองทุกครั้งที่เปลี่ยน) -->
                        <ScrollViewer Visibility="{Binding IsNavSettings, Converter={StaticResource BoolToVis}}" VerticalScrollBarVisibility="Auto">
                            <StackPanel MaxWidth="760" HorizontalAlignment="Left" Margin="0,0,16,24">
                                <TextBlock Text="ตั้งค่า" Style="{StaticResource PageTitle}" />
                                <TextBlock Text="บันทึกให้อัตโนมัติทุกครั้งที่เปลี่ยน" Style="{StaticResource HintText}" Margin="0,2,0,18" />

                                <Border Style="{StaticResource SectionCard}">
                                    <DockPanel>
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Style="{StaticResource ActionDarkButton}" Content="ตรวจสิทธิ์ใหม่" Command="{Binding RefreshLicenseCommand}" Padding="14,8" Margin="0,0,8,0" />
                                            <Button Style="{StaticResource StopDangerButton}" Content="ออกจากระบบ" Command="{Binding LogoutCommand}" Padding="14,8" />
                                        </StackPanel>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock FontSize="17" FontWeight="SemiBold"><Run Text="แพ็กเกจ " /><Run Text="{Binding LicensePlan, Mode=OneWay}" /></TextBlock>
                                            <TextBlock Style="{StaticResource HintText}" Margin="0,3,0,0"><Run Text="{Binding LoggedInUsername, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding PlanUsageText, Mode=OneWay}" /><Run Text=" · หมดอายุ " /><Run Text="{Binding LicenseExpiryText, Mode=OneWay}" /></TextBlock>
                                            <TextBlock Text="{Binding LoginErrorMessage}" Foreground="{DynamicResource WarnBrush}" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </DockPanel>
                                </Border>

                                <Border Style="{StaticResource SectionCard}">
                                    <StackPanel>
                                        <TextBlock Text="แจ้งเตือนเมื่อต้องให้คุณช่วย" Style="{StaticResource SectionTitle}" />
                                        <DockPanel Margin="0,0,0,14">
                                            <ContentControl DockPanel.Dock="Right" VerticalAlignment="Center" Margin="16,0,0,0"><StackPanel Orientation="Horizontal"><Button Style="{StaticResource GhostButton}" Content="ทดสอบเสียง" Command="{Binding TestSoundCommand}" Padding="10,6" Margin="0,0,10,0" /><ui:ToggleSwitch IsChecked="{Binding EnableCaptchaSoundAlert}" AutomationProperties.Name="เสียงเตือน" /></StackPanel></ContentControl>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="เสียงเตือน" FontSize="14" Foreground="{DynamicResource FgBrush}" />
                                                <TextBlock Text="ดังเมื่อพบ Captcha ที่ต้องให้คุณช่วย" Style="{StaticResource HintText}" Margin="0,2,0,0" />
                                            </StackPanel>
                                        </DockPanel>
                                        <DockPanel Margin="0,0,0,10">
                                            <ContentControl DockPanel.Dock="Right" VerticalAlignment="Center" Margin="16,0,0,0"><StackPanel Orientation="Horizontal">
                                            <Button Style="{StaticResource PrimaryCtaButton}" Content="เชื่อม Telegram" Command="{Binding ConnectTelegramCommand}" Padding="16,8" Visibility="{Binding IsTelegramNotLinked, Converter={StaticResource BoolToVis}}" ToolTip="เปิดแชทบอทใน Telegram แล้วกด Start ไม่ต้องกรอก Token" />
                                            <StackPanel Orientation="Horizontal" Visibility="{Binding IsLinkingTelegram, Converter={StaticResource BoolToVis}}">
                                                <ui:ProgressRing IsIndeterminate="True" Width="16" Height="16" Margin="0,0,10,0" VerticalAlignment="Center" />
                                                <TextBlock Text="รอคุณกด Start ใน Telegram" VerticalAlignment="Center" Margin="0,0,10,0" />
                                                <Button Style="{StaticResource GhostButton}" Content="ยกเลิก" Command="{Binding CancelTelegramLinkCommand}" Padding="10,6" />
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Visibility="{Binding IsTelegramLinked, Converter={StaticResource BoolToVis}}">
                                                <Border Background="{DynamicResource OkSoftBrush}" CornerRadius="10" Padding="10,4" Margin="0,0,10,0" VerticalAlignment="Center"><TextBlock Text="เชื่อมแล้ว" Foreground="{DynamicResource OkBrush}" FontWeight="SemiBold" FontSize="12.5" /></Border>
                                                <Button Style="{StaticResource ActionDarkButton}" Content="ส่งข้อความทดสอบ" Command="{Binding TestTelegramCommand}" Padding="12,6" Margin="0,0,8,0" />
                                                <Button Style="{StaticResource GhostButton}" Content="ยกเลิกการเชื่อม" Command="{Binding DisconnectTelegramCommand}" Padding="10,6" />
                                            </StackPanel>
                                        </StackPanel></ContentControl>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="แจ้งเตือนทาง Telegram" FontSize="14" Foreground="{DynamicResource FgBrush}" />
                                                <TextBlock Text="กดเชื่อม แล้วกด Start ในแชทบอท ไม่ต้องกรอก Token" Style="{StaticResource HintText}" Margin="0,2,0,0" />
                                            </StackPanel>
                                        </DockPanel>
                                        <StackPanel Margin="0,0,0,4">
                                            <TextBlock Text="{Binding TelegramTestStatus}" Foreground="{DynamicResource PrimaryBrush}" FontSize="12.5" TextWrapping="Wrap" Margin="0,0,0,10">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding TelegramTestStatus}" Value=""><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <WrapPanel Margin="0,0,0,8" Visibility="{Binding ShowTelegramEvents, Converter={StaticResource BoolToVis}}">
                                                <CheckBox Content="เมื่อต้องให้ช่วยแก้ Captcha" IsChecked="{Binding TelegramAlertOnDetected}" Margin="0,0,16,6" />
                                                <CheckBox Content="แนบรูป Captcha" IsChecked="{Binding TelegramSendPhoto}" Margin="0,0,16,6" />
                                                <CheckBox Content="เมื่อแก้สำเร็จ" IsChecked="{Binding TelegramAlertOnSolved}" Margin="0,0,16,6" />
                                                <CheckBox Content="เมื่อแก้ไม่ผ่าน" IsChecked="{Binding TelegramAlertOnFailed}" Margin="0,0,0,6" />
                                            </WrapPanel>
                                            <Button Style="{StaticResource GhostButton}" Content="ใช้บอท Telegram ของฉันเอง (Token)" Command="{Binding ToggleManualTelegramCommand}" HorizontalAlignment="Left" Padding="6,4" Margin="-6,0,0,0" Visibility="{Binding IsTelegramNotLinked, Converter={StaticResource BoolToVis}}" />
                                            <StackPanel Visibility="{Binding ShowManualTelegram, Converter={StaticResource BoolToVis}}" Margin="0,10,0,0">
                                                <DockPanel Margin="0,0,0,14">
                                                    <ContentControl DockPanel.Dock="Right" VerticalAlignment="Center" Margin="16,0,0,0"><ui:ToggleSwitch IsChecked="{Binding EnableTelegramAlert}" AutomationProperties.Name="ใช้บอท Telegram ของฉันเอง" /></ContentControl>
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock Text="ใช้บอทของฉันเอง" FontSize="14" Foreground="{DynamicResource FgBrush}" />
                                                        <TextBlock Text="สำหรับคนที่มีบอท Telegram อยู่แล้ว" Style="{StaticResource HintText}" Margin="0,2,0,0" />
                                                    </StackPanel>
                                                </DockPanel>
                                                <StackPanel Margin="0,0,0,14">
                                                    <TextBlock Text="โทเคนบอต" Style="{StaticResource FieldLabel}" />
                                                    <DockPanel>
                                                        <Button DockPanel.Dock="Right" Style="{StaticResource ActionDarkButton}" Content="ทดสอบส่ง" Command="{Binding TestTelegramCommand}" Margin="8,0,0,0" Padding="12,6" />
                                                        <ui:TextBox Text="{Binding TelegramBotToken, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="เช่น 123456789:ABCdef..." FontFamily="{StaticResource MonoFont}" />
                                                    </DockPanel>
                                                </StackPanel>
                                                <StackPanel Margin="0,0,0,14">
                                                    <TextBlock Text="รหัสแชทหรือกลุ่ม" Style="{StaticResource FieldLabel}" />
                                                    <DockPanel>
                                                        <ui:TextBox Text="{Binding TelegramChatId, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="เช่น 987654321 หรือ -100123456789" FontFamily="{StaticResource MonoFont}" />
                                                    </DockPanel>
                                                </StackPanel>
                                            </StackPanel>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource SectionCard}">
                                    <StackPanel>
                                        <DockPanel>
                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                                <ComboBox SelectedIndex="{Binding ProxyModeIndex}" MinWidth="170" AutomationProperties.Name="โหมด Proxy">
                                                    <ComboBoxItem Content="อัตโนมัติ" />
                                                    <ComboBoxItem Content="ตั้งเองรายบัญชี" />
                                                    <ComboBoxItem Content="ไม่ใช้ Proxy" />
                                                </ComboBox>
                                            </StackPanel>
                                            <StackPanel>
                                                <TextBlock Text="Proxy" Style="{StaticResource SectionTitle}" Margin="0" />
                                                <TextBlock Text="{Binding ProxyModeHint}" Style="{StaticResource HintText}" Margin="0,2,0,0" />
                                            </StackPanel>
                                        </DockPanel>
                                        <StackPanel Visibility="{Binding IsProxyPoolVisible, Converter={StaticResource BoolToVis}}">
                                            <DataGrid ItemsSource="{Binding Proxies}" MaxHeight="280" Margin="0,12,0,0">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="ชื่อ Proxy" Binding="{Binding Name}" Width="*" />
                                                    <DataGridTextColumn Header="ประเภท" Binding="{Binding Protocol}" Width="90" />
                                                    <DataGridTextColumn Header="ที่อยู่ (IP)" Binding="{Binding Host}" Width="1.2*" />
                                                    <DataGridTextColumn Header="พอร์ต" Binding="{Binding Port}" Width="76" />
                                                    <DataGridTextColumn Header="ชื่อผู้ใช้" Binding="{Binding Username}" Width="90" />
                                                    <DataGridTextColumn Header="รหัสผ่าน" Binding="{Binding Password}" Width="90" />
                                                    <DataGridCheckBoxColumn Header="ใช้" Binding="{Binding IsActive}" Width="70" />
                                                    <DataGridTemplateColumn Header="" Width="108">
                                                        <DataGridTemplateColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <StackPanel Orientation="Horizontal">
                                                                    <Button Style="{StaticResource MicroButton}" Content="ทดสอบ"
                                                                            Command="{Binding DataContext.TestProxyItemCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                                            CommandParameter="{Binding}" Margin="0,0,6,0" />
                                                                    <Button Style="{StaticResource MicroButton}" Content="ลบ"
                                                                            Command="{Binding DataContext.RemoveProxyCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                                            CommandParameter="{Binding}" />
                                                                </StackPanel>
                                                            </DataTemplate>
                                                        </DataGridTemplateColumn.CellTemplate>
                                                    </DataGridTemplateColumn>
                                                </DataGrid.Columns>
                                            </DataGrid>
                                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                                <Button Style="{StaticResource PrimaryCtaButton}" Content="เพิ่ม Proxy" Command="{Binding AddProxyCommand}" Padding="14,8" Margin="0,0,8,0" />
                                                <Button Style="{StaticResource ActionDarkButton}" Content="บันทึกและทดสอบ" Command="{Binding RefreshProxiesCommand}" Padding="14,8" ToolTip="ทดสอบทุกตัว แล้วแจกให้แต่ละบัญชี" />
                                            </StackPanel>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <Expander Margin="0,0,0,12" Padding="0" Background="{DynamicResource SurfaceBrush}">
                                    <Expander.Header>
                                        <DockPanel Margin="4,6">
                                            <TextBlock DockPanel.Dock="Right" Text="ค่าที่ตั้งให้อัตโนมัติแล้ว" Style="{StaticResource HintText}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                            <TextBlock Text="ขั้นสูง" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        </DockPanel>
                                    </Expander.Header>
                                    <StackPanel Margin="20,14,20,10">
                                        <DockPanel Margin="0,0,0,14">
                                            <ContentControl DockPanel.Dock="Right" VerticalAlignment="Center" Margin="16,0,0,0"><ui:ToggleSwitch IsChecked="{Binding AutoSolveCaptcha}" AutomationProperties.Name="AI แก้ Captcha อัตโนมัติ" /></ContentControl>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="AI แก้ Captcha อัตโนมัติ" FontSize="14" Foreground="{DynamicResource FgBrush}" />
                                                <TextBlock Text="ปิดแล้วต้องแก้เองทุกครั้ง" Style="{StaticResource HintText}" Margin="0,2,0,0" />
                                            </StackPanel>
                                        </DockPanel>
                                        <StackPanel Margin="0,0,0,14">
                                            <TextBlock Text="รอก่อนให้ AI แก้" Style="{StaticResource FieldLabel}" />
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding AutoSolveDelaySeconds, StringFormat='{}{0} วินาที'}" Width="70" TextAlignment="Right" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryBrush}" />
                                                <Slider Minimum="0" Maximum="30" Value="{Binding AutoSolveDelaySeconds}" TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center" />
                                            </DockPanel>
                                            <TextBlock Text="แนะนำ 3-5 วินาที" Style="{StaticResource HintText}" Margin="0,2,0,0" />
                                        </StackPanel>
                                        <DockPanel Margin="0,0,0,14">
                                            <ContentControl DockPanel.Dock="Right" VerticalAlignment="Center" Margin="16,0,0,0"><ui:ToggleSwitch IsChecked="{Binding AutoHideOnLaunch}" AutomationProperties.Name="ซ่อนหน้าต่าง Studio หลังเปิด" /></ContentControl>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="ซ่อนหน้าต่าง Studio หลังเปิด" FontSize="14" Foreground="{DynamicResource FgBrush}" />
                                                <TextBlock Text="เครื่องทำงานเบาลง แสดงได้จากหน้าบัญชี" Style="{StaticResource HintText}" Margin="0,2,0,0" />
                                            </StackPanel>
                                        </DockPanel>
                                        <DockPanel Margin="0,0,0,14">
                                            <ContentControl DockPanel.Dock="Right" VerticalAlignment="Center" Margin="16,0,0,0"><ui:ToggleSwitch IsChecked="{Binding LoopCaptchaSoundAlert}" AutomationProperties.Name="เล่นเสียงวน" /></ContentControl>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="เล่นเสียงวนจนกว่าจะแก้เสร็จ" FontSize="14" Foreground="{DynamicResource FgBrush}" />
                                            </StackPanel>
                                        </DockPanel>
                                        <StackPanel Margin="0,0,0,14">
                                            <TextBlock Text="ความดังเสียงเตือน" Style="{StaticResource FieldLabel}" />
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding CaptchaSoundVolume, StringFormat='{}{0}%'}" Width="70" TextAlignment="Right" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryBrush}" />
                                                <Slider Minimum="0" Maximum="100" Value="{Binding CaptchaSoundVolume}" TickFrequency="5" IsSnapToTickEnabled="True" VerticalAlignment="Center" />
                                            </DockPanel>
    
                                        </StackPanel>
                                        <StackPanel Margin="0,0,0,14">
                                            <TextBlock Text="ไฟล์เสียงเตือน" Style="{StaticResource FieldLabel}" />
                                            <DockPanel>
                                                <Button DockPanel.Dock="Right" Style="{StaticResource ActionDarkButton}" Content="เลือกไฟล์" Command="{Binding BrowseSoundFileCommand}" Margin="8,0,0,0" Padding="12,6" />
                                                <ui:TextBox Text="{Binding CaptchaSoundFilePath, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="เว้นว่างเพื่อใช้เสียงมาตรฐาน" />
                                            </DockPanel>
                                        </StackPanel>
                                        <DockPanel Margin="0,0,0,14">
                                            <ContentControl DockPanel.Dock="Right" VerticalAlignment="Center" Margin="16,0,0,0"><ui:ToggleSwitch IsChecked="{Binding AutoSaveCaptchaImage}" AutomationProperties.Name="บันทึกภาพ Captcha" /></ContentControl>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="บันทึกภาพ Captcha ลงเครื่อง" FontSize="14" Foreground="{DynamicResource FgBrush}" />
                                            </StackPanel>
                                        </DockPanel>
                                        <StackPanel Margin="0,0,0,14">
                                            <TextBlock Text="โฟลเดอร์เก็บภาพ Captcha" Style="{StaticResource FieldLabel}" />
                                            <DockPanel>
                                                <Button DockPanel.Dock="Right" Style="{StaticResource ActionDarkButton}" Content="เปิด" Command="{Binding OpenCaptchaFolderCommand}" Margin="8,0,0,0" Padding="12,6" />
                                                <Button DockPanel.Dock="Right" Style="{StaticResource ActionDarkButton}" Content="เลือกโฟลเดอร์" Command="{Binding BrowseSaveDirectoryCommand}" Margin="8,0,0,0" Padding="12,6" />
                                                <ui:TextBox Text="{Binding CaptchaSaveDirectory, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="" />
                                            </DockPanel>
                                        </StackPanel>
                                        <StackPanel Margin="0,0,0,14">
                                            <TextBlock Text="ที่อยู่ TikTok LIVE Studio" Style="{StaticResource FieldLabel}" />
                                            <DockPanel>
                                                <ui:TextBox Text="{Binding StudioExePath, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="หาให้อัตโนมัติ แก้เฉพาะเมื่อติดตั้งไว้ที่อื่น" FontFamily="{StaticResource MonoFont}" />
                                            </DockPanel>
                                        </StackPanel>
                                        <WrapPanel Margin="0,4,0,10">
                                            <Button Style="{StaticResource ActionDarkButton}" Content="ซิงค์ข้อมูลขึ้นระบบ" Command="{Binding SyncWithCloudCommand}" Padding="14,8" Margin="0,0,8,0" />
                                            <Button Style="{StaticResource ActionDarkButton}" Content="เปิดโฟลเดอร์บันทึกระบบ" Command="{Binding OpenLogsFolderCommand}" Padding="14,8" />
                                        </WrapPanel>
                                        <TextBlock Style="{StaticResource HintText}"><Run Text="รหัสเครื่อง " /><Run Text="{Binding CurrentMachineHwid, Mode=OneWay}" FontFamily="{StaticResource MonoFont}" /></TextBlock>
                                    </StackPanel>
                                </Expander>

                                <TextBlock Style="{StaticResource HintText}" Margin="2,6,0,0"><Run Text="FlowUltraTech " /><Run Text="{Binding AppVersionText, Mode=OneWay}" /><Run Text=" · อัปเดตให้อัตโนมัติเมื่อมีเวอร์ชันใหม่" /></TextBlock>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
