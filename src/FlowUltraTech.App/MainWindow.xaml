                                                                                    </StackPanel>
                                                                                    <StackPanel Grid.Column="2">
                                                                                        <TextBlock Text="พื้นหลัง" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,4" />
