                                                                                                  SelectedIndex="{Binding OverlayBackgroundStyleIndex, Mode=TwoWay}"
                                                                                                  Background="{DynamicResource Surface2Brush}" Foreground="{DynamicResource FgBrush}" BorderBrush="{DynamicResource LineBrush}" Padding="8,5" FontSize="11" />
