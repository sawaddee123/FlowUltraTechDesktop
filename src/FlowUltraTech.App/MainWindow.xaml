<Window x:Class="FlowUltraTech.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:models="clr-namespace:FlowUltraTech.Core.Models;assembly=FlowUltraTech.Core"
        mc:Ignorable="d"
        Title="{Binding WindowTitle, FallbackValue='FlowUltraTech'}" 
        Icon="Assets/app.ico"
        Height="820" Width="1260"
        MinHeight="700" MinWidth="1050"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        Topmost="False"
        ShowInTaskbar="True"
        Background="{DynamicResource BgBrush}"
        Foreground="{DynamicResource FgBrush}"
        FontFamily="{StaticResource AppFont}"
        TextOptions.TextFormattingMode="Display">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0"
                      ResizeBorderThickness="6"
                      CornerRadius="0"
                      GlassFrameThickness="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    
    
    <Border x:Name="RootBorder" Background="{DynamicResource BgBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1">
        <Grid Background="{DynamicResource BgBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 1. CUSTOM WINDOW HEADER & TITLE BAR (DRAGGABLE) -->
            <Border Grid.Row="0" Background="{DynamicResource SurfaceBrush}" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource LineBrush}" 
                    MouseLeftButtonDown="Header_MouseLeftButtonDown"
                    MouseMove="Header_MouseMove"
                    MouseLeftButtonUp="Header_MouseLeftButtonUp"
                    MouseLeave="Header_MouseLeave">
                <DockPanel LastChildFill="True">
                    
                    <!-- Right: Theme toggle + Window Controls -->
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Stretch">
                        <Button x:Name="ThemeToggleButton" Style="{StaticResource WindowControlButton}" Click="ThemeToggle_Click" ToolTip="สลับธีม มืด / สว่าง" AutomationProperties.Name="สลับธีม">
                            <ui:SymbolIcon x:Name="ThemeToggleIcon" Symbol="WeatherSunny16" FontSize="14" />
                        </Button>
                        <Rectangle Width="1" Height="18" Fill="{DynamicResource LineBrush}" VerticalAlignment="Center" Margin="2,0,2,0" />

                        <!-- Window Control Buttons -->
                        <Button Style="{StaticResource WindowControlButton}" Click="MinimizeWindow_Click" ToolTip="ย่อหน้าต่าง (Minimize)">
                            <ui:SymbolIcon Symbol="Subtract16" FontSize="12" />
                        </Button>
                        <Button x:Name="MaximizeButton" Style="{StaticResource WindowControlButton}" Click="MaximizeWindow_Click" ToolTip="ขยายเต็มจอ (Maximize)">
                            <ui:SymbolIcon x:Name="MaximizeIcon" Symbol="Maximize16" FontSize="12" />
                        </Button>
                        <Button Style="{StaticResource WindowCloseButton}" Click="CloseWindow_Click" ToolTip="ปิดโปรแกรม (Close)">
                            <ui:SymbolIcon Symbol="Dismiss16" FontSize="12" />
                        </Button>
                    </StackPanel>

                    <!-- Left: App Branding & Live Status -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,6,0,6">
                        <Image Source="{DynamicResource WordmarkImage}" Height="20" Margin="0,0,10,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" />
                        <Border Background="{DynamicResource Surface2Brush}" CornerRadius="6" Padding="6,1" Margin="0,0,12,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding AppVersionText, FallbackValue='v1.7.5'}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource MutedBrush}" />
                        </Border>

                        <!-- Live Running Indicator -->
                        <Border CornerRadius="12" Padding="8,2" VerticalAlignment="Center" Background="{DynamicResource Surface2Brush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="สแตนด์บาย" />
                                            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasAnyCaptchaAlert}" Value="True">
                                                    <Setter Property="Text" Value="{Binding TotalCaptchaAlertCount, StringFormat='พบ Captcha ({0})'}" />
                                                    <Setter Property="Foreground" Value="{DynamicResource BadBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="{Binding RunningStatusSummary, StringFormat=' • {0}'}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource OkBrush}" VerticalAlignment="Center" Margin="4,0,0,0" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </DockPanel>
            </Border>

        <!-- 2. MAIN BODY: LEFT SIDEBAR + CONTENT VIEWPORT -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- LEFT SIDEBAR -->
            <Border Grid.Column="0" Background="{DynamicResource SurfaceBrush}" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource LineBrush}">
                <DockPanel LastChildFill="True">
                    <!-- Footer: ผู้ใช้และเวอร์ชัน -->
                    <Border DockPanel.Dock="Bottom" Background="{DynamicResource Surface2Brush}" CornerRadius="10" Padding="10,8" Margin="8,8,8,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="32" Height="32" CornerRadius="16" Background="{DynamicResource PrimarySoftBrush}" Margin="0,0,10,0" VerticalAlignment="Center">
                                <ui:SymbolIcon Symbol="Person20" Foreground="{DynamicResource PrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding LoggedInUsername, FallbackValue='ผู้ใช้งาน'}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource FgBrush}" TextTrimming="CharacterEllipsis" />
                                <TextBlock FontSize="11" Foreground="{DynamicResource SubtleBrush}" TextTrimming="CharacterEllipsis">
                                    <Run Text="{Binding LicensePlan, FallbackValue='standard', Mode=OneWay}" /><Run Text="  ·  " /><Run Text="{Binding AppVersionText, Mode=OneWay}" />
                                </TextBlock>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Nav Items List -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,8,0,0">
                        <StackPanel Margin="8,0">
                            <!-- Section 1: Main Menu -->
                            <TextBlock Text="เมนูหลัก" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource SubtleBrush}" Margin="10,8,10,6" />

                            <!-- Nav 0: Instances -->
                            <Button Command="{Binding NavigateInstancesCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="0" Margin="0,2" Background="Transparent" BorderThickness="0" Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="NavPill" CornerRadius="6" Padding="12,9" Background="Transparent" HorizontalAlignment="Stretch">
                                            <Grid HorizontalAlignment="Stretch">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <ui:SymbolIcon x:Name="NavIcon" Grid.Column="0" Symbol="Apps24" FontSize="15" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                                <TextBlock x:Name="NavText" Grid.Column="1" Text="บัญชีสตูดิโอ" FontSize="12" FontWeight="Medium" Foreground="{DynamicResource FgBrush}" VerticalAlignment="Center" />
                                                <Border Grid.Column="2" Background="{DynamicResource Surface3Brush}" CornerRadius="8" Padding="6,1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Instances.Count}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource MutedBrush}" />
                                                </Border>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsNavInstances}" Value="True">
                                                <Setter TargetName="NavPill" Property="Background" Value="{DynamicResource Surface3Brush}" />
                                                <Setter TargetName="NavText" Property="Foreground" Value="{DynamicResource FgBrush}" />
                                                <Setter TargetName="NavText" Property="FontWeight" Value="SemiBold" />
                                                <Setter TargetName="NavIcon" Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
                                            </DataTrigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="NavPill" Property="Background" Value="{DynamicResource Surface2Brush}" />
                                                <Setter TargetName="NavText" Property="Foreground" Value="{DynamicResource FgBrush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <!-- Nav 1: Captcha Center -->
                            <Button Command="{Binding NavigateCaptchaCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="0" Margin="0,2" Background="Transparent" BorderThickness="0" Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="NavPill" CornerRadius="6" Padding="12,9" Background="Transparent" HorizontalAlignment="Stretch">
                                            <Grid HorizontalAlignment="Stretch">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <ui:SymbolIcon x:Name="NavIcon" Grid.Column="0" Symbol="ShieldCheckmark24" FontSize="15" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                                <TextBlock x:Name="NavText" Grid.Column="1" Text="Captcha" FontSize="12" FontWeight="Medium" Foreground="{DynamicResource FgBrush}" VerticalAlignment="Center" />
                                                <Border Grid.Column="2" CornerRadius="8" Padding="6,1" VerticalAlignment="Center">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="{DynamicResource Surface3Brush}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HasAnyCaptchaAlert}" Value="True">
                                                                    <Setter Property="Background" Value="{DynamicResource BadBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock FontSize="10" FontWeight="SemiBold">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Text" Value="{Binding TotalCaptchaAlertCount}" />
                                                                <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding HasAnyCaptchaAlert}" Value="True">
                                                                        <Setter Property="Text" Value="{Binding TotalCaptchaAlertCount}" />
                                                                        <Setter Property="Foreground" Value="{DynamicResource OnPrimaryBrush}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Border>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsNavCaptcha}" Value="True">
                                                <Setter TargetName="NavPill" Property="Background" Value="{DynamicResource Surface3Brush}" />
                                                <Setter TargetName="NavText" Property="Foreground" Value="{DynamicResource FgBrush}" />
                                                <Setter TargetName="NavText" Property="FontWeight" Value="SemiBold" />
                                                <Setter TargetName="NavIcon" Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
                                            </DataTrigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="NavPill" Property="Background" Value="{DynamicResource Surface2Brush}" />
                                                <Setter TargetName="NavText" Property="Foreground" Value="{DynamicResource FgBrush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <!-- Nav 2: Proxies & Network -->
                            <Button Command="{Binding NavigateProxiesCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="0" Margin="0,2" Background="Transparent" BorderThickness="0" Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="NavPill" CornerRadius="6" Padding="12,9" Background="Transparent" HorizontalAlignment="Stretch">
                                            <Grid HorizontalAlignment="Stretch">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <ui:SymbolIcon x:Name="NavIcon" Grid.Column="0" Symbol="Globe24" FontSize="15" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                                <TextBlock x:Name="NavText" Grid.Column="1" Text="Proxy" FontSize="12" FontWeight="Medium" Foreground="{DynamicResource FgBrush}" VerticalAlignment="Center" />
                                                <Border Grid.Column="2" Background="{DynamicResource Surface3Brush}" CornerRadius="8" Padding="6,1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Proxies.Count}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource MutedBrush}" />
                                                </Border>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsNavProxies}" Value="True">
                                                <Setter TargetName="NavPill" Property="Background" Value="{DynamicResource Surface3Brush}" />
                                                <Setter TargetName="NavText" Property="Foreground" Value="{DynamicResource FgBrush}" />
                                                <Setter TargetName="NavText" Property="FontWeight" Value="SemiBold" />
                                                <Setter TargetName="NavIcon" Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
                                            </DataTrigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="NavPill" Property="Background" Value="{DynamicResource Surface2Brush}" />
                                                <Setter TargetName="NavText" Property="Foreground" Value="{DynamicResource FgBrush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <!-- Nav 3: Auto-Reply Rules -->
                            <Button Command="{Binding NavigateRulesCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="0" Margin="0,2" Background="Transparent" BorderThickness="0" Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="NavPill" CornerRadius="6" Padding="12,9" Background="Transparent" HorizontalAlignment="Stretch">
                                            <Grid HorizontalAlignment="Stretch">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <ui:SymbolIcon x:Name="NavIcon" Grid.Column="0" Symbol="Bot24" FontSize="15" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                                <TextBlock x:Name="NavText" Grid.Column="1" Text="ตอบแชทอัตโนมัติ" FontSize="12" FontWeight="Medium" Foreground="{DynamicResource FgBrush}" VerticalAlignment="Center" />
                                                <Border Grid.Column="2" Background="{DynamicResource Surface3Brush}" CornerRadius="8" Padding="6,1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Rules.Count}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource MutedBrush}" />
                                                </Border>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsNavRules}" Value="True">
                                                <Setter TargetName="NavPill" Property="Background" Value="{DynamicResource Surface3Brush}" />
                                                <Setter TargetName="NavText" Property="Foreground" Value="{DynamicResource FgBrush}" />
                                                <Setter TargetName="NavText" Property="FontWeight" Value="SemiBold" />
                                                <Setter TargetName="NavIcon" Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
                                            </DataTrigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="NavPill" Property="Background" Value="{DynamicResource Surface2Brush}" />
                                                <Setter TargetName="NavText" Property="Foreground" Value="{DynamicResource FgBrush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <!-- Section 2: System -->
                            <Separator Margin="8,10" Background="{DynamicResource Surface3Brush}" />
                            <TextBlock Text="ระบบ" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource SubtleBrush}" Margin="10,4,10,6" />

                            <!-- Nav 4: Settings -->
                            <Button Command="{Binding NavigateSettingsCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="0" Margin="0,2" Background="Transparent" BorderThickness="0" Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="NavPill" CornerRadius="6" Padding="12,9" Background="Transparent" HorizontalAlignment="Stretch">
                                            <Grid HorizontalAlignment="Stretch">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <ui:SymbolIcon x:Name="NavIcon" Grid.Column="0" Symbol="Settings24" FontSize="15" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                                <TextBlock x:Name="NavText" Grid.Column="1" Text="ตั้งค่า" FontSize="12" FontWeight="Medium" Foreground="{DynamicResource FgBrush}" VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsNavSettings}" Value="True">
                                                <Setter TargetName="NavPill" Property="Background" Value="{DynamicResource Surface3Brush}" />
                                                <Setter TargetName="NavText" Property="Foreground" Value="{DynamicResource FgBrush}" />
                                                <Setter TargetName="NavText" Property="FontWeight" Value="SemiBold" />
                                                <Setter TargetName="NavIcon" Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
                                            </DataTrigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="NavPill" Property="Background" Value="{DynamicResource Surface2Brush}" />
                                                <Setter TargetName="NavText" Property="Foreground" Value="{DynamicResource FgBrush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- RIGHT CONTENT VIEWPORT -->
            <Border Grid.Column="1" Background="{DynamicResource BgBrush}" Padding="16,12">
                <Grid>
                    <!-- VIEW 0: INSTANCES MANAGEMENT -->
                    <Grid Visibility="{Binding IsNavInstances, Converter={StaticResource BoolToVis}}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!-- VIEW HEADER: Title (Left) + Action buttons (Right) -->
                            <Grid Grid.Row="0" Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="บัญชีสตูดิโอ" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource FgBrush}" VerticalAlignment="Center" />
                                    <Border Background="{DynamicResource Surface2Brush}" CornerRadius="10" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Instances.Count, StringFormat='{}{0} บัญชี'}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryBrush}" />
                                    </Border>
                                    <Border Background="{DynamicResource PrimarySoftBrush}" CornerRadius="10" Padding="8,2" Margin="6,0,0,0" VerticalAlignment="Center" ToolTip="โควต้าจำนวนจอสูงสุดที่อนุญาต">
                                        <TextBlock Text="{Binding QuotaStatusSummary}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource OkBrush}" />
                                    </Border>
                                </StackPanel>

                                <!-- Contextual Action Buttons for Instances (Pinned to Right) -->
                                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Button Style="{StaticResource TopNavButton}" Command="{Binding StartAllCommand}" Margin="0,0,6,0">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <ui:SymbolIcon Symbol="Play16" Foreground="{DynamicResource OkBrush}" Margin="0,0,6,0" />
                                            <TextBlock Text="เริ่มทุกจอ" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    
                                    <Button Style="{StaticResource TopNavButton}" Command="{Binding StopAllCommand}" Margin="0,0,8,0">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <ui:SymbolIcon Symbol="Stop16" Foreground="{DynamicResource BadBrush}" Margin="0,0,6,0" />
                                            <TextBlock Text="ปิดทุกจอ" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    
                                    <Button Style="{StaticResource TopNavButton}" Command="{Binding HideAllWindowsCommand}" Margin="0,0,6,0" ToolTip="ซ่อนหน้าต่างสตูดิโอทั้งหมด เพื่อให้เครื่องทำงานเบาลง">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <ui:SymbolIcon Symbol="EyeOff16" Foreground="{DynamicResource MutedBrush}" Margin="0,0,6,0" />
                                            <TextBlock Text="ซ่อนทุกจอ" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    
                                    <Button Style="{StaticResource TopNavButton}" Command="{Binding ShowAllWindowsCommand}" Margin="0,0,8,0">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <ui:SymbolIcon Symbol="Eye16" Foreground="{DynamicResource MutedBrush}" Margin="0,0,6,0" />
                                            <TextBlock Text="แสดงทุกจอ" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>

                                    <Button Style="{StaticResource TopNavButton}" Command="{Binding ScanAllCaptchasCommand}" Margin="0,0,8,0">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <ui:SymbolIcon Symbol="ShieldCheckmark16" Foreground="{DynamicResource WarnBrush}" Margin="0,0,6,0" />
                                            <TextBlock Text="ตรวจหา Captcha" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>

                                    <!-- Primary Focal CTA Button -->
                                    <Button Style="{StaticResource PrimaryCtaButton}" Command="{Binding AddInstanceCommand}" Padding="14,6">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <ui:SymbolIcon Symbol="Add16" Foreground="{DynamicResource OnPrimaryBrush}" Margin="0,0,6,0" />
                                            <TextBlock Text="เพิ่มบัญชีใหม่" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>

                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding Instances}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="8" Margin="0,0,0,10" Padding="14,12">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>

                                                    <!-- ROW 0: CLEAN DASHBOARD ROW -->
                                                    <Grid Grid.Row="0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>

                                                        <!-- Profile Avatar -->
                                                        <Grid Grid.Column="0" Margin="0,0,12,0" VerticalAlignment="Center">
                                                            <Border Width="40" Height="40" CornerRadius="20" Visibility="{Binding AvatarVisibility}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1.5"
                                                                    RenderOptions.BitmapScalingMode="HighQuality" RenderOptions.EdgeMode="Aliased">
                                                                <Border.Background>
                                                                    <ImageBrush ImageSource="{Binding AvatarImageSource}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" />
                                                                </Border.Background>
                                                            </Border>
                                                            <Border Width="40" Height="40" CornerRadius="20" Background="{DynamicResource Surface3Brush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1.5" Visibility="{Binding FallbackAvatarVisibility}">
                                                                <ui:SymbolIcon Symbol="Person20" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}" />
                                                            </Border>
                                                        </Grid>

                                                        <!-- Account Identity & Metadata (Streamer Focal Point) -->
                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                <!-- Main Display Name (Streamer Nickname or Slot Name if not logged in) -->
                                                                <TextBlock Text="{Binding PrimaryDisplayName}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource FgBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />

                                                                <!-- Streamer Handle (@username) -->
                                                                <TextBlock Text="{Binding StreamerHandle}" FontSize="13" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,10,0" />

                                                                <!-- Status Pill -->
                                                                <Border CornerRadius="4" Padding="6,2" Margin="0,0,6,0" VerticalAlignment="Center" Background="{DynamicResource Surface2Brush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1">
                                                                    <TextBlock Text="{Binding StatusDisplay}" FontSize="11" FontWeight="Medium" Foreground="{DynamicResource FgBrush}" />
                                                                </Border>

                                                                <!-- Native Proxy Pill -->
                                                                <Border CornerRadius="4" Padding="6,2" Margin="0,0,6,0" VerticalAlignment="Center" Background="{DynamicResource PrimarySoftBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1">
                                                                    <TextBlock Text="{Binding ProxySummaryBadgeText}" FontSize="10.5" FontWeight="Medium" Foreground="{DynamicResource PrimaryBrush}" />
                                                                </Border>

                                                                <!-- Window Visibility Pill (Running Only) -->
                                                                <Border Background="{DynamicResource Surface2Brush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="4" Padding="6,2" Visibility="{Binding RunningVisibility}" VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding WindowVisibilityDisplay}" FontSize="10" Foreground="{DynamicResource MutedBrush}" />
                                                                </Border>
                                                            </StackPanel>

                                                            <!-- Subtitle: Slot & Technical Sandbox Metadata -->
                                                            <TextBlock Text="{Binding SlotSubtitle}" FontSize="11" Foreground="{DynamicResource SubtleBrush}" Margin="0,4,0,0" />
                                                        </StackPanel>

                                                        <!-- Action Buttons (Pinned to Right - Anchored Controls) -->
                                                        <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                            <!-- เข้าสู่ระบบ (แสดงเมื่อยังไม่ล็อกอิน) -->
                                                            <Button Style="{StaticResource PrimaryCtaButton}" Command="{Binding OpenStudioForLoginCommand}" 
                                                                    Visibility="{Binding NotLoggedInVisibility}" IsEnabled="{Binding IsNotRunning}" 
                                                                    Margin="0,0,6,0" Padding="14,6" FontSize="12">
                                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                    <ui:SymbolIcon Symbol="PersonKey20" Foreground="{DynamicResource OnPrimaryBrush}" Margin="0,0,6,0" />
                                                                    <TextBlock Text="เข้าสู่ระบบ" VerticalAlignment="Center" />
                                                                </StackPanel>
                                                            </Button>

                                                            <!-- ปุ่มเริ่มทำงาน (แสดงเมื่อล็อกอินแล้ว - Anchored Control) -->
                                                            <Button Style="{StaticResource PrimaryCtaButton}" Command="{Binding StartCommand}" 
                                                                    Visibility="{Binding LoggedInVisibility}" IsEnabled="{Binding CanStart}" ToolTip="{Binding StartButtonToolTip}"
                                                                    Margin="0,0,6,0" Padding="12,6" FontSize="12">
                                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                    <ui:SymbolIcon Symbol="Play16" Foreground="{DynamicResource OnPrimaryBrush}" Margin="0,0,5,0" />
                                                                    <TextBlock Text="เริ่มทำงาน" VerticalAlignment="Center" />
                                                                </StackPanel>
                                                            </Button>

                                                            <!-- ปุ่มหยุดทำงาน (แสดงเมื่อล็อกอินแล้ว - วางคู่กับปุ่มเริ่มอย่างมั่นคง ไม่หายไปไหน) -->
                                                            <Button Style="{StaticResource StopDangerButton}" Command="{Binding StopCommand}" 
                                                                    Visibility="{Binding LoggedInVisibility}" IsEnabled="{Binding CanStop}" ToolTip="{Binding StopButtonToolTip}"
                                                                    Margin="0,0,6,0" Padding="12,6" FontSize="12">
                                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                    <ui:SymbolIcon Symbol="Stop16" Foreground="{DynamicResource BadBrush}" Margin="0,0,5,0" />
                                                                    <TextBlock Text="หยุด" Foreground="{DynamicResource BadBrush}" VerticalAlignment="Center" />
                                                                </StackPanel>
                                                            </Button>

                                                            <!-- สลับการซ่อน/แสดงหน้าต่าง -->
                                                            <Button Style="{StaticResource ActionDarkButton}" Command="{Binding ToggleVisibilityCommand}" 
                                                                    Visibility="{Binding RunningVisibility}" Margin="0,0,6,0" Padding="10,6" ToolTip="สลับการซ่อน/แสดงหน้าต่าง">
                                                                <ui:SymbolIcon Symbol="Eye16" Foreground="{DynamicResource MutedBrush}" />
                                                            </Button>

                                                            <!-- ไลฟ์ Overlay (Anchored Trigger with Vector Clock Icon) -->
                                                            <Button Style="{StaticResource ActionDarkButton}" Command="{Binding OpenOverlayTabCommand}"
                                                                    Margin="0,0,6,0" Padding="10,6" FontSize="12" ToolTip="ตั้งค่านาฬิกาเวลาจริงและส่งเข้าฉากไลฟ์">
                                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                    <Path Width="14" Height="14" Stretch="Uniform" Stroke="{DynamicResource LineBrush}" StrokeThickness="1.6"
                                                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" Margin="0,0,6,0" VerticalAlignment="Center"
                                                                          Data="M 8,1.5 A 6.5,6.5 0 1 1 7.99,1.5 Z M 8,4.2 L 8,8 L 10.6,9.6" />
                                                                    <TextBlock Text="ไลฟ์ Overlay" VerticalAlignment="Center" />
                                                                </StackPanel>
                                                            </Button>

                                                            <!-- เปิด/ปิด Detail -->
                                                            <Button Style="{StaticResource ActionDarkButton}" Content="{Binding DetailButtonText}" Command="{Binding ToggleDetailCommand}" 
                                                                    Margin="0,0,6,0" Padding="12,6" FontSize="12" />

                                                            <!-- ลบบัญชีนี้ -->
                                                            <Button Style="{StaticResource ActionDarkButton}" Command="{Binding DataContext.RemoveInstanceCommand, RelativeSource={RelativeSource AncestorType=Window}}" 
                                                                    CommandParameter="{Binding}" Padding="8,6" ToolTip="ลบบัญชีนี้">
                                                                <ui:SymbolIcon Symbol="Delete16" Foreground="{DynamicResource MutedBrush}" />
                                                            </Button>
                                                        </StackPanel>
                                                    </Grid>

                                                    <!-- ROW 1: INLINE ERROR BANNER -->
                                                    <Border Grid.Row="1" Visibility="{Binding ErrorVisibility}" Background="{DynamicResource BadSoftBrush}" BorderBrush="{DynamicResource BadBrush}" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,8,0,0">
                                                        <DockPanel LastChildFill="True">
                                                            <Button Style="{StaticResource MicroButton}" DockPanel.Dock="Right" Content="คัดลอกข้อความผิดพลาด" Command="{Binding CopyErrorCommand}" />
                                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                <TextBlock Text="ข้อผิดพลาด: " FontWeight="Bold" FontSize="11" Foreground="{DynamicResource BadBrush}" VerticalAlignment="Center" />
                                                                <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource BadBrush}" FontSize="11" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                            </StackPanel>
                                                        </DockPanel>
                                                    </Border>

                                                    <!-- ROW 2: CAPTCHA ALERT POPUP -->
                                                    <Border Grid.Row="2" Visibility="{Binding CaptchaAlertVisibility}" Background="{DynamicResource WarnSoftBrush}" BorderBrush="{DynamicResource WarnBrush}" BorderThickness="1.5" CornerRadius="8" Padding="12,8" Margin="0,8,0,0">
                                                        <DockPanel LastChildFill="True">
                                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                                                <Button Style="{StaticResource PrimaryCtaButton}" Content="แก้ทันที" Command="{Binding SolveCaptchaCommand}" IsEnabled="{Binding CanSolveCaptcha}" Padding="10,4" Margin="0,0,6,0" />
                                                                <Button Style="{StaticResource ActionDarkButton}" Content="ดูรายละเอียด" Command="{Binding OpenCaptchaTabCommand}" Margin="0,0,6,0" />
                                                                <Button Style="{StaticResource ActionDarkButton}" Command="{Binding DismissCaptchaAlertCommand}" Padding="8,4" ToolTip="ปิดแจ้งเตือน"><ui:SymbolIcon Symbol="Dismiss16" /></Button>
                                                            </StackPanel>

                                                            <DockPanel LastChildFill="True" VerticalAlignment="Center" Margin="0,0,12,0">
                                                                <Border DockPanel.Dock="Left" Width="40" Height="40" CornerRadius="6" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource WarnBrush}" BorderThickness="1" Margin="0,0,10,0" VerticalAlignment="Center" ClipToBounds="True">
                                                                    <Border.Style>
                                                                        <Style TargetType="Border">
                                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding HasCaptchaImage}" Value="True">
                                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Border.Style>
                                                                    <Image Source="{Binding CaptchaImageSource}" Stretch="UniformToFill" />
                                                                </Border>

                                                                <StackPanel VerticalAlignment="Center">
                                                                    <StackPanel Orientation="Horizontal">
                                                                        <TextBlock Text="พบ Captcha" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource WarnBrush}" VerticalAlignment="Center" />
                                                                        <Border Background="{DynamicResource WarnBrush}" CornerRadius="4" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                                                            <TextBlock Text="{Binding DetectedCaptchaCount, StringFormat='พบ {0} จุด'}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource OnPrimaryBrush}" />
                                                                        </Border>
                                                                        <TextBlock Text="{Binding LastCaptchaDetectedTime, StringFormat='เวลา {0}'}" FontSize="11" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="8,0,0,0" />
                                                                    </StackPanel>
                                                                    <TextBlock Text="{Binding CaptchaAlertMessage}" FontSize="11" Foreground="{DynamicResource FgBrush}" TextTrimming="CharacterEllipsis" MaxWidth="480" Margin="0,2,0,0" />
                                                                </StackPanel>
                                                            </DockPanel>
                                                        </DockPanel>
                                                    </Border>

                                                    <!-- ROW 3: DETAIL PANEL -->
                                                    <Border Grid.Row="3" Visibility="{Binding DetailVisibility}" Margin="0,10,0,0" Padding="12" Background="{DynamicResource BgBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="8">
                                                        <StackPanel>
                                                            <DockPanel LastChildFill="False" Margin="0,0,0,8">
                                                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                                                                    <TextBlock Text="สถานะบัญชี:" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource FgBrush}" Margin="0,0,8,0" />
                                                                    <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource MutedBrush}" FontSize="11" MaxWidth="380" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                                </StackPanel>

                                                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                                                                    <Border Visibility="{Binding RunningVisibility}" Background="{DynamicResource OkSoftBrush}" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                                                                        <TextBlock Text="เชื่อมต่อแล้ว" FontSize="11" Foreground="{DynamicResource OkBrush}" FontWeight="SemiBold" />
                                                                    </Border>
                                                                    <Button Style="{StaticResource MicroButton}" Content="คัดลอกข้อความผิดพลาด" Command="{Binding CopyErrorCommand}" Visibility="{Binding ErrorVisibility}" Margin="0,0,6,0" />
                                                                </StackPanel>
                                                            </DockPanel>

                                                            <!-- Detail Subtabs -->
                                                            <TabControl SelectedIndex="{Binding SelectedDetailTabIndex}">
                                                                <!-- SUBTAB 0: LOGIN & SESSION -->
                                                                <TabItem Header="บัญชี">
                                                                    <Grid Margin="0,10,0,0">
                                                                        <Grid.RowDefinitions>
                                                                            <RowDefinition Height="Auto" />
                                                                            <RowDefinition Height="Auto" />
                                                                        </Grid.RowDefinitions>

                                                                        <!-- Session Toolbar: Actions & Identity Status (No duplicate avatar/name) -->
                                                                        <Border Grid.Row="0" Background="{DynamicResource Surface2Brush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,0,10">
                                                                            <DockPanel LastChildFill="True">
                                                                                <!-- Right Action Buttons -->
                                                                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                                                                    <Button Style="{StaticResource ActionDarkButton}" Content="ใช้ล็อกอินจากสตูดิโอหลัก" Command="{Binding CloneSessionFromDefaultCommand}" Margin="0,0,6,0" Padding="10,5" />
                                                                                    <Button Style="{StaticResource ActionDarkButton}" Content="เปิดสตูดิโอ" Command="{Binding OpenStudioForLoginCommand}" Visibility="{Binding LoggedInVisibility}" Margin="0,0,6,0" Padding="10,5" />
                                                                                    <Button Style="{StaticResource PrimaryCtaButton}" Content="เปิดสตูดิโอเพื่อล็อกอิน" Command="{Binding OpenStudioForLoginCommand}" Visibility="{Binding NotLoggedInVisibility}" Margin="0,0,6,0" Padding="12,5" />
                                                                                    <Button Style="{StaticResource ActionDarkButton}" Content="รีเฟรชสถานะ" Command="{Binding RefreshProfileCommand}" Padding="10,5" />
                                                                                </StackPanel>

                                                                                <!-- Left Session Status & UID Chip -->
                                                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                                    <Grid Margin="0,0,12,0" VerticalAlignment="Center">
                                                                                        <Border Width="44" Height="44" CornerRadius="22" Visibility="{Binding AvatarVisibility}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1.5" RenderOptions.BitmapScalingMode="HighQuality">
                                                                                            <Border.Background>
                                                                                                <ImageBrush ImageSource="{Binding AvatarImageSource}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" />
                                                                                            </Border.Background>
                                                                                        </Border>
                                                                                        <Border Width="44" Height="44" CornerRadius="22" Background="{DynamicResource Surface3Brush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1.5" Visibility="{Binding FallbackAvatarVisibility}">
                                                                                            <ui:SymbolIcon Symbol="Person20" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}" />
                                                                                        </Border>
                                                                                    </Grid>

                                                                                    <StackPanel VerticalAlignment="Center" Visibility="{Binding LoggedInVisibility}">
                                                                                        <StackPanel Orientation="Horizontal">
                                                                                            <TextBlock Text="{Binding LoggedInNickname}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource FgBrush}" VerticalAlignment="Center" />
                                                                                            <TextBlock Text="{Binding StreamerHandle}" FontSize="12" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="8,0,0,0" />
                                                                                            <Border Background="{DynamicResource OkSoftBrush}" CornerRadius="4" Padding="6,1" VerticalAlignment="Center" Margin="10,0,0,0">
                                                                                                <TextBlock Text="ล็อกอินแล้ว" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource OkBrush}" />
                                                                                            </Border>
                                                                                        </StackPanel>
                                                                                        <TextBlock Text="{Binding LoggedInUserId, StringFormat='UID {0}'}" FontSize="11" FontFamily="{StaticResource MonoFont}" Foreground="{DynamicResource SubtleBrush}" Margin="0,2,0,0" />
                                                                                    </StackPanel>

                                                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Visibility="{Binding NotLoggedInVisibility}">
                                                                                        <TextBlock Text="ยังไม่ได้ล็อกอิน" FontSize="12" Foreground="{DynamicResource SubtleBrush}" VerticalAlignment="Center" />
                                                                                    </StackPanel>
                                                                                </StackPanel>
                                                                            </DockPanel>
                                                                        </Border>

                                                                        <!-- Per-Instance Native Proxy Section (No Proxifier Required) -->
                                                                        <Border Grid.Row="1" Background="{DynamicResource Surface2Brush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,10,0,0">
                                                                            <StackPanel>
                                                                                <DockPanel LastChildFill="False" Margin="0,0,0,8">
                                                                                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                                                                                        <ui:SymbolIcon Symbol="Globe20" Foreground="{DynamicResource PrimaryBrush}" Margin="0,0,7,0" VerticalAlignment="Center" />
                                                                                        <TextBlock Text="Proxy ของบัญชีนี้" FontWeight="SemiBold" FontSize="11.5" Foreground="{DynamicResource FgBrush}" VerticalAlignment="Center" Margin="0,0,12,0" />
                                                                                        <CheckBox Content="ใช้ Proxy" IsChecked="{Binding InstanceUseCustomProxy, Mode=TwoWay}" FontSize="11" Foreground="{DynamicResource FgBrush}" VerticalAlignment="Center" />
                                                                                    </StackPanel>

                                                                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                                                                        <Button Style="{StaticResource ActionDarkButton}" Content="{Binding TestInstanceProxyButtonText}" Command="{Binding TestInstanceProxyCommand}" Padding="10,4" Margin="0,0,6,0" FontSize="11" />
                                                                                        <Button Style="{StaticResource PrimaryCtaButton}" Content="บันทึก Proxy" Command="{Binding SaveInstanceProxyConfigCommand}" Padding="12,4" FontSize="11" />
                                                                                    </StackPanel>
                                                                                </DockPanel>

                                                                                <Grid Margin="0,0,0,6">
                                                                                    <Grid.ColumnDefinitions>
                                                                                        <ColumnDefinition Width="105" />
                                                                                        <ColumnDefinition Width="8" />
                                                                                        <ColumnDefinition Width="1.4*" />
                                                                                        <ColumnDefinition Width="8" />
                                                                                        <ColumnDefinition Width="85" />
                                                                                        <ColumnDefinition Width="8" />
                                                                                        <ColumnDefinition Width="1*" />
                                                                                        <ColumnDefinition Width="8" />
                                                                                        <ColumnDefinition Width="1*" />
                                                                                    </Grid.ColumnDefinitions>

                                                                                    <StackPanel Grid.Column="0">
                                                                                        <TextBlock Text="ประเภท" FontSize="10.5" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,3" />
                                                                                        <ComboBox ItemsSource="{Binding ProxyProtocolOptions}" SelectedIndex="{Binding InstanceProxyProtocolIndex, Mode=TwoWay}" Background="{DynamicResource Surface2Brush}" Foreground="{DynamicResource FgBrush}" BorderBrush="{DynamicResource LineBrush}" Padding="8,4" FontSize="11" />
                                                                                    </StackPanel>

                                                                                    <StackPanel Grid.Column="2">
                                                                                        <TextBlock Text="ที่อยู่ (IP)" FontSize="10.5" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,3" />
                                                                                        <ui:TextBox Text="{Binding InstanceProxyHost, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="เช่น 45.142.xx.xx" Padding="8,4" FontSize="11" />
                                                                                    </StackPanel>

                                                                                    <StackPanel Grid.Column="4">
                                                                                        <TextBlock Text="พอร์ต" FontSize="10.5" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,3" />
                                                                                        <ui:TextBox Text="{Binding InstanceProxyPort, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="8080" Padding="8,4" FontSize="11" />
                                                                                    </StackPanel>

                                                                                    <StackPanel Grid.Column="6">
                                                                                        <TextBlock Text="ชื่อผู้ใช้ (ถ้ามี)" FontSize="10.5" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,3" />
                                                                                        <ui:TextBox Text="{Binding InstanceProxyUsername, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="เว้นว่างได้" Padding="8,4" FontSize="11" />
                                                                                    </StackPanel>

                                                                                    <StackPanel Grid.Column="8">
                                                                                        <TextBlock Text="รหัสผ่าน (ถ้ามี)" FontSize="10.5" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,3" />
                                                                                        <ui:TextBox Text="{Binding InstanceProxyPassword, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="เว้นว่างได้" Padding="8,4" FontSize="11" />
                                                                                    </StackPanel>
                                                                                </Grid>

                                                                                <TextBlock Text="{Binding InstanceProxyStatusText}" FontSize="11" Foreground="{DynamicResource PrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                                                            </StackPanel>
                                                                        </Border>
                                                                    </Grid>
                                                                </TabItem>

                                                                <!-- SUBTAB 1: SCRIPT CONSOLE -->

                                                                <!-- SUBTAB 2: NETWORK MONITOR -->

                                                                <!-- SUBTAB 3: CAPTCHA RADAR -->
                                                                <TabItem Header="Captcha">
                                                                    <Grid Margin="0,10,0,0">
                                                                        <Grid.RowDefinitions>
                                                                            <RowDefinition Height="Auto" />
                                                                            <RowDefinition Height="Auto" />
                                                                            <RowDefinition Height="Auto" />
                                                                            <RowDefinition Height="Auto" />
                                                                            <RowDefinition Height="Auto" />
                                                                            <RowDefinition Height="Auto" />
                                                                        </Grid.RowDefinitions>

                                                                        <Border Grid.Row="0" Visibility="{Binding NotRunningVisibility}" Background="{DynamicResource Surface3Brush}" CornerRadius="6" Padding="12,8" Margin="0,0,0,8">
                                                                            <TextBlock Text="หน้าต่างนี้ยังไม่ได้เปิดทำงาน (กดเริ่มทำงานก่อนสแกนหา Captcha)" Foreground="{DynamicResource WarnBrush}" FontSize="12" />
                                                                        </Border>

                                                                        <Border Grid.Row="1" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,8">
                                                                            <DockPanel LastChildFill="True">
                                                                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                                                                                    <Button Style="{StaticResource PrimaryCtaButton}" Content="ตรวจหาเดี๋ยวนี้" Command="{Binding ScanCaptchaNowCommand}" IsEnabled="{Binding IsRunning}" ToolTip="กดเริ่มทำงานบัญชีนี้ก่อน" ToolTipService.ShowOnDisabled="True" Margin="0,0,6,0" Padding="10,4" />
                                                                                    <Button Style="{StaticResource ActionDarkButton}" Content="ล้างผลลัพธ์" Command="{Binding ClearCaptchaResultsCommand}" Margin="0,0,10,0" />
                                                                                </StackPanel>

                                                                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                                                                                    <CheckBox Content="ตรวจหาอัตโนมัติ" IsChecked="{Binding IsCaptchaAutoDetect}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                                                                    <CheckBox Content="แก้อัตโนมัติ" IsChecked="{Binding IsAutoSolveCaptcha}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                                                                </StackPanel>
                                                                            </DockPanel>
                                                                        </Border>

                                                                        <!-- Visual Preview -->
                                                                        <Border Grid.Row="2" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,8">
                                                                            <Border.Style>
                                                                                <Style TargetType="Border">
                                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                                    <Style.Triggers>
                                                                                        <DataTrigger Binding="{Binding HasCaptchaImage}" Value="True">
                                                                                            <Setter Property="Visibility" Value="Visible" />
                                                                                        </DataTrigger>
                                                                                        <DataTrigger Binding="{Binding HasDirectImage}" Value="True">
                                                                                            <Setter Property="Visibility" Value="Visible" />
                                                                                        </DataTrigger>
                                                                                        <DataTrigger Binding="{Binding HasCroppedImage}" Value="True">
                                                                                            <Setter Property="Visibility" Value="Visible" />
                                                                                        </DataTrigger>
                                                                                        <DataTrigger Binding="{Binding IsCaptchaAlertVisible}" Value="True">
                                                                                            <Setter Property="Visibility" Value="Visible" />
                                                                                        </DataTrigger>
                                                                                    </Style.Triggers>
                                                                                </Style>
                                                                            </Border.Style>
                                                                            <Grid>
                                                                                <Grid.RowDefinitions>
                                                                                    <RowDefinition Height="Auto" />
                                                                                    <RowDefinition Height="Auto" />
                                                                                </Grid.RowDefinitions>

                                                                                <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,8">
                                                                                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                                                                                        <Border Background="{DynamicResource BadBrush}" CornerRadius="4" Padding="8,2" VerticalAlignment="Center">
                                                                                            <TextBlock Text="พบ Captcha" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource OnPrimaryBrush}" />
                                                                                        </Border>
                                                                                        <Border Background="{DynamicResource Surface3Brush}" CornerRadius="4" Padding="6,2" Margin="8,0,0,0" VerticalAlignment="Center">
                                                                                            <TextBlock Text="{Binding DetectedCaptchaTypeDescription}" FontSize="11" Foreground="{DynamicResource WarnBrush}" FontWeight="SemiBold" />
                                                                                        </Border>
                                                                                        <TextBlock Text="เวลานับถอยหลัง: " FontSize="11" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="12,0,0,0" />
                                                                                        <TextBlock Text="{Binding DetectedCaptchaCountdown, FallbackValue='00:00'}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource BadBrush}" VerticalAlignment="Center" Margin="2,0,0,0" />
                                                                                    </StackPanel>

                                                                                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                                                                                        <Button Style="{StaticResource PrimaryCtaButton}" Content="แก้ Captcha" Command="{Binding SolveCaptchaCommand}" IsEnabled="{Binding CanSolveCaptcha}" Padding="10,4" Margin="0,0,6,0" />
                                                                                        <Button Style="{StaticResource ActionDarkButton}" Content="ปิดเสียงเตือน" Command="{Binding SilenceAlertCommand}" Margin="0,0,6,0" />
                                                                                        <Button Style="{StaticResource ActionDarkButton}" Content="เปิดโฟลเดอร์" Command="{Binding OpenCaptchaImageFolderCommand}" Margin="0,0,6,0" />
                                                                                        <Button Style="{StaticResource ActionDarkButton}" Content="บันทึกภาพ" Command="{Binding SaveCaptchaImageAsCommand}" />
                                                                                    </StackPanel>
                                                                                </DockPanel>

                                                                                <Grid Grid.Row="1">
                                                                                    <Grid.ColumnDefinitions>
                                                                                        <ColumnDefinition Width="*" />
                                                                                        <ColumnDefinition Width="12" />
                                                                                        <ColumnDefinition Width="*" />
                                                                                    </Grid.ColumnDefinitions>

                                                                                    <Border Grid.Column="0" Background="{DynamicResource BgBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="6" Padding="8">
                                                                                        <Grid>
                                                                                            <Grid.RowDefinitions>
                                                                                                <RowDefinition Height="Auto" />
                                                                                                <RowDefinition Height="160" />
                                                                                            </Grid.RowDefinitions>
                                                                                            <TextBlock Grid.Row="0" Text="ภาพต้นฉบับ" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource PrimaryBrush}" Margin="0,0,0,4" />
                                                                                            <Image Grid.Row="1" Source="{Binding DirectCaptchaImageSource}" Stretch="Uniform" MaxHeight="150" />
                                                                                        </Grid>
                                                                                    </Border>

                                                                                    <Border Grid.Column="2" Background="{DynamicResource BgBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="6" Padding="8">
                                                                                        <Grid>
                                                                                            <Grid.RowDefinitions>
                                                                                                <RowDefinition Height="Auto" />
                                                                                                <RowDefinition Height="160" />
                                                                                            </Grid.RowDefinitions>
                                                                                            <TextBlock Grid.Row="0" Text="ภาพที่ตัดแล้ว" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource OkBrush}" Margin="0,0,0,4" />
                                                                                            <Image Grid.Row="1" Source="{Binding CroppedCaptchaImageSource}" Stretch="Uniform" MaxHeight="150" />
                                                                                        </Grid>
                                                                                    </Border>
                                                                                </Grid>
                                                                            </Grid>
                                                                        </Border>

                                                                        <!-- DataGrid -->


                                                                    </Grid>
                                                                </TabItem>

                                                                <!-- SUBTAB 4: LIVE CHAT MONITOR -->
                                                                <TabItem Header="แชทสด">
                                                                    <Grid Margin="0,10,0,0">
                                                                        <Grid.RowDefinitions>
                                                                            <RowDefinition Height="Auto" />
                                                                            <RowDefinition Height="Auto" />
                                                                            <RowDefinition Height="Auto" />
                                                                            <RowDefinition Height="170" />
                                                                            <RowDefinition Height="Auto" />
                                                                            <RowDefinition Height="Auto" />
                                                                            <RowDefinition Height="Auto" />
                                                                            <RowDefinition Height="Auto" />
                                                                        </Grid.RowDefinitions>

                                                                        <!-- Channel Target Configuration Bar -->
                                                                        <Border Grid.Row="0" Background="{DynamicResource Surface2Brush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,8">
                                                                            <DockPanel LastChildFill="True">
                                                                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                                                                                    <Button Style="{StaticResource PrimaryCtaButton}" Content="บันทึกช่อง" Command="{Binding SaveStreamerUsernameCommand}" Margin="0,0,6,0" Padding="12,4" />
                                                                                    <Button Style="{StaticResource ActionDarkButton}" Content="ใช้ช่องของโปรไฟล์นี้" Command="{Binding UseCurrentAccountAsChannelCommand}" ToolTip="นำ username ของโปรไฟล์นี้มาเป็นช่องตรวจจับ" Margin="0,0,6,0" />
                                                                                    <Button Style="{StaticResource ActionDarkButton}" Content="เปิดหน้าไลฟ์" Command="{Binding OpenChannelLivePageCommand}" ToolTip="เปิดหน้า TikTok Live ของช่องนี้" />
                                                                                </StackPanel>

                                                                                <Grid VerticalAlignment="Center">
                                                                                    <Grid.ColumnDefinitions>
                                                                                        <ColumnDefinition Width="Auto" />
                                                                                        <ColumnDefinition Width="*" />
                                                                                        <ColumnDefinition Width="Auto" />
                                                                                    </Grid.ColumnDefinitions>
                                                                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                                                                                        <TextBlock Text="ช่องไลฟ์ที่ต้องการดู:" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource FgBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                                                                        <Border Background="{DynamicResource Surface2Brush}" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                                                                            <TextBlock Text="{Binding ActiveChannelDisplay}" FontSize="11" Foreground="{DynamicResource PrimaryBrush}" FontWeight="Medium" />
                                                                                        </Border>
                                                                                    </StackPanel>
                                                                                    <ui:TextBox Grid.Column="1" Text="{Binding StreamerUsername, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="@ชื่อช่อง หรือลิงก์ห้องไลฟ์" Padding="8,4" FontSize="11" Margin="0,0,8,0" />
                                                                                    <TextBlock Grid.Column="2" Text="{Binding ChannelStatusText}" FontSize="11" Foreground="{DynamicResource OkBrush}" VerticalAlignment="Center" Margin="0,0,4,0" />
                                                                                </Grid>
                                                                            </DockPanel>
                                                                        </Border>

                                                                        <!-- Top Toolbar -->
                                                                        <Border Grid.Row="1" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,8">
                                                                            <DockPanel LastChildFill="True">
                                                                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                                                                                    <Button Style="{StaticResource PrimaryCtaButton}" Content="{Binding LiveChatMonitorButtonText}" Command="{Binding ToggleLiveChatMonitorCommand}" Margin="0,0,6,0" Padding="12,4" />
                                                                                    <Border Background="{DynamicResource Surface2Brush}" CornerRadius="4" Padding="6,2" VerticalAlignment="Center" Margin="0,0,8,0">
                                                                                        <TextBlock Text="{Binding LiveChatMonitorBadgeText}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource OkBrush}" />
                                                                                    </Border>
                                                                                    <Button Style="{StaticResource ActionDarkButton}" Content="ล้างรายการ" Command="{Binding ClearLiveChatCommand}" Margin="0,0,6,0" />
                                                                                    <Button Style="{StaticResource ActionDarkButton}" Content="คัดลอกทั้งหมด" Command="{Binding CopyAllLiveChatCommand}" Margin="0,0,6,0" />
                                                                                    <Button Style="{StaticResource ActionDarkButton}" Content="{}{ } คัดลอก JSON" Command="{Binding CopyAllLiveChatJsonCommand}" ToolTip="คัดลอกข้อความทั้งหมดเป็น JSON Array" Margin="0,0,6,0" />
                                                                                    <Button Style="{StaticResource ActionDarkButton}" Content="ส่งออก TXT" Command="{Binding ExportLiveChatCommand}" Margin="0,0,8,0" />
                                                                                </StackPanel>

                                                                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                                                                                    <CheckBox Content="ตอบแชทอัตโนมัติตามกฎ" IsChecked="{Binding IsAutoReplyEnabled}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                                                                </StackPanel>
                                                                            </DockPanel>
                                                                        </Border>

                                                                        <!-- Filter & Search Toolbar -->
                                                                        <DockPanel Grid.Row="2" Margin="0,0,0,6" LastChildFill="True">
                                                                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="10,0,0,0">
                                                                                <ui:TextBox Text="{Binding ChatSearchText, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="ค้นหาข้อความหรือชื่อผู้ส่ง" Width="180" Padding="8,4" FontSize="11" />
                                                                            </StackPanel>

                                                                            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                                <TextBlock Text="แสดง:" FontSize="11" Foreground="{DynamicResource MutedBrush}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,6,0" />
                                                                                <Button Style="{StaticResource MicroButton}" Content="ทั้งหมด" Command="{Binding SelectAllFiltersCommand}" ToolTip="เลือกแสดงทุกประเภท" Margin="0,0,8,0" />
                                                                                <CheckBox Content="{Binding FilterChatLabel}" IsChecked="{Binding FilterShowChat}" VerticalAlignment="Center" Margin="0,0,10,0" FontSize="11" />
                                                                                <CheckBox Content="{Binding FilterGiftLabel}" IsChecked="{Binding FilterShowGift}" VerticalAlignment="Center" Margin="0,0,10,0" FontSize="11" />
                                                                                <CheckBox Content="{Binding FilterLikeFollowLabel}" IsChecked="{Binding FilterShowLikeFollow}" VerticalAlignment="Center" Margin="0,0,10,0" FontSize="11" />
                                                                                <CheckBox Content="{Binding FilterAutoReplyLabel}" IsChecked="{Binding FilterShowAutoReply}" VerticalAlignment="Center" Margin="0,0,10,0" FontSize="11" />
                                                                                <CheckBox Content="{Binding FilterOtherLabel}" IsChecked="{Binding FilterShowOther}" VerticalAlignment="Center" Margin="0,0,6,0" FontSize="11" />
                                                                            </WrapPanel>
                                                                        </DockPanel>

                                                                        <!-- Live Chat Stream DataGrid -->
                                                                        <DataGrid Grid.Row="3" ItemsSource="{Binding FilteredLiveChatMessages}" SelectedItem="{Binding SelectedChatMessage}"
                                                                                  FontFamily="{StaticResource MonoFont}" FontSize="11" Margin="0,0,0,6">
                                                                            <DataGrid.Columns>
                                                                                <DataGridTextColumn Header="เวลา" Binding="{Binding FormattedTime}" Width="80" />
                                                                                <DataGridTemplateColumn Header="ประเภท" Width="100">
                                                                                    <DataGridTemplateColumn.CellTemplate>
                                                                                        <DataTemplate>
                                                                                            <Border Background="{DynamicResource Surface2Brush}" CornerRadius="3" Padding="4,1" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                                                                <TextBlock Text="{Binding TypeDisplay}" Foreground="{Binding TypeColor}" FontWeight="SemiBold" FontSize="10" />
                                                                                            </Border>
                                                                                        </DataTemplate>
                                                                                    </DataGridTemplateColumn.CellTemplate>
                                                                                </DataGridTemplateColumn>
                                                                                <DataGridTextColumn Header="ผู้ส่ง" Binding="{Binding SenderDisplay}" Width="210" FontWeight="SemiBold" />
                                                                                <DataGridTextColumn Header="ข้อความ / ของขวัญ" Binding="{Binding Message}" Width="*" />
                                                                                <DataGridTextColumn Header="บอทตอบกลับ" Binding="{Binding AutoReplyDisplay}" Width="160" Foreground="{DynamicResource PrimaryBrush}" />
                                                                                <DataGridTemplateColumn Header="จัดการ" Width="165">
                                                                                    <DataGridTemplateColumn.CellTemplate>
                                                                                        <DataTemplate>
                                                                                            <StackPanel Orientation="Horizontal">
                                                                                                <Button Style="{StaticResource MicroButton}" Content="ตอบกลับ" 
                                                                                                        Command="{Binding DataContext.ReplyToChatMessageCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" 
                                                                                                        CommandParameter="{Binding}" Margin="0,0,4,0" />
                                                                                                <Button Style="{StaticResource MicroButton}" Content="คัดลอก" 
                                                                                                        Command="{Binding DataContext.CopySelectedChatMessageCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" 
                                                                                                        CommandParameter="{Binding}" Margin="0,0,4,0" />
                                                                                            </StackPanel>
                                                                                        </DataTemplate>
                                                                                    </DataGridTemplateColumn.CellTemplate>
                                                                                </DataGridTemplateColumn>
                                                                            </DataGrid.Columns>
                                                                        </DataGrid>

                                                                        <!-- Raw JSON Inspector Drawer -->

                                                                        <!-- 5-Mode Auto-Reply & Comment Studio (ส่งทันที | วนส่ง | กฎคำ | ทักทาย | AI ตอบ) -->
                                                                        <Border Grid.Row="5" Grid.RowSpan="2" Background="{DynamicResource BgBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,6">
                                                                            <Grid>
                                                                                <Grid.RowDefinitions>
                                                                                    <RowDefinition Height="Auto" />
                                                                                    <RowDefinition Height="Auto" />
                                                                                </Grid.RowDefinitions>

                                                                                <!-- Studio Header + Save Button -->
                                                                                <DockPanel Grid.Row="0" Margin="0,0,0,6" LastChildFill="True">
                                                                                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                                                                                        <TextBlock Text="{Binding AutoReplyStudioStatusText}" FontSize="10" Foreground="{DynamicResource OkBrush}" VerticalAlignment="Center" Margin="0,0,8,0" MaxWidth="320" TextTrimming="CharacterEllipsis" />
                                                                                        <Button Style="{StaticResource PrimaryCtaButton}" Content="บันทึกตั้งค่าตอบกลับ" Command="{Binding SaveAutoReplyStudioConfigCommand}" Padding="10,3" FontSize="11" />
                                                                                    </StackPanel>
                                                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                                        <TextBlock Text="ตอบแชทอัตโนมัติ" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource FgBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                                                                        <Border Background="{DynamicResource PrimarySoftBrush}" CornerRadius="4" Padding="6,1" VerticalAlignment="Center">
                                                                                            <TextBlock Text="เลือกแท็บด้านล่างเพื่อตั้งวิธีตอบ" FontSize="9" Foreground="{DynamicResource PrimaryBrush}" FontWeight="SemiBold" />
                                                                                        </Border>
                                                                                    </StackPanel>
                                                                                </DockPanel>

                                                                                <!-- 5-Tab Studio Control -->
                                                                                <TabControl Grid.Row="1" SelectedIndex="{Binding SelectedAutoReplySubTabIndex}" Background="Transparent" BorderThickness="0" Padding="0,6,0,0">
                                                                                    <!-- MODE 1: ส่งทันที (Quick Send & Character Counter) -->
                                                                                    <TabItem Header="1. ส่งทันที">
                                                                                        <StackPanel Margin="0,4,0,0">
                                                                                            <DockPanel Margin="0,0,0,6">
                                                                                                <TextBlock Text="เทมเพลตส่งด่วน:" FontSize="10" Foreground="{DynamicResource SubtleBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                                                                                <WrapPanel Orientation="Horizontal">
                                                                                                    <Button Style="{StaticResource MicroButton}" Content="ขอบคุณสำหรับการติดตาม 🙏" Command="{Binding SendQuickTemplateCommand}" CommandParameter="ขอบคุณสำหรับการติดตาม 🙏" Margin="0,0,4,2" />
                                                                                                    <Button Style="{StaticResource MicroButton}" Content="ยินดีต้อนรับสู่ไลฟ์สตรีม ✨" Command="{Binding SendQuickTemplateCommand}" CommandParameter="ยินดีต้อนรับสู่ไลฟ์สตรีม ✨" Margin="0,0,4,2" />
                                                                                                    <Button Style="{StaticResource MicroButton}" Content="ขอบคุณสำหรับของขวัญ ❤️" Command="{Binding SendQuickTemplateCommand}" CommandParameter="ขอบคุณสำหรับของขวัญ ❤️" Margin="0,0,4,2" />
                                                                                                    <Button Style="{StaticResource MicroButton}" Content="ฝากกดไลก์กดแชร์ด้วยนะ 👍" Command="{Binding SendQuickTemplateCommand}" CommandParameter="ฝากกดไลก์กดแชร์ด้วยนะ 👍" Margin="0,0,4,2" />
                                                                                                    <Button Style="{StaticResource MicroButton}" Content="สนใจสินค้าตัวไหนถามได้เลย 🛒" Command="{Binding SendQuickTemplateCommand}" CommandParameter="สนใจสินค้าตัวไหนถามได้เลย 🛒" Margin="0,0,4,2" />
                                                                                                </WrapPanel>
                                                                                            </DockPanel>
                                                                                            <DockPanel>
                                                                                                <Button Style="{StaticResource PrimaryCtaButton}" DockPanel.Dock="Right" Content="ส่งข้อความเข้าไลฟ์" Command="{Binding SendLiveChatCommand}" Padding="14,5" />
                                                                                                <Border DockPanel.Dock="Right" Background="{DynamicResource Surface2Brush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,6,0" VerticalAlignment="Center">
                                                                                                    <TextBlock Text="{Binding TestChatMessageCounter}" FontSize="10" FontFamily="{StaticResource MonoFont}" Foreground="{DynamicResource MutedBrush}" />
                                                                                                </Border>
                                                                                                <ui:TextBox Text="{Binding TestChatMessage, UpdateSourceTrigger=PropertyChanged}" MaxLength="200" PlaceholderText="พิมพ์ข้อความคอมเมนต์สด (สูงสุด 200 ตัวอักษร)..." Margin="0,0,6,0" Padding="8,5" FontSize="11" />
                                                                                            </DockPanel>
                                                                                        </StackPanel>
                                                                                    </TabItem>

                                                                                    <!-- MODE 2: วนส่ง (Periodic Auto-Post Loop) -->
                                                                                    <TabItem Header="2. วนส่งอัตโนมัติ">
                                                                                        <Grid Margin="0,4,0,0">
                                                                                            <Grid.ColumnDefinitions>
                                                                                                <ColumnDefinition Width="*" />
                                                                                                <ColumnDefinition Width="230" />
                                                                                            </Grid.ColumnDefinitions>
                                                                                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                                                                                <DockPanel Margin="0,0,0,4">
                                                                                                    <TextBlock Text="{Binding AutoReplyLoopMessagesCountText}" FontSize="10" Foreground="{DynamicResource PrimaryBrush}" DockPanel.Dock="Right" VerticalAlignment="Center" />
                                                                                                    <TextBlock Text="รายการข้อความวนส่ง (1 บรรทัด = 1 ข้อความ):" FontSize="10" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" />
                                                                                                </DockPanel>
                                                                                                <TextBox Text="{Binding AutoReplyLoopMessagesText, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Height="74" FontSize="11" Background="{DynamicResource BgBrush}" Foreground="{DynamicResource FgBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" Padding="6,4" />
                                                                                            </StackPanel>
                                                                                            <StackPanel Grid.Column="1">
                                                                                                <CheckBox Content="เปิดใช้งานวนส่งข้อความอัตโนมัติ" IsChecked="{Binding AutoReplyEnableLoopPost}" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,6" />
                                                                                                <Grid Margin="0,0,0,6">
                                                                                                    <Grid.ColumnDefinitions>
                                                                                                        <ColumnDefinition Width="Auto" />
                                                                                                        <ColumnDefinition Width="70" />
                                                                                                        <ColumnDefinition Width="*" />
                                                                                                    </Grid.ColumnDefinitions>
                                                                                                    <TextBlock Grid.Column="0" Text="ส่งทุกๆ (วินาที):" FontSize="10" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                                                                                    <ui:TextBox Grid.Column="1" Text="{Binding AutoReplyLoopIntervalSeconds, UpdateSourceTrigger=PropertyChanged}" Padding="6,2" FontSize="11" Margin="0,0,8,0" />
                                                                                                    <CheckBox Grid.Column="2" Content="สุ่มลำดับ" IsChecked="{Binding AutoReplyLoopRandomOrder}" FontSize="10" VerticalAlignment="Center" />
                                                                                                </Grid>
                                                                                                <DockPanel>
                                                                                                    <Button Style="{StaticResource ActionDarkButton}" DockPanel.Dock="Right" Content="ส่งรอบนี้ทันที" Command="{Binding TriggerLoopPostNowCommand}" Padding="8,3" FontSize="10" />
                                                                                                    <TextBlock Text="{Binding AutoReplyLoopStatusText}" FontSize="10" Foreground="{DynamicResource WarnBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,6,0" />
                                                                                                </DockPanel>
                                                                                            </StackPanel>
                                                                                        </Grid>
                                                                                    </TabItem>

                                                                                    <!-- MODE 3: กฎคำ (Shorthand Keyword Rules + Anti-Spam / Anti-Ban) -->
                                                                                    <TabItem Header="3. ตอบตามคำ">
                                                                                        <Grid Margin="0,4,0,0">
                                                                                            <Grid.ColumnDefinitions>
                                                                                                <ColumnDefinition Width="*" />
                                                                                                <ColumnDefinition Width="280" />
                                                                                            </Grid.ColumnDefinitions>
                                                                                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                                                                                <DockPanel Margin="0,0,0,4">
                                                                                                    <TextBlock Text="{Binding ParsedKeywordRulesSummary}" FontSize="10" Foreground="{DynamicResource OkBrush}" DockPanel.Dock="Right" VerticalAlignment="Center" />
                                                                                                    <TextBlock Text="รูปแบบย่อ: คำค้น1, คำค้น2 = คำตอบ1 | คำตอบ2 (ใช้ {user} แทนชื่อผู้ชมได้)" FontSize="10" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" />
                                                                                                </DockPanel>
                                                                                                <TextBox Text="{Binding AutoReplyKeywordRulesText, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Height="74" FontFamily="{StaticResource MonoFont}" FontSize="11" Background="{DynamicResource BgBrush}" Foreground="{DynamicResource FgBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" Padding="6,4" />
                                                                                            </StackPanel>
                                                                                            <StackPanel Grid.Column="1">
                                                                                                <DockPanel Margin="0,0,0,4">
                                                                                                    <CheckBox Content="ใส่ @ชื่อผู้ชม นำหน้า" IsChecked="{Binding AutoReplyRulePrefixWithMention}" FontSize="10" DockPanel.Dock="Right" VerticalAlignment="Center" />
                                                                                                    <CheckBox Content="เปิดใช้กฎคำตอบกลับ" IsChecked="{Binding AutoReplyEnableKeywordRules}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                                                                </DockPanel>
                                                                                                <Border Background="{DynamicResource Surface2Brush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="4" Padding="6,4">
                                                                                                    <StackPanel>
                                                                                                        <TextBlock Text="จำกัดความถี่ในการตอบ" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource WarnBrush}" Margin="0,0,0,4" />
                                                                                                        <Grid>
                                                                                                            <Grid.ColumnDefinitions>
                                                                                                                <ColumnDefinition Width="*" />
                                                                                                                <ColumnDefinition Width="*" />
                                                                                                                <ColumnDefinition Width="*" />
                                                                                                            </Grid.ColumnDefinitions>
                                                                                                            <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                                                                                                <TextBlock Text="เว้นระยะ (วิ)" FontSize="9" Foreground="{DynamicResource MutedBrush}" />
                                                                                                                <ui:TextBox Text="{Binding AutoReplyRuleMinIntervalSeconds, UpdateSourceTrigger=PropertyChanged}" Padding="4,2" FontSize="10" />
                                                                                                            </StackPanel>
                                                                                                            <StackPanel Grid.Column="1" Margin="2,0">
                                                                                                                <TextBlock Text="คูลดาวน์คนเดิม (วิ)" FontSize="9" Foreground="{DynamicResource MutedBrush}" />
                                                                                                                <ui:TextBox Text="{Binding AutoReplyRuleUserCooldownSeconds, UpdateSourceTrigger=PropertyChanged}" Padding="4,2" FontSize="10" />
                                                                                                            </StackPanel>
                                                                                                            <StackPanel Grid.Column="2" Margin="4,0,0,0">
                                                                                                                <TextBlock Text="สูงสุด/นาที" FontSize="9" Foreground="{DynamicResource MutedBrush}" />
                                                                                                                <ui:TextBox Text="{Binding AutoReplyRuleMaxRepliesPerMinute, UpdateSourceTrigger=PropertyChanged}" Padding="4,2" FontSize="10" />
                                                                                                            </StackPanel>
                                                                                                        </Grid>
                                                                                                    </StackPanel>
                                                                                                </Border>
                                                                                            </StackPanel>
                                                                                        </Grid>
                                                                                    </TabItem>

                                                                                    <!-- MODE 4: ทักทาย (Viewer Join Greeting) -->
                                                                                    <TabItem Header="4. ทักทายผู้ชม">
                                                                                        <Grid Margin="0,4,0,0">
                                                                                            <Grid.ColumnDefinitions>
                                                                                                <ColumnDefinition Width="*" />
                                                                                                <ColumnDefinition Width="260" />
                                                                                            </Grid.ColumnDefinitions>
                                                                                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                                                                                <TextBlock Text="ข้อความทักทายเมื่อมีผู้ชมเข้าห้อง (1 บรรทัด = 1 รูปแบบ, ใช้ {user} แทนชื่อผู้ชม):" FontSize="10" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,4" />
                                                                                                <TextBox Text="{Binding AutoReplyJoinGreetingMessagesText, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Height="74" FontSize="11" Background="{DynamicResource BgBrush}" Foreground="{DynamicResource FgBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" Padding="6,4" />
                                                                                            </StackPanel>
                                                                                            <StackPanel Grid.Column="1">
                                                                                                <CheckBox Content="เปิดใช้งานทักทายผู้ชมเข้าไลฟ์" IsChecked="{Binding AutoReplyEnableJoinGreeting}" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4" />
                                                                                                <Grid Margin="0,0,0,4">
                                                                                                    <Grid.ColumnDefinitions>
                                                                                                        <ColumnDefinition Width="65" />
                                                                                                        <ColumnDefinition Width="*" />
                                                                                                    </Grid.ColumnDefinitions>
                                                                                                    <TextBlock Grid.Column="0" Text="โหมดทัก:" FontSize="10" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" />
                                                                                                    <ComboBox Grid.Column="1" ItemsSource="{Binding GreetingModeOptions}" SelectedIndex="{Binding AutoReplyGreetingModeIndex}" FontSize="10" Padding="6,2" />
                                                                                                </Grid>
                                                                                                <Grid>
                                                                                                    <Grid.ColumnDefinitions>
                                                                                                        <ColumnDefinition Width="*" />
                                                                                                        <ColumnDefinition Width="75" />
                                                                                                    </Grid.ColumnDefinitions>
                                                                                                    <ComboBox Grid.Column="0" ItemsSource="{Binding GreetingFrequencyOptions}" SelectedIndex="{Binding AutoReplyGreetingFrequencyIndex}" FontSize="10" Padding="6,2" Margin="0,0,6,0" />
                                                                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                                                                        <TextBlock Text="เว้น:" FontSize="9" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,3,0" />
                                                                                                        <ui:TextBox Text="{Binding AutoReplyGreetingMinIntervalSeconds, UpdateSourceTrigger=PropertyChanged}" Width="42" Padding="4,2" FontSize="10" />
                                                                                                    </StackPanel>
                                                                                                </Grid>
                                                                                            </StackPanel>
                                                                                        </Grid>
                                                                                    </TabItem>

