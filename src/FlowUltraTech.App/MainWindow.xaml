                                                                                    <CheckBox Content="แสดงวันที่ไทย" IsChecked="{Binding OverlayShowThaiDate, Mode=TwoWay}" Foreground="{DynamicResource FgBrush}" FontSize="11" Margin="0,0,14,6" />
