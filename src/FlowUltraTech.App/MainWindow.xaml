                                                                                        <ColumnDefinition Width="*" />
                                                                                        <ColumnDefinition Width="8" />
                                                                                        <ColumnDefinition Width="78" />
                                                                                        <ColumnDefinition Width="8" />
                                                                                        <ColumnDefinition Width="78" />
                                                                                    </Grid.ColumnDefinitions>
                                                                                    <StackPanel Grid.Column="0">
                                                                                        <TextBlock Text="ข้อความบนหน้าปัด" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,4" />
                                                                                        <TextBox Text="{Binding OverlayBrandText, UpdateSourceTrigger=PropertyChanged}"
                                                                                                 Background="{DynamicResource Surface2Brush}" Foreground="{DynamicResource FgBrush}" BorderBrush="{DynamicResource LineBrush}" Padding="7,4" FontSize="11" />
                                                                                    </StackPanel>
                                                                                    <StackPanel Grid.Column="2">
                                                                                        <TextBlock Text="คำกำกับรอง" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,4" />
                                                                                        <TextBox Text="{Binding OverlaySubtitleText, UpdateSourceTrigger=PropertyChanged}"
                                                                                                 Background="{DynamicResource Surface2Brush}" Foreground="{DynamicResource FgBrush}" BorderBrush="{DynamicResource LineBrush}" Padding="7,4" FontSize="11" />
                                                                                    </StackPanel>
                                                                                    <StackPanel Grid.Column="4">
                                                                                        <TextBlock Text="สีหลัก" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,4" />
                                                                                        <TextBox Text="{Binding OverlayPrimaryColorHex, UpdateSourceTrigger=PropertyChanged}"
