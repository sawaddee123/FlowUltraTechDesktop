<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\FlowUltraTech.Core\FlowUltraTech.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2792.45" />
    <PackageReference Include="WPF-UI" Version="4.3.0" />
    <PackageReference Include="SkiaSharp" Version="3.119.1" />
  </ItemGroup>


  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Version>0.7.0</Version>
    <AssemblyVersion>0.7.0.0</AssemblyVersion>
    <FileVersion>0.7.0.0</FileVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <StartupObject>FlowUltraTech.App.Program</StartupObject>
    <IncludePackageReferencesDuringMarkupCompilation>false</IncludePackageReferencesDuringMarkupCompilation>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\app.ico" />
    <Resource Include="Assets\logo_mark_256.png" />
    <Resource Include="Assets\logo_full_512.png" />
    <Resource Include="Assets\Fonts\*.ttf" />
    <Resource Include="Assets\Logo\*.png" />
  </ItemGroup>

  <ItemGroup>
    <ApplicationDefinition Remove="App.xaml" />
    <Page Include="App.xaml" />
  </ItemGroup>

  <Target Name="FilterMvvmAnalyzers" BeforeTargets="CoreCompile">
    <ItemGroup>
      <_MvvmRoslyn412 Include="@(Analyzer)" Condition="'%(Analyzer.NuGetPackageId)' == 'CommunityToolkit.Mvvm' and $([System.String]::new('%(Analyzer.Identity)').Contains('roslyn4.12'))" />
      <Analyzer Remove="@(Analyzer)" Condition="'%(Analyzer.NuGetPackageId)' == 'CommunityToolkit.Mvvm' and '@(_MvvmRoslyn412)' != '' and !$([System.String]::new('%(Analyzer.Identity)').Contains('roslyn4.12'))" />
    </ItemGroup>
  </Target>

</Project>
