<Window x:Class="FlowUltraTech.App.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="FlowUltraTech - เข้าสู่ระบบ"
        Icon="/Assets/app.ico"
        Width="440" SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="True">

    <Window.Resources>
        <!-- Window Close Button Style (Red on hover) -->
        <Style x:Key="LoginCloseBtn" TargetType="Button">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#94A3B8" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BgBorder" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BgBorder" Property="Background" Value="#E81123" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BgBorder" Property="Background" Value="#B20F1D" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Window Minimize Button Style -->
        <Style x:Key="LoginMinBtn" TargetType="Button">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#94A3B8" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BgBorder" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BgBorder" Property="Background" Value="#2A2A2E" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BgBorder" Property="Background" Value="#1A1A1D" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Primary CTA Button -->
        <Style x:Key="LoginPrimaryBtn" TargetType="Button">
            <Setter Property="Background" Value="#2563EB" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="16,10" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#3B82F6" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#1D4ED8" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Secondary Action Button -->
        <Style x:Key="LoginSecondaryBtn" TargetType="Button">
            <Setter Property="Background" Value="#202023" />
            <Setter Property="Foreground" Value="#E2E8F0" />
            <Setter Property="BorderBrush" Value="#303036" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#2A2A2E" />
                                <Setter Property="BorderBrush" Value="#44444A" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#1A1A1D" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Margin="14" Background="#121214" BorderBrush="#27272A" BorderThickness="1" CornerRadius="16">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="28" Opacity="0.80" ShadowDepth="6" Direction="270" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" /> <!-- Header Bar -->
                <RowDefinition Height="*" />    <!-- Content Body -->
            </Grid.RowDefinitions>

            <!-- Custom Drag Header -->
            <Border Grid.Row="0" x:Name="HeaderBar" Background="Transparent" Padding="16,12,12,8" MouseLeftButtonDown="HeaderBar_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- App Shield Icon -->
                        <Image Source="/Assets/logo_mark_256.png" Width="24" Height="24" Margin="0,0,10,0" RenderOptions.BitmapScalingMode="HighQuality" />
                        <TextBlock Text="FlowUltraTech Studio" FontWeight="Bold" FontSize="13" Foreground="#E2E8F0" VerticalAlignment="Center" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Style="{StaticResource LoginMinBtn}" Click="MinButton_Click" ToolTip="ย่อหน้าต่าง" Margin="0,0,4,0">
                            <TextBlock Text="—" FontSize="11" Foreground="#94A3B8" />
                        </Button>
                        <Button Style="{StaticResource LoginCloseBtn}" Click="CloseButton_Click" ToolTip="ปิดโปรแกรม">
                            <TextBlock Text="✕" FontSize="12" Foreground="#94A3B8" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Main Body -->
            <Grid Grid.Row="1" Margin="24,4,24,20">

                <!-- STATE 1: Auto-verifying saved token overlay -->
                <StackPanel x:Name="VerifyingPanel" Visibility="Collapsed" HorizontalAlignment="Center" Margin="0,30,0,30">
                    <ProgressBar IsIndeterminate="True" Width="200" Height="4" Foreground="#38BDF8" Background="#1E293B" BorderThickness="0" Margin="0,0,0,16" />
                    <TextBlock Text="กำลังตรวจสอบใบอนุญาตใช้งาน..." FontSize="14" FontWeight="SemiBold" Foreground="#FFFFFF" HorizontalAlignment="Center" Margin="0,0,0,6" />
                    <TextBlock Text="กรุณารอสักครู่ ระบบกำลังเชื่อมต่อเซิร์ฟเวอร์กลาง" FontSize="12" Foreground="#94A3B8" HorizontalAlignment="Center" Margin="0,0,0,16" />
                    <Button Style="{StaticResource LoginSecondaryBtn}" Content="ยกเลิกและล็อกอินใหม่" Click="CancelVerifying_Click" HorizontalAlignment="Center" Padding="12,6" />
                </StackPanel>

                <!-- STATE 2: Login Form -->
                <StackPanel x:Name="LoginFormPanel">
                    <!-- Title & Subtitle -->
                    <StackPanel Margin="0,0,0,16">
                        <TextBlock Text="เข้าสู่ระบบ (Sign In)" FontSize="18" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,4" />
                        <TextBlock Text="จำเป็นต้องเข้าสู่ระบบเพื่อยืนยันสิทธิ์และปลดล็อกโควต้าการใช้งาน" FontSize="12" Foreground="#94A3B8" TextWrapping="Wrap" />
                    </StackPanel>

                    <!-- Error Banner -->
                    <Border x:Name="ErrorBanner" Background="#261014" BorderBrush="#E11D48" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,0,14" Visibility="Collapsed">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="⚠️" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock Grid.Column="1" x:Name="ErrorMessageText" Text="ชื่อผู้ใช้หรือรหัสผ่านไม่ถูกต้อง" Foreground="#FDA4AF" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <!-- Username Field -->
                    <TextBlock Text="ชื่อผู้ใช้งาน (Username)" FontSize="12" FontWeight="SemiBold" Foreground="#94A3B8" Margin="0,0,0,6" />
                    <ui:TextBox x:Name="UsernameBox" PlaceholderText="กรอกชื่อผู้ใช้..." Margin="0,0,0,12" KeyDown="Input_KeyDown" />

                    <!-- Password Field -->
                    <TextBlock Text="รหัสผ่าน (Password)" FontSize="12" FontWeight="SemiBold" Foreground="#94A3B8" Margin="0,0,0,6" />
                    <PasswordBox x:Name="PasswordBoxInput" PasswordChar="●" 
                                 Background="#18181B" Foreground="#FFFFFF" BorderBrush="#27272A" BorderThickness="1" 
                                 Padding="8,8" FontSize="13" Margin="0,0,0,14" KeyDown="Input_KeyDown" />

                    <!-- Advanced Server Settings Expander -->
                    <Expander x:Name="ServerSettingsExpander" Header="การตั้งค่าเซิร์ฟเวอร์ (ขั้นสูง)" Foreground="#64748B" FontSize="11" Margin="0,0,0,14">
                        <Border Background="#18181B" BorderBrush="#27272A" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,6,0,0">
                            <StackPanel>
                                <TextBlock Text="Server Endpoint:" Foreground="#94A3B8" FontSize="11" Margin="0,0,0,4" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ui:TextBox x:Name="ServerEndpointBox" FontSize="11" />
                                    <Button Grid.Column="1" Style="{StaticResource LoginSecondaryBtn}" Content="รีเซ็ต" Click="ResetEndpoint_Click" Margin="6,0,0,0" Padding="8,4" FontSize="11" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Expander>

                    <!-- Submit Button -->
                    <Button x:Name="LoginButton" Style="{StaticResource LoginPrimaryBtn}" Height="40" Click="LoginButton_Click" Margin="0,0,0,12">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <ProgressBar x:Name="LoginSpinner" IsIndeterminate="True" Width="14" Height="14" Foreground="#FFFFFF" Background="Transparent" BorderThickness="0" Margin="0,0,8,0" Visibility="Collapsed" />
                            <TextBlock x:Name="LoginButtonText" Text="เข้าสู่ระบบ" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <!-- HWID & Footer Note -->
                    <Border Background="#161619" BorderBrush="#202024" BorderThickness="1" CornerRadius="6" Padding="8,6" Margin="0,4,0,0">
                        <StackPanel>
                            <DockPanel>
                                <TextBlock Text="Machine HWID:" Foreground="#64748B" FontSize="10" DockPanel.Dock="Left" />
                                <TextBlock x:Name="HwidText" Text="กำลังโหลด..." Foreground="#38BDF8" FontSize="10" TextAlignment="Right" />
                            </DockPanel>
                            <TextBlock Text="* สิทธิ์การใช้งานและโควต้าจะถูกตรวจสอบและผูกกับเครื่องนี้" Foreground="#475569" FontSize="10" Margin="0,2,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
