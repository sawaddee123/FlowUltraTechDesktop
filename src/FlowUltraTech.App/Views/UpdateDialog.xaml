<Window x:Class="FlowUltraTech.App.Views.UpdateDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="อัปเดตโปรแกรม FlowUltraTech"
        Icon="/Assets/app.ico"
        Width="520" SizeToContent="Height"
        MaxHeight="560"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="{StaticResource AppFont}"
        ResizeMode="NoResize"
        ShowInTaskbar="False">

    

    <Border Margin="16" Background="{DynamicResource BgBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="16">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="32" Opacity="0.85" ShadowDepth="8" Direction="270" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" /> <!-- Custom Header -->
                <RowDefinition Height="*" />    <!-- Content Body -->
                <RowDefinition Height="Auto" /> <!-- Action Footer -->
            </Grid.RowDefinitions>

            <!-- 1. CUSTOM WINDOW HEADER (DRAGGABLE) -->
            <Border Grid.Row="0" Background="{DynamicResource Surface2Brush}" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource LineBrush}" CornerRadius="15,15,0,0"
                    Padding="16,12" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <DockPanel LastChildFill="True">
                    <!-- Close button -->
                    <Button DockPanel.Dock="Right" Style="{StaticResource WindowCloseButton}" Click="CloseButton_Click" ToolTip="ปิดหน้าต่าง">
                        <ui:SymbolIcon Symbol="Dismiss16" FontSize="12" />
                    </Button>

                    <!-- Title & Branding -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Source="{DynamicResource WordmarkImage}" Height="18" Margin="0,0,12,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" />
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="อัปเดตโปรแกรม" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource FgBrush}" />
                        </StackPanel>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- 2. CONTENT BODY -->
            <StackPanel Grid.Row="1" Margin="22,18,22,14">
                <!-- Version Migration Hero Pill -->
                <Border Background="{DynamicResource Surface2Brush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="12" Padding="16,12" Margin="0,0,0,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Current Version -->
                        <StackPanel Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="เวอร์ชันปัจจุบัน" FontSize="10" Foreground="{DynamicResource SubtleBrush}" HorizontalAlignment="Center" />
                            <Border Background="{DynamicResource Surface3Brush}" CornerRadius="6" Padding="10,3" Margin="0,4,0,0">
                                <TextBlock x:Name="CurrentVersionText" Text="v0.1.2" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource MutedBrush}" FontFamily="{StaticResource MonoFont}" />
                            </Border>
                        </StackPanel>

                        <!-- Arrow Icon -->
                        <ui:SymbolIcon Grid.Column="1" Symbol="ArrowRight24" Foreground="{DynamicResource PrimaryBrush}" FontSize="18" VerticalAlignment="Center" Margin="14,0" />

                        <!-- New Version -->
                        <StackPanel Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="เวอร์ชันใหม่ล่าสุด" FontSize="10" Foreground="{DynamicResource OkBrush}" FontWeight="SemiBold" HorizontalAlignment="Center" />
                            <Border Background="{DynamicResource OkSoftBrush}" BorderBrush="{DynamicResource OkBrush}" BorderThickness="1" CornerRadius="6" Padding="10,3" Margin="0,4,0,0">
                                <TextBlock x:Name="NewVersionText" Text="v0.1.2" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource OkBrush}" FontFamily="{StaticResource MonoFont}" />
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Mandatory Warning Banner -->
                <Border x:Name="MandatoryBanner" Background="{DynamicResource WarnSoftBrush}" BorderBrush="{DynamicResource WarnBrush}" BorderThickness="1" CornerRadius="8" Padding="12,9" Margin="0,0,0,12" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:SymbolIcon Symbol="Warning24" Foreground="{DynamicResource WarnBrush}" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="เวอร์ชันนี้จำเป็นต้องอัปเดตก่อนใช้งานต่อ" FontSize="11" Foreground="{DynamicResource WarnBrush}" FontWeight="Medium" VerticalAlignment="Center" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!-- Release Title -->
                <TextBlock x:Name="ReleaseTitleText" Text="ชื่อหัวข้ออัปเดต" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource FgBrush}" Margin="0,0,0,8" />

                <!-- Release Notes / Changelog Box -->
                <TextBlock Text="รายละเอียดการอัปเดต:" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,4" />
                <Border Background="{DynamicResource BgBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="8" Padding="12,10" MaxHeight="130">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <TextBlock x:Name="ReleaseDescriptionText" Text="รายละเอียดการแก้ไข..." FontSize="11" Foreground="{DynamicResource FgBrush}" LineHeight="18" TextWrapping="Wrap" />
                    </ScrollViewer>
                </Border>
            </StackPanel>

            <!-- 3. ACTION FOOTER -->
            <Border Grid.Row="2" Background="{DynamicResource SurfaceBrush}" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource LineBrush}" CornerRadius="0,0,15,15" Padding="20,14">
                <DockPanel LastChildFill="True">
                    <!-- Helper Text -->
                    <TextBlock x:Name="FooterHelperText" Visibility="Collapsed" DockPanel.Dock="Left" Text="ระบบจะดาวน์โหลดตัวติดตั้งเวอร์ชันใหม่อัตโนมัติ" FontSize="10" Foreground="{DynamicResource SubtleBrush}" VerticalAlignment="Center" />

                    <!-- Action Buttons -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button x:Name="CancelButton" Style="{StaticResource TopNavButton}" Content="ไว้ภายหลัง" Click="CancelButton_Click" Margin="0,0,10,0" Visibility="Visible" />
                        <Button x:Name="DownloadButton" Style="{StaticResource PrimaryCtaButton}" Click="DownloadButton_Click">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <ui:SymbolIcon Symbol="ArrowDownload24" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock Text="ดาวน์โหลดและอัปเดตทันที" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </DockPanel>
            </Border>
        </Grid>
    </Border>
</Window>
