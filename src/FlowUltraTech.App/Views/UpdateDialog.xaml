<Window x:Class="FlowUltraTech.App.Views.UpdateDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="อัปเดตระบบ TikTok LIVE Studio Sandbox"
        Icon="/Assets/app.ico"
        Width="520" SizeToContent="Height"
        MaxHeight="560"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False">

    <Window.Resources>
        <!-- Window Close Button Style (Red on hover) -->
        <Style x:Key="DialogCloseButton" TargetType="Button">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#94A3B8" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BgBorder" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BgBorder" Property="Background" Value="#E81123" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BgBorder" Property="Background" Value="#B20F1D" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Primary CTA Button -->
        <Style x:Key="DialogPrimaryCtaButton" TargetType="Button">
            <Setter Property="Background" Value="#FE2C55" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="18,8" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#E02447" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#C01B3A" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Secondary Action Button -->
        <Style x:Key="DialogActionDarkButton" TargetType="Button">
            <Setter Property="Background" Value="#202023" />
            <Setter Property="Foreground" Value="#E2E8F0" />
            <Setter Property="BorderBrush" Value="#303036" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#2A2A2E" />
                                <Setter Property="BorderBrush" Value="#44444A" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#1A1A1D" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Margin="16" Background="#121214" BorderBrush="#27272A" BorderThickness="1" CornerRadius="16">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="32" Opacity="0.85" ShadowDepth="8" Direction="270" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" /> <!-- Custom Header -->
                <RowDefinition Height="*" />    <!-- Content Body -->
                <RowDefinition Height="Auto" /> <!-- Action Footer -->
            </Grid.RowDefinitions>

            <!-- 1. CUSTOM WINDOW HEADER (DRAGGABLE) -->
            <Border Grid.Row="0" Background="#18181B" BorderThickness="0,0,0,1" BorderBrush="#27272A" CornerRadius="15,15,0,0"
                    Padding="16,12" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <DockPanel LastChildFill="True">
                    <!-- Close button -->
                    <Button DockPanel.Dock="Right" Style="{StaticResource DialogCloseButton}" Click="CloseButton_Click" ToolTip="ปิดหน้าต่าง">
                        <ui:SymbolIcon Symbol="Dismiss16" FontSize="12" />
                    </Button>

                    <!-- Title & Branding -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Source="/Assets/logo_mark_256.png" Width="26" Height="26" Margin="0,0,10,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" />
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="TikTok LIVE Studio Sandbox" FontSize="12" FontWeight="Bold" Foreground="#FFFFFF" />
                            <TextBlock Text="การแจ้งเตือนอัปเดตระบบ (Software Update)" FontSize="10" Foreground="#71717A" Margin="0,1,0,0" />
                        </StackPanel>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- 2. CONTENT BODY -->
            <StackPanel Grid.Row="1" Margin="22,18,22,14">
                <!-- Version Migration Hero Pill -->
                <Border Background="#1C1C20" BorderBrush="#2A2A30" BorderThickness="1" CornerRadius="12" Padding="16,12" Margin="0,0,0,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Current Version -->
                        <StackPanel Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="เวอร์ชันปัจจุบัน" FontSize="10" Foreground="#71717A" HorizontalAlignment="Center" />
                            <Border Background="#27272A" CornerRadius="6" Padding="10,3" Margin="0,4,0,0">
                                <TextBlock x:Name="CurrentVersionText" Text="v0.1.2" FontSize="12" FontWeight="SemiBold" Foreground="#A1A1AA" FontFamily="Consolas" />
                            </Border>
                        </StackPanel>

                        <!-- Arrow Icon -->
                        <ui:SymbolIcon Grid.Column="1" Symbol="ArrowRight24" Foreground="#FE2C55" FontSize="18" VerticalAlignment="Center" Margin="14,0" />

                        <!-- New Version -->
                        <StackPanel Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="เวอร์ชันใหม่ล่าสุด" FontSize="10" Foreground="#10B981" FontWeight="SemiBold" HorizontalAlignment="Center" />
                            <Border Background="#064E3B" BorderBrush="#059669" BorderThickness="1" CornerRadius="6" Padding="10,3" Margin="0,4,0,0">
                                <TextBlock x:Name="NewVersionText" Text="v0.1.2" FontSize="12" FontWeight="Bold" Foreground="#34D399" FontFamily="Consolas" />
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Mandatory Warning Banner -->
                <Border x:Name="MandatoryBanner" Background="#451A03" BorderBrush="#B45309" BorderThickness="1" CornerRadius="8" Padding="12,9" Margin="0,0,0,12" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:SymbolIcon Symbol="Warning24" Foreground="#F59E0B" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="การอัปเดตนี้เป็นเวอร์ชันบังคับ (Mandatory Update) เพื่อความปลอดภัยและความเสถียรของระบบ" FontSize="11" Foreground="#FDE68A" FontWeight="Medium" VerticalAlignment="Center" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!-- Release Title -->
                <TextBlock x:Name="ReleaseTitleText" Text="ชื่อหัวข้ออัปเดต" FontSize="13" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,8" />

                <!-- Release Notes / Changelog Box -->
                <TextBlock Text="รายละเอียดการอัปเดต:" FontSize="11" Foreground="#94A3B8" Margin="0,0,0,4" />
                <Border Background="#0C0C0E" BorderBrush="#1F1F23" BorderThickness="1" CornerRadius="8" Padding="12,10" MaxHeight="130">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <TextBlock x:Name="ReleaseDescriptionText" Text="รายละเอียดการแก้ไข..." FontSize="11" Foreground="#CBD5E1" LineHeight="18" TextWrapping="Wrap" />
                    </ScrollViewer>
                </Border>
            </StackPanel>

            <!-- 3. ACTION FOOTER -->
            <Border Grid.Row="2" Background="#161618" BorderThickness="0,1,0,0" BorderBrush="#242426" CornerRadius="0,0,15,15" Padding="20,14">
                <DockPanel LastChildFill="True">
                    <!-- Helper Text -->
                    <TextBlock x:Name="FooterHelperText" DockPanel.Dock="Left" Text="ระบบจะดาวน์โหลดตัวติดตั้งเวอร์ชันใหม่อัตโนมัติ" FontSize="10" Foreground="#52525B" VerticalAlignment="Center" />

                    <!-- Action Buttons -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button x:Name="CancelButton" Style="{StaticResource DialogActionDarkButton}" Content="ไว้ภายหลัง" Click="CancelButton_Click" Margin="0,0,10,0" Visibility="Visible" />
                        <Button x:Name="DownloadButton" Style="{StaticResource DialogPrimaryCtaButton}" Click="DownloadButton_Click">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <ui:SymbolIcon Symbol="ArrowDownload24" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock Text="ดาวน์โหลดและอัปเดตทันที" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </DockPanel>
            </Border>
        </Grid>
    </Border>
</Window>
