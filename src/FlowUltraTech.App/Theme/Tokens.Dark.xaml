<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- โทเคนสี Dark แปลงจาก OKLCH ใน ui-mock/src/styles.css (Graphite + Teal) -->
    <Color x:Key="BgColor">#0C0F11</Color>
    <SolidColorBrush x:Key="BgBrush" Color="{StaticResource BgColor}" />
    <Color x:Key="SurfaceColor">#161B1F</Color>
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
    <Color x:Key="Surface2Color">#1E2429</Color>
    <SolidColorBrush x:Key="Surface2Brush" Color="{StaticResource Surface2Color}" />
    <Color x:Key="Surface3Color">#283036</Color>
    <SolidColorBrush x:Key="Surface3Brush" Color="{StaticResource Surface3Color}" />
    <Color x:Key="LineColor">#2F3A41</Color>
    <SolidColorBrush x:Key="LineBrush" Color="{StaticResource LineColor}" />
    <Color x:Key="FgColor">#E8EDEF</Color>
    <SolidColorBrush x:Key="FgBrush" Color="{StaticResource FgColor}" />
    <Color x:Key="MutedColor">#AAB5BB</Color>
    <SolidColorBrush x:Key="MutedBrush" Color="{StaticResource MutedColor}" />
    <Color x:Key="SubtleColor">#8E9AA1</Color>
    <SolidColorBrush x:Key="SubtleBrush" Color="{StaticResource SubtleColor}" />
    <Color x:Key="PrimaryColor">#2DD4BF</Color>
    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}" />
    <Color x:Key="PrimaryStrongColor">#5EEAD4</Color>
    <SolidColorBrush x:Key="PrimaryStrongBrush" Color="{StaticResource PrimaryStrongColor}" />
    <Color x:Key="PrimarySoftColor">#292DD4BF</Color>
    <SolidColorBrush x:Key="PrimarySoftBrush" Color="{StaticResource PrimarySoftColor}" />
    <Color x:Key="OnPrimaryColor">#04201C</Color>
    <SolidColorBrush x:Key="OnPrimaryBrush" Color="{StaticResource OnPrimaryColor}" />
    <Color x:Key="OkColor">#5BD68A</Color>
    <SolidColorBrush x:Key="OkBrush" Color="{StaticResource OkColor}" />
    <Color x:Key="OkSoftColor">#265BD68A</Color>
    <SolidColorBrush x:Key="OkSoftBrush" Color="{StaticResource OkSoftColor}" />
    <Color x:Key="WarnColor">#F5B94A</Color>
    <SolidColorBrush x:Key="WarnBrush" Color="{StaticResource WarnColor}" />
    <Color x:Key="WarnSoftColor">#26F5B94A</Color>
    <SolidColorBrush x:Key="WarnSoftBrush" Color="{StaticResource WarnSoftColor}" />
    <Color x:Key="BadColor">#FF7A7A</Color>
    <SolidColorBrush x:Key="BadBrush" Color="{StaticResource BadColor}" />
    <Color x:Key="BadSoftColor">#29FF7A7A</Color>
    <SolidColorBrush x:Key="BadSoftBrush" Color="{StaticResource BadSoftColor}" />
    <Color x:Key="ControlLineColor">#7C8D96</Color>
    <SolidColorBrush x:Key="ControlLineBrush" Color="{StaticResource ControlLineColor}" />
    <Color x:Key="ScrimColor">#99050708</Color>
    <SolidColorBrush x:Key="ScrimBrush" Color="{StaticResource ScrimColor}" />

    <!-- สะพานไปยังคีย์ของ WPF-UI เพื่อให้คอนโทรลสำเร็จรูป (TextBox, ComboBox, CheckBox ฯลฯ) ใช้สีเดียวกัน -->
    <SolidColorBrush x:Key="ApplicationBackgroundBrush" Color="{StaticResource BgColor}" />
    <SolidColorBrush x:Key="SolidBackgroundFillColorBaseBrush" Color="{StaticResource BgColor}" />
    <SolidColorBrush x:Key="SolidBackgroundFillColorSecondaryBrush" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="CardBackgroundFillColorSecondaryBrush" Color="{StaticResource Surface2Color}" />
    <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="{StaticResource LineColor}" />
    <SolidColorBrush x:Key="ControlFillColorDefaultBrush" Color="{StaticResource Surface2Color}" />
    <SolidColorBrush x:Key="ControlFillColorSecondaryBrush" Color="{StaticResource Surface3Color}" />
    <SolidColorBrush x:Key="ControlFillColorTertiaryBrush" Color="{StaticResource Surface2Color}" />
    <SolidColorBrush x:Key="ControlFillColorInputActiveBrush" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="ControlSolidFillColorDefaultBrush" Color="{StaticResource Surface2Color}" />
    <SolidColorBrush x:Key="ControlAltFillColorSecondaryBrush" Color="{StaticResource Surface2Color}" />
    <SolidColorBrush x:Key="ControlAltFillColorTertiaryBrush" Color="{StaticResource Surface3Color}" />
    <SolidColorBrush x:Key="ControlAltFillColorQuarternaryBrush" Color="{StaticResource Surface3Color}" />
    <SolidColorBrush x:Key="ControlStrokeColorDefaultBrush" Color="{StaticResource ControlLineColor}" />
    <SolidColorBrush x:Key="ControlStrokeColorSecondaryBrush" Color="{StaticResource LineColor}" />
    <SolidColorBrush x:Key="ControlStrongStrokeColorDefaultBrush" Color="{StaticResource SubtleColor}" />
    <SolidColorBrush x:Key="ControlStrongFillColorDefaultBrush" Color="{StaticResource MutedColor}" />
    <SolidColorBrush x:Key="ControlStrongFillColorDisabledBrush" Color="{StaticResource SubtleColor}" />
    <SolidColorBrush x:Key="SubtleFillColorSecondaryBrush" Color="{StaticResource Surface3Color}" />
    <SolidColorBrush x:Key="SubtleFillColorTertiaryBrush" Color="{StaticResource Surface2Color}" />
    <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="{StaticResource FgColor}" />
    <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="{StaticResource MutedColor}" />
    <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="{StaticResource SubtleColor}" />
    <SolidColorBrush x:Key="TextFillColorDisabledBrush" Color="{StaticResource SubtleColor}" />
    <SolidColorBrush x:Key="TextPlaceholderColorBrush" Color="{StaticResource SubtleColor}" />
    <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="{StaticResource OnPrimaryColor}" />
    <SolidColorBrush x:Key="TextOnAccentFillColorSecondaryBrush" Color="{StaticResource OnPrimaryColor}" />
    <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="{StaticResource PrimaryColor}" />
    <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="{StaticResource PrimaryStrongColor}" />
    <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="{StaticResource PrimaryStrongColor}" />
    <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="{StaticResource PrimaryColor}" />
    <SolidColorBrush x:Key="AccentTextFillColorSecondaryBrush" Color="{StaticResource PrimaryColor}" />
    <SolidColorBrush x:Key="AccentTextFillColorTertiaryBrush" Color="{StaticResource PrimaryColor}" />
    <SolidColorBrush x:Key="SystemAccentColorPrimaryBrush" Color="{StaticResource PrimaryColor}" />
    <SolidColorBrush x:Key="SystemAccentColorSecondaryBrush" Color="{StaticResource PrimaryColor}" />
    <SolidColorBrush x:Key="SystemAccentColorTertiaryBrush" Color="{StaticResource PrimaryColor}" />
    <SolidColorBrush x:Key="TextControlBackground" Color="{StaticResource Surface2Color}" />
    <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="{StaticResource Surface3Color}" />
    <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="{StaticResource Surface2Color}" />
    <SolidColorBrush x:Key="TextControlBackgroundDisabled" Color="{StaticResource Surface2Color}" />
    <SolidColorBrush x:Key="TextControlForeground" Color="{StaticResource FgColor}" />
    <SolidColorBrush x:Key="TextControlForegroundPointerOver" Color="{StaticResource FgColor}" />
    <SolidColorBrush x:Key="TextControlForegroundFocused" Color="{StaticResource FgColor}" />
    <SolidColorBrush x:Key="TextControlForegroundDisabled" Color="{StaticResource SubtleColor}" />
    <SolidColorBrush x:Key="TextControlBorderBrush" Color="{StaticResource ControlLineColor}" />
    <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="{StaticResource SubtleColor}" />
    <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="{StaticResource PrimaryColor}" />
    <SolidColorBrush x:Key="TextControlBorderBrushDisabled" Color="{StaticResource LineColor}" />
    <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="{StaticResource SubtleColor}" />
    <SolidColorBrush x:Key="TextControlPlaceholderForegroundPointerOver" Color="{StaticResource SubtleColor}" />
    <SolidColorBrush x:Key="TextControlPlaceholderForegroundFocused" Color="{StaticResource SubtleColor}" />
    <BitmapImage x:Key="WordmarkImage" UriSource="pack://application:,,,/Assets/Logo/02_wordmark_white_transparent.png" />
</ResourceDictionary>
