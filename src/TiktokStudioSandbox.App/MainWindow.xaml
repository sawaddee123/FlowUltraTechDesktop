<Window x:Class="TiktokStudioSandbox.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:models="clr-namespace:TiktokStudioSandbox.Core.Models;assembly=TiktokStudioSandbox.Core"
        mc:Ignorable="d"
        Title="TikTok LIVE Studio - Sandbox v0.1.0" 
        Height="820" Width="1260"
        MinHeight="700" MinWidth="1050"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        Topmost="False"
        ShowInTaskbar="True"
        Background="#121212"
        Foreground="#E2E8F0">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0"
                      ResizeBorderThickness="6"
                      CornerRadius="0"
                      GlassFrameThickness="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- Window Control Button Base Style -->
        <Style x:Key="WindowControlButton" TargetType="Button">
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="38" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#94A3B8" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BgBorder" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BgBorder" Property="Background" Value="#242424" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BgBorder" Property="Background" Value="#303030" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Window Close Button Style (Red on hover) -->
        <Style x:Key="WindowCloseButton" TargetType="Button">
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="38" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#94A3B8" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BgBorder" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BgBorder" Property="Background" Value="#E81123" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BgBorder" Property="Background" Value="#B20F1D" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 1. Custom High-Contrast ListBox & ListBoxItem (Removes default Windows electric blue selection) -->
        <Style TargetType="ListBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
        </Style>

        <Style TargetType="ListBoxItem">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ItemBorder" Background="#1A1A1A" BorderBrush="#2A2A2A" BorderThickness="1.5" CornerRadius="8" Padding="12,10">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#222222" />
                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#3D3D3D" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#242424" />
                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#FE2C55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 2. High-Contrast DataGrid Styles -->
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="#161616" />
            <Setter Property="BorderBrush" Value="#282828" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="RowBackground" Value="#161616" />
            <Setter Property="AlternatingRowBackground" Value="#1A1A1A" />
            <Setter Property="Foreground" Value="#E2E8F0" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="HorizontalGridLinesBrush" Value="#262626" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="RowHeight" Value="34" />
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="SelectionMode" Value="Single" />
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#202020" />
            <Setter Property="Foreground" Value="#94A3B8" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="BorderBrush" Value="#282828" />
            <Setter Property="BorderThickness" Value="0,0,1,1" />
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="{TemplateBinding Background}" BorderThickness="0" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#262626" />
                    <Setter Property="Foreground" Value="#FFFFFF" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 3. Unified Dark Button Styles -->
        <Style x:Key="TopNavButton" TargetType="Button">
            <Setter Property="Background" Value="#222222" />
            <Setter Property="Foreground" Value="#E2E8F0" />
            <Setter Property="BorderBrush" Value="#333333" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#2A2A2A" />
                                <Setter Property="BorderBrush" Value="#444444" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#1A1A1A" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryCtaButton" TargetType="Button">
            <Setter Property="Background" Value="#FE2C55" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="14,6" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#E02447" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#C01B3A" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ActionDarkButton" TargetType="Button">
            <Setter Property="Background" Value="#202020" />
            <Setter Property="Foreground" Value="#E2E8F0" />
            <Setter Property="BorderBrush" Value="#303030" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#2A2A2A" />
                                <Setter Property="BorderBrush" Value="#444444" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MicroButton" TargetType="Button">
            <Setter Property="Background" Value="#1E1E1E" />
            <Setter Property="Foreground" Value="#CBD5E1" />
            <Setter Property="BorderBrush" Value="#2E2E2E" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#282828" />
                                <Setter Property="BorderBrush" Value="#404040" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    
    <Border x:Name="RootBorder" Background="#121212" BorderBrush="#262626" BorderThickness="1">
        <Grid Background="#121212">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 1. CUSTOM WINDOW HEADER & TITLE BAR (DRAGGABLE) -->
            <Border Grid.Row="0" Background="#161616" BorderThickness="0,0,0,1" BorderBrush="#242424" 
                    MouseLeftButtonDown="Header_MouseLeftButtonDown"
                    MouseMove="Header_MouseMove"
                    MouseLeftButtonUp="Header_MouseLeftButtonUp"
                    MouseLeave="Header_MouseLeave">
                <DockPanel LastChildFill="True">
                    
                    <!-- Right: Utility Buttons + Window Controls -->
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Stretch">
                        <!-- Utility Quick Action Buttons -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                            <Button Style="{StaticResource ActionDarkButton}" Command="{Binding OpenCaptchaFolderCommand}" Margin="0,0,6,0" Padding="10,4">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <ui:SymbolIcon Symbol="Folder16" Foreground="#94A3B8" Margin="0,0,6,0" />
                                    <TextBlock Text="โฟลเดอร์ Captcha" FontSize="11" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <Button Style="{StaticResource ActionDarkButton}" Command="{Binding OpenLogsFolderCommand}" Padding="10,4">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <ui:SymbolIcon Symbol="DocumentBulletList16" Foreground="#94A3B8" Margin="0,0,6,0" />
                                    <TextBlock Text="โฟลเดอร์ Log" FontSize="11" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <!-- Subtle Separator -->
                        <Rectangle Width="1" Height="18" Fill="#282828" VerticalAlignment="Center" Margin="2,0,6,0" />

                        <!-- Window Control Buttons -->
                        <Button Style="{StaticResource WindowControlButton}" Click="MinimizeWindow_Click" ToolTip="ย่อหน้าต่าง (Minimize)">
                            <ui:SymbolIcon Symbol="Subtract16" FontSize="12" />
                        </Button>
                        <Button x:Name="MaximizeButton" Style="{StaticResource WindowControlButton}" Click="MaximizeWindow_Click" ToolTip="ขยายเต็มจอ (Maximize)">
                            <ui:SymbolIcon x:Name="MaximizeIcon" Symbol="Maximize16" FontSize="12" />
                        </Button>
                        <Button Style="{StaticResource WindowCloseButton}" Click="CloseWindow_Click" ToolTip="ปิดโปรแกรม (Close)">
                            <ui:SymbolIcon Symbol="Dismiss16" FontSize="12" />
                        </Button>
                    </StackPanel>

                    <!-- Left: App Branding, Title & Live Status -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,6,0,6">
                        <!-- Brand Icon -->
                        <Border Width="26" Height="26" CornerRadius="6" Background="#FE2C55" Margin="0,0,10,0" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="Play24" Foreground="White" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>

                        <!-- Title & Version -->
                        <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="TikTok LIVE Studio" FontSize="13" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center" />
                                <Border Background="#222222" CornerRadius="4" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="Sandbox v0.1.0" FontSize="10" FontWeight="SemiBold" Foreground="#94A3B8" />
                                </Border>
                            </StackPanel>
                        </StackPanel>

                        <!-- Live Running Indicator -->
                        <Border CornerRadius="12" Padding="8,2" VerticalAlignment="Center" Background="#1E1E1E" BorderBrush="#2C2C2C" BorderThickness="1">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="สแตนด์บาย" />
                                            <Setter Property="Foreground" Value="#94A3B8" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasAnyCaptchaAlert}" Value="True">
                                                    <Setter Property="Text" Value="{Binding TotalCaptchaAlertCount, StringFormat='พบ Captcha ({0})'}" />
                                                    <Setter Property="Foreground" Value="#EF4444" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="{Binding RunningStatusSummary, StringFormat=' • {0}'}" FontSize="11" FontWeight="SemiBold" Foreground="#10B981" VerticalAlignment="Center" Margin="4,0,0,0" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </DockPanel>
            </Border>

        <!-- 2. MAIN BODY: LEFT SIDEBAR + CONTENT VIEWPORT -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- LEFT SIDEBAR -->
            <Border Grid.Column="0" Background="#161616" BorderThickness="0,0,1,0" BorderBrush="#242424">
                <DockPanel LastChildFill="True">
                    <!-- Footer Box -->
                    <Border DockPanel.Dock="Bottom" Background="#1A1A1A" BorderBrush="#282828" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="8,8,8,10">
                        <StackPanel>
                            <DockPanel LastChildFill="False" Margin="0,0,0,6">
                                <TextBlock Text="CDP Core v0.1.0" DockPanel.Dock="Left" FontSize="11" FontWeight="SemiBold" Foreground="#38BDF8" />
                            </DockPanel>
                            <Button Style="{StaticResource ActionDarkButton}" Command="{Binding OpenCaptchaFolderCommand}" HorizontalAlignment="Stretch" Padding="6,4">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <ui:SymbolIcon Symbol="Folder16" Foreground="#94A3B8" Margin="0,0,6,0" />
                                    <TextBlock Text="โฟลเดอร์ Captcha" FontSize="11" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- Nav Items List -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,8,0,0">
                        <StackPanel Margin="8,0">
                            <!-- Section 1: Main Menu -->
                            <TextBlock Text="เมนูหลัก" FontSize="10" FontWeight="SemiBold" Foreground="#64748B" Margin="10,8,10,6" />

                            <!-- Nav 0: Instances -->
                            <Button Command="{Binding NavigateInstancesCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="0" Margin="0,2" Background="Transparent" BorderThickness="0" Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="NavPill" CornerRadius="6" Padding="12,9" Background="Transparent" HorizontalAlignment="Stretch">
                                            <Grid HorizontalAlignment="Stretch">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <ui:SymbolIcon x:Name="NavIcon" Grid.Column="0" Symbol="Apps24" FontSize="15" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,0,10,0" />
                                                <TextBlock x:Name="NavText" Grid.Column="1" Text="บัญชีสตูดิโอ" FontSize="12" FontWeight="Medium" Foreground="#CBD5E1" VerticalAlignment="Center" />
                                                <Border Grid.Column="2" Background="#242424" CornerRadius="8" Padding="6,1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Instances.Count}" FontSize="10" FontWeight="SemiBold" Foreground="#94A3B8" />
                                                </Border>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsNavInstances}" Value="True">
                                                <Setter TargetName="NavPill" Property="Background" Value="#242424" />
                                                <Setter TargetName="NavText" Property="Foreground" Value="#FFFFFF" />
                                                <Setter TargetName="NavText" Property="FontWeight" Value="SemiBold" />
                                                <Setter TargetName="NavIcon" Property="Foreground" Value="#FE2C55" />
                                            </DataTrigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="NavPill" Property="Background" Value="#1E1E1E" />
                                                <Setter TargetName="NavText" Property="Foreground" Value="#FFFFFF" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <!-- Nav 1: Captcha Center -->
                            <Button Command="{Binding NavigateCaptchaCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="0" Margin="0,2" Background="Transparent" BorderThickness="0" Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="NavPill" CornerRadius="6" Padding="12,9" Background="Transparent" HorizontalAlignment="Stretch">
                                            <Grid HorizontalAlignment="Stretch">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <ui:SymbolIcon x:Name="NavIcon" Grid.Column="0" Symbol="ShieldCheckmark24" FontSize="15" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,0,10,0" />
                                                <TextBlock x:Name="NavText" Grid.Column="1" Text="ตรวจจับ Captcha" FontSize="12" FontWeight="Medium" Foreground="#CBD5E1" VerticalAlignment="Center" />
                                                <Border Grid.Column="2" CornerRadius="8" Padding="6,1" VerticalAlignment="Center">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="#242424" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HasAnyCaptchaAlert}" Value="True">
                                                                    <Setter Property="Background" Value="#DC2626" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock FontSize="10" FontWeight="SemiBold">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Text" Value="{Binding TotalCaptchaAlertCount}" />
                                                                <Setter Property="Foreground" Value="#94A3B8" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding HasAnyCaptchaAlert}" Value="True">
                                                                        <Setter Property="Text" Value="{Binding TotalCaptchaAlertCount}" />
                                                                        <Setter Property="Foreground" Value="White" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Border>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsNavCaptcha}" Value="True">
                                                <Setter TargetName="NavPill" Property="Background" Value="#242424" />
                                                <Setter TargetName="NavText" Property="Foreground" Value="#FFFFFF" />
                                                <Setter TargetName="NavText" Property="FontWeight" Value="SemiBold" />
                                                <Setter TargetName="NavIcon" Property="Foreground" Value="#FE2C55" />
                                            </DataTrigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="NavPill" Property="Background" Value="#1E1E1E" />
                                                <Setter TargetName="NavText" Property="Foreground" Value="#FFFFFF" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <!-- Nav 2: Proxies & Network -->
                            <Button Command="{Binding NavigateProxiesCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="0" Margin="0,2" Background="Transparent" BorderThickness="0" Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="NavPill" CornerRadius="6" Padding="12,9" Background="Transparent" HorizontalAlignment="Stretch">
                                            <Grid HorizontalAlignment="Stretch">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <ui:SymbolIcon x:Name="NavIcon" Grid.Column="0" Symbol="Globe24" FontSize="15" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,0,10,0" />
                                                <TextBlock x:Name="NavText" Grid.Column="1" Text="Proxy เครือข่าย" FontSize="12" FontWeight="Medium" Foreground="#CBD5E1" VerticalAlignment="Center" />
                                                <Border Grid.Column="2" Background="#242424" CornerRadius="8" Padding="6,1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Proxies.Count}" FontSize="10" FontWeight="SemiBold" Foreground="#94A3B8" />
                                                </Border>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsNavProxies}" Value="True">
                                                <Setter TargetName="NavPill" Property="Background" Value="#242424" />
                                                <Setter TargetName="NavText" Property="Foreground" Value="#FFFFFF" />
                                                <Setter TargetName="NavText" Property="FontWeight" Value="SemiBold" />
                                                <Setter TargetName="NavIcon" Property="Foreground" Value="#FE2C55" />
                                            </DataTrigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="NavPill" Property="Background" Value="#1E1E1E" />
                                                <Setter TargetName="NavText" Property="Foreground" Value="#FFFFFF" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <!-- Nav 3: Auto-Reply Rules -->
                            <Button Command="{Binding NavigateRulesCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="0" Margin="0,2" Background="Transparent" BorderThickness="0" Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="NavPill" CornerRadius="6" Padding="12,9" Background="Transparent" HorizontalAlignment="Stretch">
                                            <Grid HorizontalAlignment="Stretch">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <ui:SymbolIcon x:Name="NavIcon" Grid.Column="0" Symbol="Bot24" FontSize="15" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,0,10,0" />
                                                <TextBlock x:Name="NavText" Grid.Column="1" Text="กฎตอบกลับแชท" FontSize="12" FontWeight="Medium" Foreground="#CBD5E1" VerticalAlignment="Center" />
                                                <Border Grid.Column="2" Background="#242424" CornerRadius="8" Padding="6,1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Rules.Count}" FontSize="10" FontWeight="SemiBold" Foreground="#94A3B8" />
                                                </Border>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsNavRules}" Value="True">
                                                <Setter TargetName="NavPill" Property="Background" Value="#242424" />
                                                <Setter TargetName="NavText" Property="Foreground" Value="#FFFFFF" />
                                                <Setter TargetName="NavText" Property="FontWeight" Value="SemiBold" />
                                                <Setter TargetName="NavIcon" Property="Foreground" Value="#FE2C55" />
                                            </DataTrigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="NavPill" Property="Background" Value="#1E1E1E" />
                                                <Setter TargetName="NavText" Property="Foreground" Value="#FFFFFF" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <!-- Section 2: System -->
                            <Separator Margin="8,10" Background="#242424" />
                            <TextBlock Text="ระบบ" FontSize="10" FontWeight="SemiBold" Foreground="#64748B" Margin="10,4,10,6" />

                            <!-- Nav 4: Settings -->
                            <Button Command="{Binding NavigateSettingsCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="0" Margin="0,2" Background="Transparent" BorderThickness="0" Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="NavPill" CornerRadius="6" Padding="12,9" Background="Transparent" HorizontalAlignment="Stretch">
                                            <Grid HorizontalAlignment="Stretch">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <ui:SymbolIcon x:Name="NavIcon" Grid.Column="0" Symbol="Settings24" FontSize="15" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,0,10,0" />
                                                <TextBlock x:Name="NavText" Grid.Column="1" Text="ตั้งค่าระบบ" FontSize="12" FontWeight="Medium" Foreground="#CBD5E1" VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsNavSettings}" Value="True">
                                                <Setter TargetName="NavPill" Property="Background" Value="#242424" />
                                                <Setter TargetName="NavText" Property="Foreground" Value="#FFFFFF" />
                                                <Setter TargetName="NavText" Property="FontWeight" Value="SemiBold" />
                                                <Setter TargetName="NavIcon" Property="Foreground" Value="#FE2C55" />
                                            </DataTrigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="NavPill" Property="Background" Value="#1E1E1E" />
                                                <Setter TargetName="NavText" Property="Foreground" Value="#FFFFFF" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- RIGHT CONTENT VIEWPORT -->
            <Border Grid.Column="1" Background="#121212" Padding="16,12">
                <Grid>
                    <!-- VIEW 0: INSTANCES MANAGEMENT -->
                    <Grid Visibility="{Binding IsNavInstances, Converter={StaticResource BoolToVis}}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!-- VIEW HEADER: Title (Left) + Action buttons (Right) -->
                            <Grid Grid.Row="0" Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="บัญชีสตูดิโอ" FontSize="18" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center" />
                                    <Border Background="#202020" CornerRadius="10" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Instances.Count, StringFormat='{}{0} บัญชี'}" FontSize="11" FontWeight="SemiBold" Foreground="#38BDF8" />
                                    </Border>
                                    <Border Background="#1E293B" CornerRadius="10" Padding="8,2" Margin="6,0,0,0" VerticalAlignment="Center" ToolTip="โควต้าจำนวนจอสูงสุดที่อนุญาต">
                                        <TextBlock Text="{Binding QuotaStatusSummary}" FontSize="11" FontWeight="SemiBold" Foreground="#10B981" />
                                    </Border>
                                </StackPanel>

                                <!-- Contextual Action Buttons for Instances (Pinned to Right) -->
                                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Button Style="{StaticResource TopNavButton}" Command="{Binding StartAllCommand}" Margin="0,0,6,0">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <ui:SymbolIcon Symbol="Play16" Foreground="#10B981" Margin="0,0,6,0" />
                                            <TextBlock Text="เริ่มทุกจอ" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    
                                    <Button Style="{StaticResource TopNavButton}" Command="{Binding StopAllCommand}" Margin="0,0,8,0">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <ui:SymbolIcon Symbol="Stop16" Foreground="#EF4444" Margin="0,0,6,0" />
                                            <TextBlock Text="ปิดทุกจอ" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    
                                    <Button Style="{StaticResource TopNavButton}" Command="{Binding HideAllWindowsCommand}" Margin="0,0,6,0" ToolTip="ซ่อนหน้าต่างทั้งหมดเพื่อลดภาระเครื่อง">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <ui:SymbolIcon Symbol="EyeOff16" Foreground="#94A3B8" Margin="0,0,6,0" />
                                            <TextBlock Text="ซ่อนทุกจอ" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    
                                    <Button Style="{StaticResource TopNavButton}" Command="{Binding ShowAllWindowsCommand}" Margin="0,0,8,0">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <ui:SymbolIcon Symbol="Eye16" Foreground="#94A3B8" Margin="0,0,6,0" />
                                            <TextBlock Text="แสดงทุกจอ" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>

                                    <Button Style="{StaticResource TopNavButton}" Command="{Binding ScanAllCaptchasCommand}" Margin="0,0,8,0">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <ui:SymbolIcon Symbol="ShieldCheckmark16" Foreground="#F59E0B" Margin="0,0,6,0" />
                                            <TextBlock Text="สแกน Captcha" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>

                                    <!-- Primary Focal CTA Button -->
                                    <Button Style="{StaticResource PrimaryCtaButton}" Command="{Binding AddInstanceCommand}" Padding="14,6">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <ui:SymbolIcon Symbol="Add16" Foreground="#FFFFFF" Margin="0,0,6,0" />
                                            <TextBlock Text="เพิ่มบัญชีใหม่" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>

                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding Instances}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#1A1A1A" BorderBrush="#282828" BorderThickness="1" CornerRadius="8" Margin="0,0,0,10" Padding="14,12">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>

                                                    <!-- ROW 0: CLEAN DASHBOARD ROW -->
                                                    <Grid Grid.Row="0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>

                                                        <!-- Profile Avatar -->
                                                        <Grid Grid.Column="0" Margin="0,0,12,0" VerticalAlignment="Center">
                                                            <Border Width="38" Height="38" CornerRadius="19" Visibility="{Binding AvatarVisibility}" BorderBrush="#333333" BorderThickness="1.5">
                                                                <Border.Background>
                                                                    <ImageBrush ImageSource="{Binding AvatarImageSource}" Stretch="UniformToFill" />
                                                                </Border.Background>
                                                            </Border>
                                                            <Border Width="38" Height="38" CornerRadius="19" Background="#242424" BorderBrush="#333333" BorderThickness="1.5" Visibility="{Binding FallbackAvatarVisibility}">
                                                                <ui:SymbolIcon Symbol="Person20" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#94A3B8" />
                                                            </Border>
                                                        </Grid>

                                                        <!-- Account Identity & Metadata -->
                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" Foreground="#FFFFFF" VerticalAlignment="Center" Margin="0,0,8,0" />

                                                                <Border CornerRadius="4" Padding="7,2" Margin="0,0,6,0" VerticalAlignment="Center" Background="#242424">
                                                                    <TextBlock Text="{Binding StatusDisplay}" FontSize="11" FontWeight="SemiBold" Foreground="#E2E8F0" />
                                                                </Border>

                                                                <Border Background="#2E1065" CornerRadius="4" Padding="7,2" Margin="0,0,6,0" Visibility="{Binding LoggedInVisibility}" VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding LoggedInDisplayId, StringFormat='@{0}'}" FontSize="11" FontWeight="SemiBold" Foreground="#C084FC" />
                                                                </Border>

                                                                <Border Background="#242424" CornerRadius="4" Padding="6,2" Visibility="{Binding RunningVisibility}" VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding WindowVisibilityDisplay}" FontSize="10" Foreground="#94A3B8" />
                                                                </Border>
                                                            </StackPanel>

                                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,4,0,0">
                                                                <TextBlock Text="{Binding LoggedInNickname}" FontSize="12" Foreground="#94A3B8" Visibility="{Binding LoggedInVisibility}" TextTrimming="CharacterEllipsis" MaxWidth="220" Margin="0,0,8,0" />
                                                                <TextBlock Text="ยังไม่ได้เข้าสู่ระบบ" FontSize="11" Foreground="#64748B" Visibility="{Binding NotLoggedInVisibility}" Margin="0,0,8,0" />

                                                                <TextBlock Text="•" FontSize="11" Foreground="#475569" Margin="0,0,8,0" />
                                                                <TextBlock Text="{Binding CdpPort, StringFormat='CDP: {0}'}" FontSize="11" Foreground="#94A3B8" Margin="0,0,8,0" />

                                                                <TextBlock Text="•" FontSize="11" Foreground="#475569" Margin="0,0,8,0" />
                                                                <TextBlock Text="{Binding ProfileFolderName}" FontSize="11" Foreground="#64748B" />
                                                            </StackPanel>
                                                        </StackPanel>

                                                        <!-- Action Buttons (Pinned to Right) -->
                                                        <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                            <Button Style="{StaticResource PrimaryCtaButton}" Content="เข้าสู่ระบบ" Command="{Binding OpenStudioForLoginCommand}" 
                                                                    Visibility="{Binding NotLoggedInVisibility}" IsEnabled="{Binding IsNotRunning}" 
                                                                    Margin="0,0,6,0" Padding="14,6" FontSize="12" />

                                                            <Button Style="{StaticResource PrimaryCtaButton}" Content="เริ่มทำงาน" Command="{Binding StartCommand}" 
                                                                    Visibility="{Binding LoggedInVisibility}" IsEnabled="{Binding CanStart}" ToolTip="{Binding StartButtonToolTip}"
                                                                    Margin="0,0,6,0" Padding="14,6" FontSize="12" />

                                                            <Button Style="{StaticResource ActionDarkButton}" Content="หยุด" Command="{Binding StopCommand}" 
                                                                    Visibility="{Binding RunningVisibility}" Margin="0,0,6,0" Padding="12,6" FontSize="12" Foreground="#EF4444" />

                                                            <Button Style="{StaticResource ActionDarkButton}" Command="{Binding ToggleVisibilityCommand}" 
                                                                    Visibility="{Binding RunningVisibility}" Margin="0,0,6,0" Padding="10,6" ToolTip="สลับการซ่อน/แสดงหน้าต่าง">
                                                                <ui:SymbolIcon Symbol="Eye16" Foreground="#94A3B8" />
                                                            </Button>

                                                            <Button Style="{StaticResource ActionDarkButton}" Content="{Binding DetailButtonText}" Command="{Binding ToggleDetailCommand}" 
                                                                    Margin="0,0,6,0" Padding="12,6" FontSize="12" />

                                                            <Button Style="{StaticResource ActionDarkButton}" Command="{Binding DataContext.RemoveInstanceCommand, RelativeSource={RelativeSource AncestorType=Window}}" 
                                                                    CommandParameter="{Binding}" Padding="8,6" ToolTip="ลบบัญชีนี้">
                                                                <ui:SymbolIcon Symbol="Delete16" Foreground="#94A3B8" />
                                                            </Button>
                                                        </StackPanel>
                                                    </Grid>

                                                    <!-- ROW 1: INLINE ERROR BANNER -->
                                                    <Border Grid.Row="1" Visibility="{Binding ErrorVisibility}" Background="#2B0D0D" BorderBrush="#DC2626" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,8,0,0">
                                                        <DockPanel LastChildFill="True">
                                                            <Button Style="{StaticResource MicroButton}" DockPanel.Dock="Right" Content="คัดลอก Error" Command="{Binding CopyErrorCommand}" />
                                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                <TextBlock Text="ข้อผิดพลาด: " FontWeight="Bold" FontSize="11" Foreground="#EF4444" VerticalAlignment="Center" />
                                                                <TextBlock Text="{Binding StatusMessage}" Foreground="#FCA5A5" FontSize="11" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                            </StackPanel>
                                                        </DockPanel>
                                                    </Border>

                                                    <!-- ROW 2: CAPTCHA ALERT POPUP -->
                                                    <Border Grid.Row="2" Visibility="{Binding CaptchaAlertVisibility}" Background="#2B1A00" BorderBrush="#F59E0B" BorderThickness="1.5" CornerRadius="8" Padding="12,8" Margin="0,8,0,0">
                                                        <DockPanel LastChildFill="True">
                                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                                                <Button Style="{StaticResource PrimaryCtaButton}" Content="แก้ทันที" Command="{Binding SolveCaptchaMockCommand}" IsEnabled="{Binding CanSolveCaptcha}" Padding="10,4" Margin="0,0,6,0" />
                                                                <Button Style="{StaticResource ActionDarkButton}" Content="ดูรายละเอียด" Command="{Binding OpenCaptchaTabCommand}" Margin="0,0,6,0" />
                                                                <Button Style="{StaticResource ActionDarkButton}" Content="✕" Command="{Binding DismissCaptchaAlertCommand}" Padding="8,4" />
                                                            </StackPanel>

                                                            <DockPanel LastChildFill="True" VerticalAlignment="Center" Margin="0,0,12,0">
                                                                <Border DockPanel.Dock="Left" Width="40" Height="40" CornerRadius="6" Background="#1A1A1A" BorderBrush="#F59E0B" BorderThickness="1" Margin="0,0,10,0" VerticalAlignment="Center" ClipToBounds="True">
                                                                    <Border.Style>
                                                                        <Style TargetType="Border">
                                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding HasCaptchaImage}" Value="True">
                                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Border.Style>
                                                                    <Image Source="{Binding CaptchaImageSource}" Stretch="UniformToFill" />
                                                                </Border>

                                                                <StackPanel VerticalAlignment="Center">
                                                                    <StackPanel Orientation="Horizontal">
                                                                        <TextBlock Text="ตรวจพบ CAPTCHA" FontWeight="Bold" FontSize="12" Foreground="#F59E0B" VerticalAlignment="Center" />
                                                                        <Border Background="#F59E0B" CornerRadius="4" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                                                            <TextBlock Text="{Binding DetectedCaptchaCount, StringFormat='พบ {0} จุด'}" FontSize="10" FontWeight="Bold" Foreground="Black" />
                                                                        </Border>
                                                                        <TextBlock Text="{Binding LastCaptchaDetectedTime, StringFormat='เวลา {0}'}" FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center" Margin="8,0,0,0" />
                                                                    </StackPanel>
                                                                    <TextBlock Text="{Binding CaptchaAlertMessage}" FontSize="11" Foreground="#CBD5E1" TextTrimming="CharacterEllipsis" MaxWidth="480" Margin="0,2,0,0" />
                                                                </StackPanel>
                                                            </DockPanel>
                                                        </DockPanel>
                                                    </Border>

                                                    <!-- ROW 3: DETAIL PANEL -->
                                                    <Border Grid.Row="3" Visibility="{Binding DetailVisibility}" Margin="0,10,0,0" Padding="12" Background="#141414" BorderBrush="#282828" BorderThickness="1" CornerRadius="8">
                                                        <StackPanel>
                                                            <DockPanel LastChildFill="False" Margin="0,0,0,8">
                                                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                                                                    <TextBlock Text="เครื่องมือและ CDP:" FontWeight="SemiBold" FontSize="12" Foreground="#E2E8F0" Margin="0,0,8,0" />
                                                                    <Border Background="#202020" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                                                                        <TextBlock Text="{Binding CdpPort, StringFormat='CDP: 127.0.0.1:{0}'}" FontSize="11" FontWeight="SemiBold" Foreground="#38BDF8" />
                                                                    </Border>
                                                                    <TextBlock Text="{Binding StatusMessage}" Foreground="#94A3B8" FontSize="11" MaxWidth="380" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                                </StackPanel>

                                                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                                                                    <Border Visibility="{Binding RunningVisibility}" Background="#065F46" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                                                                        <TextBlock Text="เชื่อมต่อแล้ว" FontSize="11" Foreground="#34D399" FontWeight="SemiBold" />
                                                                    </Border>
                                                                    <Button Style="{StaticResource MicroButton}" Content="คัดลอก Error" Command="{Binding CopyErrorCommand}" Visibility="{Binding ErrorVisibility}" Margin="0,0,6,0" />
                                                                </StackPanel>
                                                            </DockPanel>

                                                            <!-- Detail Subtabs -->
                                                            <TabControl SelectedIndex="{Binding SelectedDetailTabIndex}">
                                                                <!-- SUBTAB 0: LOGIN & SESSION -->
                                                                <TabItem Header="เซสชันบัญชี">
                                                                    <Grid Margin="0,10,0,0">
                                                                        <Grid.RowDefinitions>
                                                                            <RowDefinition Height="Auto" />
                                                                            <RowDefinition Height="Auto" />
                                                                            <RowDefinition Height="Auto" />
                                                                            <RowDefinition Height="Auto" />
                                                                        </Grid.RowDefinitions>

                                                                        <!-- Profile Summary -->
                                                                        <Border Grid.Row="0" Background="#181818" BorderBrush="#262626" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,10">
                                                                            <DockPanel LastChildFill="True">
                                                                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                                                                    <Button Style="{StaticResource PrimaryCtaButton}" Content="เปิดสตูดิโอเพื่อเข้าสู่ระบบ" Command="{Binding OpenStudioForLoginCommand}" Visibility="{Binding NotLoggedInVisibility}" Padding="12,5" Margin="0,0,6,0" />
                                                                                    <Button Style="{StaticResource ActionDarkButton}" Content="เปิดสตูดิโอ" Command="{Binding OpenStudioForLoginCommand}" Visibility="{Binding LoggedInVisibility}" Padding="12,5" Margin="0,0,6,0" />
                                                                                    <Button Style="{StaticResource ActionDarkButton}" Content="รีเฟรชโปรไฟล์" Command="{Binding RefreshProfileCommand}" />
                                                                                </StackPanel>

                                                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                                    <Grid Margin="0,0,12,0" VerticalAlignment="Center">
                                                                                        <Border Width="40" Height="40" CornerRadius="20" Visibility="{Binding AvatarVisibility}" BorderBrush="#333333" BorderThickness="1">
                                                                                            <Border.Background>
                                                                                                <ImageBrush ImageSource="{Binding AvatarImageSource}" Stretch="UniformToFill" />
                                                                                            </Border.Background>
                                                                                        </Border>
                                                                                        <Border Width="40" Height="40" CornerRadius="20" Background="#242424" BorderBrush="#333333" BorderThickness="1" Visibility="{Binding FallbackAvatarVisibility}">
                                                                                            <ui:SymbolIcon Symbol="Person24" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#94A3B8" />
                                                                                        </Border>
                                                                                    </Grid>

                                                                                    <StackPanel VerticalAlignment="Center">
                                                                                        <StackPanel Orientation="Horizontal">
                                                                                            <TextBlock Text="{Binding DisplayNameAndHandle}" FontSize="13" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center" Margin="0,0,8,0" />
                                                                                            <Border Background="#065F46" CornerRadius="4" Padding="6,1" Visibility="{Binding LoggedInVisibility}" VerticalAlignment="Center">
                                                                                                <TextBlock Text="ล็อกอินแล้ว" FontSize="10" FontWeight="SemiBold" Foreground="#34D399" />
                                                                                            </Border>
                                                                                            <Border Background="#242424" CornerRadius="4" Padding="6,1" Visibility="{Binding NotLoggedInVisibility}" VerticalAlignment="Center">
                                                                                                <TextBlock Text="ยังไม่เข้าสู่ระบบ" FontSize="10" Foreground="#94A3B8" />
                                                                                            </Border>
                                                                                        </StackPanel>
                                                                                        <TextBlock Text="{Binding LoggedInUserId, StringFormat='TikTok UID: {0}'}" FontSize="11" Foreground="#94A3B8" Visibility="{Binding LoggedInVisibility}" Margin="0,2,0,0" />
                                                                                        <TextBlock Text="ยังไม่พบ Session ในโปรไฟล์นี้" FontSize="11" Foreground="#64748B" Visibility="{Binding NotLoggedInVisibility}" Margin="0,2,0,0" />
                                                                                    </StackPanel>
                                                                                </StackPanel>
                                                                            </DockPanel>
                                                                        </Border>

                                                                        <!-- Session Actions -->
                                                                        <DockPanel Grid.Row="1" Margin="0,0,0,10">
                                                                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                                                                                <Button Style="{StaticResource ActionDarkButton}" Content="{Binding ModeBadgeText}" Command="{Binding SwitchModeCommand}" Margin="0,0,8,0" />
                                                                                <Button Style="{StaticResource ActionDarkButton}" Content="คัดลอก Session จากบัญชีหลัก" Command="{Binding CloneSessionFromDefaultCommand}" />
                                                                            </StackPanel>
                                                                        </DockPanel>

                                                                        <!-- Tokens Section -->
                                                                        <Border Grid.Row="2" Background="#181818" BorderBrush="#262626" BorderThickness="1" CornerRadius="6" Padding="10">
                                                                            <Grid>
                                                                                <Grid.RowDefinitions>
                                                                                    <RowDefinition Height="Auto" />
                                                                                    <RowDefinition Height="Auto" />
                                                                                </Grid.RowDefinitions>
                                                                                <DockPanel Grid.Row="0" Margin="0,0,0,8">
                                                                                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                                                                                        <Button Style="{StaticResource ActionDarkButton}" Content="ดึง Cookies &amp; Tokens" Command="{Binding FetchSessionInfoCommand}" IsEnabled="{Binding IsRunning}" Margin="0,0,8,0" />
                                                                                        <TextBlock Text="{Binding SessionFetchStatus}" VerticalAlignment="Center" Foreground="#94A3B8" FontSize="11" />
                                                                                    </StackPanel>
                                                                                </DockPanel>

                                                                                <UniformGrid Grid.Row="1" Columns="2">
                                                                                    <Border Background="#141414" BorderBrush="#242424" BorderThickness="1" CornerRadius="4" Padding="8,6" Margin="0,0,4,0">
                                                                                        <DockPanel>
                                                                                            <Button Style="{StaticResource MicroButton}" DockPanel.Dock="Right" Content="คัดลอก" Command="{Binding CopySessionIdCommand}" />
                                                                                            <StackPanel>
                                                                                                <TextBlock Text="sessionid:" FontWeight="SemiBold" FontSize="11" Foreground="#94A3B8" />
                                                                                                <TextBlock Text="{Binding SessionIdToken}" TextTrimming="CharacterEllipsis" Foreground="#38BDF8" FontSize="11" Margin="0,2,0,0" />
                                                                                            </StackPanel>
                                                                                        </DockPanel>
                                                                                    </Border>

                                                                                    <Border Background="#141414" BorderBrush="#242424" BorderThickness="1" CornerRadius="4" Padding="8,6" Margin="4,0,0,0">
                                                                                        <DockPanel>
                                                                                            <Button Style="{StaticResource MicroButton}" DockPanel.Dock="Right" Content="คัดลอก" Command="{Binding CopyCsrfTokenCommand}" />
                                                                                            <StackPanel>
                                                                                                <TextBlock Text="tt_csrf_token:" FontWeight="SemiBold" FontSize="11" Foreground="#94A3B8" />
                                                                                                <TextBlock Text="{Binding CsrfToken}" TextTrimming="CharacterEllipsis" Foreground="#38BDF8" FontSize="11" Margin="0,2,0,0" />
                                                                                            </StackPanel>
                                                                                        </DockPanel>
                                                                                    </Border>
                                                                                </UniformGrid>
                                                                            </Grid>
                                                                        </Border>

                                                                        <!-- Channel Target Section -->
                                                                        <Border Grid.Row="3" Background="#181818" BorderBrush="#262626" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,10,0,0">
                                                                            <Grid>
                                                                                <Grid.RowDefinitions>
                                                                                    <RowDefinition Height="Auto" />
                                                                                    <RowDefinition Height="Auto" />
                                                                                </Grid.RowDefinitions>
                                                                                <DockPanel Grid.Row="0" Margin="0,0,0,8">
                                                                                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                                                                                        <Button Style="{StaticResource PrimaryCtaButton}" Content="บันทึกช่อง" Command="{Binding SaveStreamerUsernameCommand}" Padding="12,4" Margin="0,0,6,0" />
                                                                                        <Button Style="{StaticResource ActionDarkButton}" Content="ใช้ช่องของโปรไฟล์นี้" Command="{Binding UseCurrentAccountAsChannelCommand}" ToolTip="ดึง Username จากบัญชีโปรไฟล์นี้ที่ล็อกอินอยู่" Margin="0,0,6,0" />
                                                                                        <Button Style="{StaticResource ActionDarkButton}" Content="เปิดหน้าไลฟ์" Command="{Binding OpenChannelLivePageCommand}" ToolTip="เปิดหน้า TikTok Live ของช่องนี้" />
                                                                                    </StackPanel>
                                                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                                        <TextBlock Text="ช่องตรวจจับเป้าหมาย (Channel Username):" FontWeight="SemiBold" FontSize="11" Foreground="#E2E8F0" VerticalAlignment="Center" Margin="0,0,8,0" />
                                                                                        <Border Background="#202020" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                                                                            <TextBlock Text="{Binding ActiveChannelDisplay}" FontSize="11" Foreground="#38BDF8" FontWeight="Medium" />
                                                                                        </Border>
                                                                                    </StackPanel>
                                                                                </DockPanel>
                                                                                <DockPanel Grid.Row="1">
                                                                                    <TextBlock Text="{Binding ChannelStatusText}" DockPanel.Dock="Right" FontSize="11" Foreground="#10B981" VerticalAlignment="Center" Margin="8,0,0,0" />
                                                                                    <ui:TextBox Text="{Binding StreamerUsername, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="ระบุ @username หรือ URL ห้องไลฟ์สดที่ต้องการตรวจจับ เช่น https://www.tiktok.com/@somchai/live" Padding="8,4" FontSize="11" />
                                                                                </DockPanel>
                                                                            </Grid>
                                                                        </Border>
                                                                    </Grid>
                                                                </TabItem>

                                                                <!-- SUBTAB 1: SCRIPT CONSOLE -->
                                                                <TabItem Header="รันสคริปต์">
                                                                    <Grid Margin="0,10,0,0">
                                                                        <Grid.RowDefinitions>
                                                                            <RowDefinition Height="Auto" />
                                                                            <RowDefinition Height="Auto" />
                                                                            <RowDefinition Height="*" />
                                                                        </Grid.RowDefinitions>

                                                                        <Border Grid.Row="0" Visibility="{Binding NotRunningVisibility}" Background="#242424" CornerRadius="6" Padding="12,8" Margin="0,0,0,8">
                                                                            <TextBlock Text="หน้าต่างนี้ยังไม่ได้เปิดทำงาน (กดเริ่มทำงานก่อนรันสคริปต์)" Foreground="#F59E0B" FontSize="12" />
                                                                        </Border>

                                                                        <Grid Grid.Row="1" Margin="0,0,0,8">
                                                                            <Grid.RowDefinitions>
                                                                                <RowDefinition Height="Auto" />
                                                                                <RowDefinition Height="Auto" />
                                                                            </Grid.RowDefinitions>

                                                                            <ui:TextBox Grid.Row="0" Text="{Binding ScriptInput, UpdateSourceTrigger=PropertyChanged}" 
                                                                                        PlaceholderText="พิมพ์โค้ด JavaScript เช่น window.location.href, document.title..." 
                                                                                        MinHeight="50" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Margin="0,0,0,8" />

                                                                            <DockPanel Grid.Row="1" LastChildFill="False">
                                                                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                                                                                    <Button Style="{StaticResource PrimaryCtaButton}" Content="รันสคริปต์" Command="{Binding ExecuteScriptCommand}" IsEnabled="{Binding IsRunning}" Margin="0,0,6,0" Padding="12,4" />
                                                                                    <Button Style="{StaticResource ActionDarkButton}" Content="ส่งออก Full HTML" Command="{Binding ExportFullHtmlCommand}" IsEnabled="{Binding IsRunning}" Margin="0,0,6,0" />
                                                                                    <Button Style="{StaticResource ActionDarkButton}" Content="ล้าง Console" Command="{Binding ClearConsoleCommand}" Margin="0,0,6,0" />
                                                                                    <Button Style="{StaticResource ActionDarkButton}" Content="คัดลอกผลลัพธ์" Command="{Binding CopyConsoleCommand}" Margin="0,0,10,0" />
                                                                                </StackPanel>

                                                                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                                                                                    <TextBlock Text="คำสั่งด่วน:" Foreground="#94A3B8" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0" />
                                                                                    <Button Style="{StaticResource MicroButton}" Content="URL" Command="{Binding SetScriptSnippetCommand}" CommandParameter="window.location.href" Margin="0,0,4,0" />
                                                                                    <Button Style="{StaticResource MicroButton}" Content="Title" Command="{Binding SetScriptSnippetCommand}" CommandParameter="document.title" Margin="0,0,4,0" />
                                                                                    <Button Style="{StaticResource MicroButton}" Content="LocalStorage" Command="{Binding SetScriptSnippetCommand}" CommandParameter="JSON.stringify(window.localStorage)" Margin="0,0,4,0" />
                                                                                    <Button Style="{StaticResource MicroButton}" Content="Full HTML" Command="{Binding SetScriptSnippetCommand}" CommandParameter="document.documentElement.outerHTML" />
                                                                                </StackPanel>
                                                                            </DockPanel>
                                                                        </Grid>

                                                                        <Border Grid.Row="2" Background="#0C0C0C" CornerRadius="6" Padding="6" BorderThickness="1" BorderBrush="#242424">
                                                                            <TextBox Text="{Binding ConsoleOutput}" IsReadOnly="True" 
                                                                                     FontFamily="Consolas" FontSize="12" 
                                                                                     Background="Transparent" Foreground="#38BDF8" 
                                                                                     BorderThickness="0" Height="130" 
                                                                                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" />
                                                                        </Border>
                                                                    </Grid>
                                                                </TabItem>

                                                                <!-- SUBTAB 2: NETWORK MONITOR -->
                                                                <TabItem Header="เน็ตเวิร์ก API">
                                                                    <Grid Margin="0,10,0,0">
                                                                        <Grid.RowDefinitions>
                                                                            <RowDefinition Height="Auto" />
                                                                            <RowDefinition Height="Auto" />
                                                                            <RowDefinition Height="180" />
                                                                            <RowDefinition Height="140" />
                                                                        </Grid.RowDefinitions>

                                                                        <Border Grid.Row="0" Visibility="{Binding NotRunningVisibility}" Background="#242424" CornerRadius="6" Padding="12,8" Margin="0,0,0,8">
                                                                            <TextBlock Text="หน้าต่างนี้ยังไม่ได้เปิดทำงาน (กดเริ่มทำงานก่อนดักจับ Network)" Foreground="#F59E0B" FontSize="12" />
                                                                        </Border>

                                                                        <DockPanel Grid.Row="1" Margin="0,0,0,8">
                                                                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                                                                                <Button Style="{StaticResource PrimaryCtaButton}" Content="{Binding NetworkHookButtonText}" Command="{Binding ToggleNetworkHookCommand}" IsEnabled="{Binding IsRunning}" Margin="0,0,6,0" Padding="12,4" />
                                                                                <Border Background="#202020" CornerRadius="4" Padding="6,2" VerticalAlignment="Center" Margin="0,0,8,0">
                                                                                    <TextBlock Text="{Binding NetworkHookBadgeText}" FontSize="11" FontWeight="SemiBold" Foreground="#10B981" />
                                                                                </Border>
                                                                                <Button Style="{StaticResource ActionDarkButton}" Content="ล้างรายการ" Command="{Binding ClearTrafficCommand}" Margin="0,0,8,0" />
                                                                                <TextBlock Text="{Binding NetworkTraffic.Count, StringFormat='ดักจับแล้ว: {0} รายการ'}" VerticalAlignment="Center" Foreground="#94A3B8" FontSize="11" Margin="0,0,12,0" />
                                                                            </StackPanel>

                                                                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                                                                                <ui:TextBox Text="{Binding NetworkSearchText, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="ค้นหาเร็ว..." Width="200" Padding="8,4" FontSize="11" />
                                                                            </StackPanel>
                                                                        </DockPanel>

                                                                        <DataGrid Grid.Row="2" ItemsSource="{Binding FilteredNetworkTraffic}" SelectedItem="{Binding SelectedTraffic}"
                                                                                  FontFamily="Consolas" FontSize="11">
                                                                            <DataGrid.Columns>
                                                                                <DataGridTextColumn Header="เวลา" Binding="{Binding FormattedTime}" Width="75" />
                                                                                <DataGridTextColumn Header="Method" Binding="{Binding Method}" Width="65" FontWeight="Bold" />
                                                                                <DataGridTextColumn Header="Status" Binding="{Binding StatusCode}" Width="60" />
                                                                                <DataGridTextColumn Header="Type" Binding="{Binding ResourceType}" Width="75" />
                                                                                <DataGridTextColumn Header="URL" Binding="{Binding Url}" Width="*" />
                                                                            </DataGrid.Columns>
                                                                        </DataGrid>

                                                                        <Border Grid.Row="3" Background="#0C0C0C" CornerRadius="6" Padding="6" BorderThickness="1" BorderBrush="#242424" Margin="0,8,0,0">
                                                                            <TextBox Text="{Binding SelectedTraffic.ResponseBody}" IsReadOnly="True" 
                                                                                     FontFamily="Consolas" FontSize="11" 
                                                                                     Background="Transparent" Foreground="#E2E8F0" 
                                                                                     BorderThickness="0" 
                                                                                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" />
                                                                        </Border>
                                                                    </Grid>
                                                                </TabItem>

                                                                <!-- SUBTAB 3: CAPTCHA RADAR -->
                                                                <TabItem Header="ตรวจจับ Captcha">
                                                                    <Grid Margin="0,10,0,0">
                                                                        <Grid.RowDefinitions>
                                                                            <RowDefinition Height="Auto" />
                                                                            <RowDefinition Height="Auto" />
                                                                            <RowDefinition Height="Auto" />
                                                                            <RowDefinition Height="140" />
                                                                            <RowDefinition Height="Auto" />
                                                                            <RowDefinition Height="140" />
                                                                        </Grid.RowDefinitions>

                                                                        <Border Grid.Row="0" Visibility="{Binding NotRunningVisibility}" Background="#242424" CornerRadius="6" Padding="12,8" Margin="0,0,0,8">
                                                                            <TextBlock Text="หน้าต่างนี้ยังไม่ได้เปิดทำงาน (กดเริ่มทำงานก่อนสแกนหา Captcha)" Foreground="#F59E0B" FontSize="12" />
                                                                        </Border>

                                                                        <Border Grid.Row="1" Background="#1A1A1A" BorderBrush="#282828" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,8">
                                                                            <DockPanel LastChildFill="True">
                                                                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                                                                                    <Button Style="{StaticResource PrimaryCtaButton}" Content="สแกนเดี๋ยวนี้" Command="{Binding ScanCaptchaNowCommand}" IsEnabled="{Binding IsRunning}" Margin="0,0,6,0" Padding="10,4" />
                                                                                    <Button Style="{StaticResource ActionDarkButton}" Content="คัดลอก Full HTML" Command="{Binding CopyCaptchaHtmlCommand}" IsEnabled="{Binding IsRunning}" Margin="0,0,6,0" />
                                                                                    <Button Style="{StaticResource ActionDarkButton}" Content="ส่งออกไฟล์" Command="{Binding ExportCaptchaHtmlCommand}" Margin="0,0,6,0" />
                                                                                    <Button Style="{StaticResource ActionDarkButton}" Content="ล้างผลลัพธ์" Command="{Binding ClearCaptchaResultsCommand}" Margin="0,0,10,0" />
                                                                                </StackPanel>

                                                                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                                                                                    <CheckBox Content="Auto Detect ทุก 5 วิ" IsChecked="{Binding IsCaptchaAutoDetect}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                                                                    <CheckBox Content="Auto Solve" IsChecked="{Binding IsAutoSolveCaptcha}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                                                                    <CheckBox Content="Auto Copy" IsChecked="{Binding AutoCopyToClipboardOnDetect}" VerticalAlignment="Center" />
                                                                                </StackPanel>
                                                                            </DockPanel>
                                                                        </Border>

                                                                        <!-- Visual Preview -->
                                                                        <Border Grid.Row="2" Background="#161616" BorderBrush="#2C2C2C" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,8">
                                                                            <Border.Style>
                                                                                <Style TargetType="Border">
                                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                                    <Style.Triggers>
                                                                                        <DataTrigger Binding="{Binding HasCaptchaImage}" Value="True">
                                                                                            <Setter Property="Visibility" Value="Visible" />
                                                                                        </DataTrigger>
                                                                                        <DataTrigger Binding="{Binding HasDirectImage}" Value="True">
                                                                                            <Setter Property="Visibility" Value="Visible" />
                                                                                        </DataTrigger>
                                                                                        <DataTrigger Binding="{Binding HasCroppedImage}" Value="True">
                                                                                            <Setter Property="Visibility" Value="Visible" />
                                                                                        </DataTrigger>
                                                                                        <DataTrigger Binding="{Binding IsCaptchaAlertVisible}" Value="True">
                                                                                            <Setter Property="Visibility" Value="Visible" />
                                                                                        </DataTrigger>
                                                                                    </Style.Triggers>
                                                                                </Style>
                                                                            </Border.Style>
                                                                            <Grid>
                                                                                <Grid.RowDefinitions>
                                                                                    <RowDefinition Height="Auto" />
                                                                                    <RowDefinition Height="Auto" />
                                                                                </Grid.RowDefinitions>

                                                                                <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,8">
                                                                                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                                                                                        <Border Background="#DC2626" CornerRadius="4" Padding="8,2" VerticalAlignment="Center">
                                                                                            <TextBlock Text="ตรวจพบ CAPTCHA" FontWeight="Bold" FontSize="11" Foreground="White" />
                                                                                        </Border>
                                                                                        <Border Background="#242424" CornerRadius="4" Padding="6,2" Margin="8,0,0,0" VerticalAlignment="Center">
                                                                                            <TextBlock Text="{Binding DetectedCaptchaTypeDescription}" FontSize="11" Foreground="#F59E0B" FontWeight="SemiBold" />
                                                                                        </Border>
                                                                                        <TextBlock Text="เวลานับถอยหลัง: " FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center" Margin="12,0,0,0" />
                                                                                        <TextBlock Text="{Binding DetectedCaptchaCountdown, FallbackValue='00:00'}" FontSize="13" FontWeight="Bold" Foreground="#EF4444" VerticalAlignment="Center" Margin="2,0,0,0" />
                                                                                    </StackPanel>

                                                                                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                                                                                        <Button Style="{StaticResource PrimaryCtaButton}" Content="แก้ Captcha (Mock)" Command="{Binding SolveCaptchaMockCommand}" IsEnabled="{Binding CanSolveCaptcha}" Padding="10,4" Margin="0,0,6,0" />
                                                                                        <Button Style="{StaticResource ActionDarkButton}" Content="ปิดเสียงเตือน" Command="{Binding SilenceAlertCommand}" Margin="0,0,6,0" />
                                                                                        <Button Style="{StaticResource ActionDarkButton}" Content="เปิดโฟลเดอร์" Command="{Binding OpenCaptchaImageFolderCommand}" Margin="0,0,6,0" />
                                                                                        <Button Style="{StaticResource ActionDarkButton}" Content="บันทึกภาพ" Command="{Binding SaveCaptchaImageAsCommand}" />
                                                                                    </StackPanel>
                                                                                </DockPanel>

                                                                                <Grid Grid.Row="1">
                                                                                    <Grid.ColumnDefinitions>
                                                                                        <ColumnDefinition Width="*" />
                                                                                        <ColumnDefinition Width="12" />
                                                                                        <ColumnDefinition Width="*" />
                                                                                    </Grid.ColumnDefinitions>

                                                                                    <Border Grid.Column="0" Background="#0C0C0C" BorderBrush="#242424" BorderThickness="1" CornerRadius="6" Padding="8">
                                                                                        <Grid>
                                                                                            <Grid.RowDefinitions>
                                                                                                <RowDefinition Height="Auto" />
                                                                                                <RowDefinition Height="160" />
                                                                                            </Grid.RowDefinitions>
                                                                                            <TextBlock Grid.Row="0" Text="ภาพดึงตรงจาก DOM" FontWeight="SemiBold" FontSize="11" Foreground="#38BDF8" Margin="0,0,0,4" />
                                                                                            <Image Grid.Row="1" Source="{Binding DirectCaptchaImageSource}" Stretch="Uniform" MaxHeight="150" />
                                                                                        </Grid>
                                                                                    </Border>

                                                                                    <Border Grid.Column="2" Background="#0C0C0C" BorderBrush="#242424" BorderThickness="1" CornerRadius="6" Padding="8">
                                                                                        <Grid>
                                                                                            <Grid.RowDefinitions>
                                                                                                <RowDefinition Height="Auto" />
                                                                                                <RowDefinition Height="160" />
                                                                                            </Grid.RowDefinitions>
                                                                                            <TextBlock Grid.Row="0" Text="ภาพแคปเจอร์ (Crop)" FontWeight="SemiBold" FontSize="11" Foreground="#34D399" Margin="0,0,0,4" />
                                                                                            <Image Grid.Row="1" Source="{Binding CroppedCaptchaImageSource}" Stretch="Uniform" MaxHeight="150" />
                                                                                        </Grid>
                                                                                    </Border>
                                                                                </Grid>
                                                                            </Grid>
                                                                        </Border>

                                                                        <!-- DataGrid -->
                                                                        <DataGrid Grid.Row="3" ItemsSource="{Binding DetectedCaptchaElements}" SelectedItem="{Binding SelectedCaptchaElement}"
                                                                                  FontFamily="Consolas" FontSize="11" Margin="0,0,0,8">
                                                                            <DataGrid.Columns>
                                                                                <DataGridTextColumn Header="Tag" Binding="{Binding TagName}" Width="70" FontWeight="Bold" />
                                                                                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="160" />
                                                                                <DataGridTextColumn Header="Class" Binding="{Binding ClassName}" Width="180" />
                                                                                <DataGridTextColumn Header="Layer" Binding="{Binding Depth, StringFormat='Depth {0}'}" Width="85" />
                                                                                <DataGridTextColumn Header="Frame URL" Binding="{Binding FrameUrl}" Width="170" />
                                                                                <DataGridTemplateColumn Header="การดำเนินการ" Width="*">
                                                                                    <DataGridTemplateColumn.CellTemplate>
                                                                                        <DataTemplate>
                                                                                            <Button Style="{StaticResource MicroButton}" Content="คัดลอก Element" 
                                                                                                    Command="{Binding DataContext.CopyElementHtmlCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" 
                                                                                                    CommandParameter="{Binding}" />
                                                                                        </DataTemplate>
                                                                                    </DataGridTemplateColumn.CellTemplate>
                                                                                </DataGridTemplateColumn>
                                                                            </DataGrid.Columns>
                                                                        </DataGrid>

                                                                        <DockPanel Grid.Row="4" Margin="0,0,0,4">
                                                                            <TextBlock Text="Full HTML ของหน้าที่มี Captcha:" FontWeight="SemiBold" FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center" />
                                                                            <Button Style="{StaticResource MicroButton}" DockPanel.Dock="Right" Content="คัดลอกโค้ดนี้" Command="{Binding CopyDetectedCaptchaCommand}" />
                                                                        </DockPanel>

                                                                        <Border Grid.Row="5" Background="#0C0C0C" CornerRadius="6" Padding="6" BorderThickness="1" BorderBrush="#242424">
                                                                            <TextBox Text="{Binding DetectedCaptchaHtml, Mode=OneWay}" IsReadOnly="True"
                                                                                     FontFamily="Consolas" FontSize="12" 
                                                                                     Background="Transparent" Foreground="#F59E0B" 
                                                                                     BorderThickness="0" 
                                                                                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" />
                                                                        </Border>
                                                                    </Grid>
                                                                </TabItem>

                                                                <!-- SUBTAB 4: LIVE CHAT MONITOR -->
                                                                <TabItem Header="มอนิเตอร์แชทสด">
                                                                    <Grid Margin="0,10,0,0">
                                                                        <Grid.RowDefinitions>
                                                                            <RowDefinition Height="Auto" />
                                                                            <RowDefinition Height="Auto" />
                                                                            <RowDefinition Height="Auto" />
                                                                            <RowDefinition Height="170" />
                                                                            <RowDefinition Height="Auto" />
                                                                            <RowDefinition Height="Auto" />
                                                                            <RowDefinition Height="Auto" />
                                                                            <RowDefinition Height="Auto" />
                                                                        </Grid.RowDefinitions>

                                                                        <!-- Channel Target Configuration Bar -->
                                                                        <Border Grid.Row="0" Background="#181818" BorderBrush="#282828" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,8">
                                                                            <DockPanel LastChildFill="True">
                                                                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                                                                                    <Button Style="{StaticResource PrimaryCtaButton}" Content="บันทึกช่อง" Command="{Binding SaveStreamerUsernameCommand}" Margin="0,0,6,0" Padding="12,4" />
                                                                                    <Button Style="{StaticResource ActionDarkButton}" Content="ใช้ช่องของโปรไฟล์นี้" Command="{Binding UseCurrentAccountAsChannelCommand}" ToolTip="นำ username ของโปรไฟล์นี้มาเป็นช่องตรวจจับ" Margin="0,0,6,0" />
                                                                                    <Button Style="{StaticResource ActionDarkButton}" Content="เปิดหน้าไลฟ์" Command="{Binding OpenChannelLivePageCommand}" ToolTip="เปิดหน้า TikTok Live ของช่องนี้" />
                                                                                </StackPanel>

                                                                                <Grid VerticalAlignment="Center">
                                                                                    <Grid.ColumnDefinitions>
                                                                                        <ColumnDefinition Width="Auto" />
                                                                                        <ColumnDefinition Width="*" />
                                                                                        <ColumnDefinition Width="Auto" />
                                                                                    </Grid.ColumnDefinitions>
                                                                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                                                                                        <TextBlock Text="ช่องตรวจจับเป้าหมาย:" FontSize="11" FontWeight="SemiBold" Foreground="#E2E8F0" VerticalAlignment="Center" Margin="0,0,6,0" />
                                                                                        <Border Background="#202020" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                                                                            <TextBlock Text="{Binding ActiveChannelDisplay}" FontSize="11" Foreground="#38BDF8" FontWeight="Medium" />
                                                                                        </Border>
                                                                                    </StackPanel>
                                                                                    <ui:TextBox Grid.Column="1" Text="{Binding StreamerUsername, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="ระบุ @username หรือ URL ห้องไลฟ์สดที่ต้องการตรวจจับ..." Padding="8,4" FontSize="11" Margin="0,0,8,0" />
                                                                                    <TextBlock Grid.Column="2" Text="{Binding ChannelStatusText}" FontSize="11" Foreground="#10B981" VerticalAlignment="Center" Margin="0,0,4,0" />
                                                                                </Grid>
                                                                            </DockPanel>
                                                                        </Border>

                                                                        <!-- Top Toolbar -->
                                                                        <Border Grid.Row="1" Background="#1A1A1A" BorderBrush="#282828" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,8">
                                                                            <DockPanel LastChildFill="True">
                                                                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                                                                                    <Button Style="{StaticResource PrimaryCtaButton}" Content="{Binding LiveChatMonitorButtonText}" Command="{Binding ToggleLiveChatMonitorCommand}" Margin="0,0,6,0" Padding="12,4" />
                                                                                    <Border Background="#202020" CornerRadius="4" Padding="6,2" VerticalAlignment="Center" Margin="0,0,8,0">
                                                                                        <TextBlock Text="{Binding LiveChatMonitorBadgeText}" FontSize="11" FontWeight="SemiBold" Foreground="#10B981" />
                                                                                    </Border>
                                                                                    <Button Style="{StaticResource ActionDarkButton}" Content="ล้างแชท" Command="{Binding ClearLiveChatCommand}" Margin="0,0,6,0" />
                                                                                    <Button Style="{StaticResource ActionDarkButton}" Content="คัดลอกทั้งหมด" Command="{Binding CopyAllLiveChatCommand}" Margin="0,0,6,0" />
                                                                                    <Button Style="{StaticResource ActionDarkButton}" Content="{}{ } คัดลอก JSON" Command="{Binding CopyAllLiveChatJsonCommand}" ToolTip="คัดลอกข้อความทั้งหมดเป็น JSON Array" Margin="0,0,6,0" />
                                                                                    <Button Style="{StaticResource ActionDarkButton}" Content="ส่งออก TXT" Command="{Binding ExportLiveChatCommand}" Margin="0,0,8,0" />
                                                                                </StackPanel>

                                                                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                                                                                    <CheckBox Content="Auto Reply (ตามกฎ Rules)" IsChecked="{Binding IsAutoReplyEnabled}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                                                                </StackPanel>
                                                                            </DockPanel>
                                                                        </Border>

                                                                        <!-- Filter & Search Toolbar -->
                                                                        <DockPanel Grid.Row="2" Margin="0,0,0,6" LastChildFill="True">
                                                                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="10,0,0,0">
                                                                                <ui:TextBox Text="{Binding ChatSearchText, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="ค้นหาข้อความ/ผู้ส่ง/JSON..." Width="180" Padding="8,4" FontSize="11" />
                                                                            </StackPanel>

                                                                            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                                <TextBlock Text="แสดง:" FontSize="11" Foreground="#94A3B8" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,6,0" />
                                                                                <Button Style="{StaticResource MicroButton}" Content="ทั้งหมด" Command="{Binding SelectAllFiltersCommand}" ToolTip="เลือกแสดงทุกประเภท" Margin="0,0,8,0" />
                                                                                <CheckBox Content="{Binding FilterChatLabel}" IsChecked="{Binding FilterShowChat}" VerticalAlignment="Center" Margin="0,0,10,0" FontSize="11" />
                                                                                <CheckBox Content="{Binding FilterGiftLabel}" IsChecked="{Binding FilterShowGift}" VerticalAlignment="Center" Margin="0,0,10,0" FontSize="11" />
                                                                                <CheckBox Content="{Binding FilterLikeFollowLabel}" IsChecked="{Binding FilterShowLikeFollow}" VerticalAlignment="Center" Margin="0,0,10,0" FontSize="11" />
                                                                                <CheckBox Content="{Binding FilterAutoReplyLabel}" IsChecked="{Binding FilterShowAutoReply}" VerticalAlignment="Center" Margin="0,0,10,0" FontSize="11" />
                                                                                <CheckBox Content="{Binding FilterOtherLabel}" IsChecked="{Binding FilterShowOther}" VerticalAlignment="Center" Margin="0,0,6,0" FontSize="11" />
                                                                            </WrapPanel>
                                                                        </DockPanel>

                                                                        <!-- Live Chat Stream DataGrid -->
                                                                        <DataGrid Grid.Row="3" ItemsSource="{Binding FilteredLiveChatMessages}" SelectedItem="{Binding SelectedChatMessage}"
                                                                                  FontFamily="Consolas" FontSize="11" Margin="0,0,0,6">
                                                                            <DataGrid.Columns>
                                                                                <DataGridTextColumn Header="เวลา" Binding="{Binding FormattedTime}" Width="80" />
                                                                                <DataGridTemplateColumn Header="ประเภท" Width="100">
                                                                                    <DataGridTemplateColumn.CellTemplate>
                                                                                        <DataTemplate>
                                                                                            <Border Background="#202020" CornerRadius="3" Padding="4,1" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                                                                <TextBlock Text="{Binding TypeDisplay}" Foreground="{Binding TypeColor}" FontWeight="SemiBold" FontSize="10" />
                                                                                            </Border>
                                                                                        </DataTemplate>
                                                                                    </DataGridTemplateColumn.CellTemplate>
                                                                                </DataGridTemplateColumn>
                                                                                <DataGridTextColumn Header="ผู้ส่ง" Binding="{Binding SenderDisplay}" Width="210" FontWeight="SemiBold" />
                                                                                <DataGridTextColumn Header="ข้อความ / ของขวัญ" Binding="{Binding Message}" Width="*" />
                                                                                <DataGridTextColumn Header="บอทตอบกลับ" Binding="{Binding AutoReplyDisplay}" Width="160" Foreground="#C084FC" />
                                                                                <DataGridTemplateColumn Header="จัดการ" Width="165">
                                                                                    <DataGridTemplateColumn.CellTemplate>
                                                                                        <DataTemplate>
                                                                                            <StackPanel Orientation="Horizontal">
                                                                                                <Button Style="{StaticResource MicroButton}" Content="ตอบกลับ" 
                                                                                                        Command="{Binding DataContext.ReplyToChatMessageCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" 
                                                                                                        CommandParameter="{Binding}" Margin="0,0,4,0" />
                                                                                                <Button Style="{StaticResource MicroButton}" Content="คัดลอก" 
                                                                                                        Command="{Binding DataContext.CopySelectedChatMessageCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" 
                                                                                                        CommandParameter="{Binding}" Margin="0,0,4,0" />
                                                                                                <Button Style="{StaticResource MicroButton}" Content="{}{ } JSON" 
                                                                                                        Command="{Binding DataContext.CopySelectedChatMessageJsonCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" 
                                                                                                        CommandParameter="{Binding}" ToolTip="คัดลอกโครงสร้าง JSON รายการนี้" />
                                                                                            </StackPanel>
                                                                                        </DataTemplate>
                                                                                    </DataGridTemplateColumn.CellTemplate>
                                                                                </DataGridTemplateColumn>
                                                                            </DataGrid.Columns>
                                                                        </DataGrid>

                                                                        <!-- Raw JSON Inspector Drawer -->
                                                                        <Border Grid.Row="4" Background="#111111" BorderBrush="#262626" BorderThickness="1" CornerRadius="6" Padding="8,6" Margin="0,0,0,6">
                                                                            <Grid>
                                                                                <Grid.RowDefinitions>
                                                                                    <RowDefinition Height="Auto" />
                                                                                    <RowDefinition Height="Auto" />
                                                                                </Grid.RowDefinitions>
                                                                                <DockPanel Grid.Row="0" Margin="0,0,0,4">
                                                                                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                                                                                        <Button Style="{StaticResource MicroButton}" Content="คัดลอก JSON รายการนี้" Command="{Binding CopySelectedChatMessageJsonCommand}" CommandParameter="{Binding SelectedChatMessage}" ToolTip="คัดลอก JSON ของรายการที่เลือก" />
                                                                                    </StackPanel>
                                                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                                        <TextBlock Text="{}{ } Event JSON Viewer:" FontSize="11" FontWeight="SemiBold" Foreground="#94A3B8" Margin="0,0,6,0" />
                                                                                        <TextBlock Text="{Binding SelectedChatMessage.TypeDisplay, FallbackValue='(คลิกเลือกรายการในตารางเพื่อดู JSON)'}" Foreground="{Binding SelectedChatMessage.TypeColor, FallbackValue='#64748B'}" FontSize="10" FontWeight="SemiBold" Margin="0,0,6,0" />
                                                                                        <TextBlock Text="{Binding SelectedChatMessage.SenderDisplay}" FontSize="11" Foreground="#38BDF8" FontWeight="Medium" />
                                                                                    </StackPanel>
                                                                                </DockPanel>
                                                                                <TextBox Grid.Row="1" Text="{Binding SelectedChatMessage.FormattedJson, Mode=OneWay, FallbackValue='(คลิกเลือกรายการในตารางด้านบนเพื่อตรวจสอบโครงสร้าง JSON หรือ Raw DOM Node)'}" 
                                                                                         IsReadOnly="True" FontFamily="Consolas" FontSize="11" 
                                                                                         Background="#0A0A0A" Foreground="#A3E635" BorderThickness="1" BorderBrush="#202020" 
                                                                                         Height="75" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Padding="6,4" />
                                                                            </Grid>
                                                                        </Border>

                                                                        <!-- Quick Reply Template Chips -->
                                                                        <DockPanel Grid.Row="5" Margin="0,0,0,6">
                                                                            <TextBlock Text="เทมเพลตตอบด่วน:" FontSize="10" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,6,0" />
                                                                            <WrapPanel Orientation="Horizontal">
                                                                                <Button Style="{StaticResource MicroButton}" Content="ขอบคุณสำหรับการติดตามครับ 🙏" Command="{Binding SendQuickTemplateCommand}" CommandParameter="ขอบคุณสำหรับการติดตามครับ 🙏" Margin="0,0,4,2" />
                                                                                <Button Style="{StaticResource MicroButton}" Content="ยินดีต้อนรับสู่ไลฟ์สตรีมครับ ✨" Command="{Binding SendQuickTemplateCommand}" CommandParameter="ยินดีต้อนรับสู่ไลฟ์สตรีมครับ ✨" Margin="0,0,4,2" />
                                                                                <Button Style="{StaticResource MicroButton}" Content="ขอบคุณสำหรับของขวัญมากๆ ครับ ❤️" Command="{Binding SendQuickTemplateCommand}" CommandParameter="ขอบคุณสำหรับของขวัญมากๆ ครับ ❤️" Margin="0,0,4,2" />
                                                                                <Button Style="{StaticResource MicroButton}" Content="ฝากกดไลก์กดแชร์ด้วยนะครับ 👍" Command="{Binding SendQuickTemplateCommand}" CommandParameter="ฝากกดไลก์กดแชร์ด้วยนะครับ 👍" Margin="0,0,4,2" />
                                                                            </WrapPanel>
                                                                        </DockPanel>

                                                                        <!-- Send Message Input Dock -->
                                                                        <DockPanel Grid.Row="6" Margin="0,0,0,4">
                                                                            <Button Style="{StaticResource PrimaryCtaButton}" DockPanel.Dock="Right" Content="ส่งข้อความสด" Command="{Binding SendLiveChatCommand}" IsEnabled="{Binding IsRunning}" Padding="12,4" />
                                                                            <ui:TextBox Text="{Binding TestChatMessage, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="พิมพ์ข้อความตอบกลับ หรือส่งเข้าห้องไลฟ์สด..." Margin="0,0,6,0" Padding="8,4" FontSize="11" />
                                                                        </DockPanel>

                                                                        <!-- Live Chat Status Bar -->
                                                                        <DockPanel Grid.Row="7">
                                                                            <TextBlock Text="{Binding LiveChatCountSummary}" FontSize="11" Foreground="#64748B" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="10,0,0,0" />
                                                                            <TextBlock Text="{Binding LiveChatStatus}" FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                                        </DockPanel>
                                                                    </Grid>
                                                                </TabItem>

                                                                <!-- SUBTAB 5: DEBUG LOG -->
                                                                <TabItem Header="บันทึกระบบ">
                                                                    <Grid Margin="0,10,0,0">
                                                                        <Grid.RowDefinitions>
                                                                            <RowDefinition Height="Auto" />
                                                                            <RowDefinition Height="180" />
                                                                        </Grid.RowDefinitions>

                                                                        <DockPanel Grid.Row="0" Margin="0,0,0,6">
                                                                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                                                                                <Button Style="{StaticResource ActionDarkButton}" Content="ล้าง Log" Command="{Binding ClearLogsCommand}" Margin="0,0,6,0" />
                                                                                <Button Style="{StaticResource ActionDarkButton}" Content="คัดลอกทั้งหมด" Command="{Binding CopyAllLogsCommand}" Margin="0,0,6,0" />
                                                                                <Button Style="{StaticResource ActionDarkButton}" Content="เปิดไฟล์ Log" Command="{Binding OpenLogFileCommand}" Margin="0,0,6,0" />
                                                                                <Button Style="{StaticResource ActionDarkButton}" Content="โฟลเดอร์ Log" Command="{Binding OpenLogsFolderCommand}" />
                                                                            </StackPanel>

                                                                            <ui:TextBox DockPanel.Dock="Right" Text="{Binding LogSearchText, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="ค้นหาใน Log..." Width="180" Padding="8,4" FontSize="11" />
                                                                        </DockPanel>

                                                                        <DataGrid Grid.Row="1" ItemsSource="{Binding FilteredLogs}" SelectedItem="{Binding SelectedLog}"
                                                                                  FontFamily="Consolas" FontSize="11">
                                                                            <DataGrid.Columns>
                                                                                <DataGridTextColumn Header="เวลา" Binding="{Binding FormattedTime}" Width="85" />
                                                                                <DataGridTextColumn Header="ระดับ" Binding="{Binding LevelDisplay}" Width="70" />
                                                                                <DataGridTextColumn Header="หมวดหมู่" Binding="{Binding Category}" Width="90" />
                                                                                <DataGridTextColumn Header="ข้อความ" Binding="{Binding Message}" Width="*" />
                                                                            </DataGrid.Columns>
                                                                        </DataGrid>
                                                                    </Grid>
                                                                </TabItem>
                                                            </TabControl>
                                                        </StackPanel>
                                                    </Border>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Grid>

                    <!-- VIEW 1: CAPTCHA RADAR (Dual-Pane Master-Detail Hub) -->
                    <Grid Visibility="{Binding IsNavCaptcha, Converter={StaticResource BoolToVis}}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!-- VIEW HEADER: Title (Left) + Action buttons (Right) -->
                            <Grid Grid.Row="0" Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="ศูนย์ตรวจจับ Captcha" FontSize="18" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center" />
                                    <Border Background="#2B0D0D" BorderBrush="#DC2626" BorderThickness="1" CornerRadius="10" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center" Visibility="{Binding HasAnyCaptchaAlert, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="{Binding TotalCaptchaAlertCount, StringFormat='พบ {0} บัญชี'}" FontSize="11" FontWeight="SemiBold" Foreground="#EF4444" />
                                    </Border>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Button Style="{StaticResource ActionDarkButton}" Command="{Binding OpenCaptchaFolderCommand}" Margin="0,0,8,0" Padding="12,6">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <ui:SymbolIcon Symbol="Folder16" Foreground="#94A3B8" Margin="0,0,6,0" />
                                            <TextBlock Text="โฟลเดอร์ภาพ Captcha" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>

                                    <Button Style="{StaticResource PrimaryCtaButton}" Command="{Binding ScanAllCaptchasCommand}" Padding="14,6">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <ui:SymbolIcon Symbol="ShieldCheckmark16" Foreground="White" Margin="0,0,6,0" />
                                            <TextBlock Text="สแกนทุกบัญชี" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>

                            <!-- Master-Detail Dual Pane Grid -->
                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="260" />
                                    <ColumnDefinition Width="14" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- Left Column: Accounts List -->
                                <Border Grid.Column="0" Background="#161616" BorderBrush="#242424" BorderThickness="1" CornerRadius="8" Padding="10">
                                    <DockPanel LastChildFill="True">
                                        <TextBlock DockPanel.Dock="Top" Text="รายชื่อบัญชี" FontWeight="SemiBold" FontSize="12" Foreground="#94A3B8" Margin="4,0,0,8" />

                                        <ListBox ItemsSource="{Binding Instances}" SelectedItem="{Binding SelectedCaptchaInstance}" SelectedIndex="0">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                        </Grid.RowDefinitions>

                                                        <!-- Row 0: Name & Port -->
                                                        <DockPanel Grid.Row="0" LastChildFill="True">
                                                            <Border DockPanel.Dock="Right" Background="#141414" BorderBrush="#282828" BorderThickness="1" CornerRadius="4" Padding="5,1">
                                                                <TextBlock Text="{Binding CdpPort, StringFormat=':{0}'}" FontSize="10" FontWeight="SemiBold" Foreground="#38BDF8" />
                                                            </Border>
                                                            <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="12" Foreground="#FFFFFF" />
                                                        </DockPanel>

                                                        <!-- Row 1: Status Badge -->
                                                        <Border Grid.Row="1" CornerRadius="4" Padding="6,2" Margin="0,6,0,6" HorizontalAlignment="Left">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Background" Value="#222222" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsCaptchaAlertVisible}" Value="True">
                                                                            <Setter Property="Background" Value="#450A0A" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                                            <Setter Property="Background" Value="#064E3B" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <TextBlock FontSize="10" FontWeight="SemiBold">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Text" Value="สแตนด์บาย" />
                                                                        <Setter Property="Foreground" Value="#94A3B8" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsCaptchaAlertVisible}" Value="True">
                                                                                <Setter Property="Text" Value="{Binding DetectedCaptchaCount, StringFormat='พบ Captcha ({0})'}" />
                                                                                <Setter Property="Foreground" Value="#F87171" />
                                                                            </DataTrigger>
                                                                            <MultiDataTrigger>
                                                                                <MultiDataTrigger.Conditions>
                                                                                    <Condition Binding="{Binding IsRunning}" Value="True" />
                                                                                    <Condition Binding="{Binding IsCaptchaAlertVisible}" Value="False" />
                                                                                </MultiDataTrigger.Conditions>
                                                                                <Setter Property="Text" Value="ปกติ (เฝ้าระวัง)" />
                                                                                <Setter Property="Foreground" Value="#34D399" />
                                                                            </MultiDataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </Border>

                                                        <!-- Row 2: Micro Buttons -->
                                                        <StackPanel Grid.Row="2" Orientation="Horizontal">
                                                            <Button Style="{StaticResource MicroButton}" Content="สแกน" Command="{Binding ScanCaptchaNowCommand}" IsEnabled="{Binding IsRunning}" Margin="0,0,4,0" />
                                                            <Button Style="{StaticResource MicroButton}" Content="คัดลอก HTML" Command="{Binding CopyDetectedCaptchaCommand}" IsEnabled="{Binding IsCaptchaAlertVisible}" Margin="0,0,4,0" />
                                                            <Button Style="{StaticResource MicroButton}" Content="ส่งออก" Command="{Binding ExportCaptchaHtmlCommand}" IsEnabled="{Binding IsCaptchaAlertVisible}" />
                                                        </StackPanel>
                                                    </Grid>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </DockPanel>
                                </Border>

                                <!-- Right Column: Detail Inspector for Selected Account -->
                                <Border Grid.Column="2" Background="#161616" BorderBrush="#242424" BorderThickness="1" CornerRadius="8" Padding="14">
                                    <Grid>
                                        <!-- State 1: When No Account is Selected -->
                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="{Binding NoSelectedCaptchaVisibility}">
                                            <ui:SymbolIcon Symbol="ShieldCheckmark24" FontSize="36" Foreground="#475569" HorizontalAlignment="Center" Margin="0,0,0,10" />
                                            <TextBlock Text="เลือกบัญชีจากรายการทางซ้ายเพื่อดูรายละเอียด Captcha" FontSize="13" FontWeight="Medium" HorizontalAlignment="Center" Foreground="#94A3B8" />
                                        </StackPanel>

                                        <!-- State 2: When an Account is Selected -->
                                        <Grid DataContext="{Binding SelectedCaptchaInstance}" Visibility="{Binding DataContext.HasSelectedCaptchaVisibility, RelativeSource={RelativeSource AncestorType=Window}}">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="160" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="*" />
                                            </Grid.RowDefinitions>

                                            <!-- Top Toolbar -->
                                            <DockPanel Grid.Row="0" Margin="0,0,0,12">
                                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="15" Foreground="#FFFFFF" Margin="0,0,8,0" />
                                                    <Border Background="#1A1A1A" BorderBrush="#2E2E2E" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,10,0">
                                                        <TextBlock Text="{Binding CdpPort, StringFormat='CDP: 127.0.0.1:{0}'}" FontSize="11" Foreground="#38BDF8" FontWeight="SemiBold" />
                                                    </Border>
                                                    <Button Style="{StaticResource PrimaryCtaButton}" Content="สแกนทันที" Command="{Binding ScanCaptchaNowCommand}" IsEnabled="{Binding IsRunning}" Margin="0,0,6,0" Padding="10,4" />
                                                    <Button Style="{StaticResource ActionDarkButton}" Content="คัดลอก Full HTML" Command="{Binding CopyCaptchaHtmlCommand}" IsEnabled="{Binding IsRunning}" Margin="0,0,6,0" />
                                                    <Button Style="{StaticResource ActionDarkButton}" Content="ส่งออกไฟล์" Command="{Binding ExportCaptchaHtmlCommand}" Margin="0,0,6,0" />
                                                    <Button Style="{StaticResource ActionDarkButton}" Content="ล้างผลลัพธ์" Command="{Binding ClearCaptchaResultsCommand}" Margin="0,0,10,0" />
                                                </StackPanel>

                                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                                                    <CheckBox Content="Auto Detect ทุก 5 วิ" IsChecked="{Binding IsCaptchaAutoDetect}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                                    <CheckBox Content="Auto Copy" IsChecked="{Binding AutoCopyToClipboardOnDetect}" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </DockPanel>

                                            <!-- Visual Captcha Display Card -->
                                            <Border Grid.Row="1" Background="#1C1C1C" BorderBrush="#2A2A2A" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,10">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasCaptchaImage}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsCaptchaAlertVisible}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="240" />
                                                        <ColumnDefinition Width="16" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>

                                                    <!-- Left: Captcha Image Box -->
                                                    <Border Grid.Column="0" Background="#0C0C0C" BorderBrush="#242424" BorderThickness="1" CornerRadius="6" Padding="4" MaxHeight="180" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <Grid>
                                                            <Image Source="{Binding CaptchaImageSource}" Stretch="Uniform" MaxHeight="170" />
                                                            <TextBlock Text="กำลังรอรูปภาพ..." Foreground="#64748B" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding HasCaptchaImage}" Value="False">
                                                                                <Setter Property="Visibility" Value="Visible" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </Grid>
                                                    </Border>

                                                    <!-- Right: Captcha Metadata & Actions -->
                                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                        <DockPanel LastChildFill="False" Margin="0,0,0,6">
                                                            <Border Background="#DC2626" CornerRadius="4" Padding="8,2" VerticalAlignment="Center">
                                                                <TextBlock Text="ตรวจพบ CAPTCHA" FontWeight="Bold" FontSize="11" Foreground="White" />
                                                            </Border>
                                                            <Border Background="#242424" CornerRadius="4" Padding="6,2" Margin="8,0,0,0" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding DetectedCaptchaTypeDescription}" FontSize="11" Foreground="#F59E0B" FontWeight="SemiBold" />
                                                            </Border>
                                                        </DockPanel>

                                                        <StackPanel Orientation="Horizontal" Margin="0,2,0,4">
                                                            <TextBlock Text="เวลานับถอยหลัง: " FontSize="12" Foreground="#94A3B8" VerticalAlignment="Center" />
                                                            <TextBlock Text="{Binding DetectedCaptchaCountdown, FallbackValue='00:00'}" FontSize="15" FontWeight="Bold" Foreground="#EF4444" VerticalAlignment="Center" Margin="4,0,0,0" />
                                                        </StackPanel>

                                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                            <TextBlock Text="Challenge ID: " FontSize="11" Foreground="#64748B" VerticalAlignment="Center" />
                                                            <TextBlock Text="{Binding DetectedCaptchaSessionId, FallbackValue='-'}" FontSize="11" FontFamily="Consolas" Foreground="#94A3B8" VerticalAlignment="Center" Margin="4,0,0,0" />
                                                        </StackPanel>

                                                        <TextBlock Text="{Binding LastCapturedImagePath, StringFormat='ไฟล์: {0}'}" FontSize="10" FontFamily="Consolas" Foreground="#10B981" TextTrimming="CharacterEllipsis" Margin="0,0,0,8" />

                                                        <StackPanel Orientation="Horizontal">
                                                            <Button Style="{StaticResource ActionDarkButton}" Content="ปิดเสียงเตือน" Command="{Binding SilenceAlertCommand}" Margin="0,0,6,0" />
                                                            <Button Style="{StaticResource PrimaryCtaButton}" Content="เปิดโฟลเดอร์ภาพ" Command="{Binding OpenCaptchaImageFolderCommand}" Margin="0,0,6,0" Padding="10,4" />
                                                            <Button Style="{StaticResource ActionDarkButton}" Content="คัดลอกรูปภาพ" Command="{Binding CopyCaptchaImageCommand}" Margin="0,0,6,0" />
                                                            <Button Style="{StaticResource ActionDarkButton}" Content="บันทึกภาพ" Command="{Binding SaveCaptchaImageAsCommand}" />
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>

                                            <!-- Elements DataGrid -->
                                            <DataGrid Grid.Row="2" ItemsSource="{Binding DetectedCaptchaElements}" SelectedItem="{Binding SelectedCaptchaElement}"
                                                      FontFamily="Consolas" FontSize="11" Margin="0,0,0,10">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Tag" Binding="{Binding TagName}" Width="70" FontWeight="Bold" />
                                                    <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="160" />
                                                    <DataGridTextColumn Header="Class" Binding="{Binding ClassName}" Width="190" />
                                                    <DataGridTextColumn Header="Layer" Binding="{Binding Depth, StringFormat='Depth {0}'}" Width="80" />
                                                    <DataGridTextColumn Header="Frame URL" Binding="{Binding FrameUrl}" Width="180" />
                                                    <DataGridTemplateColumn Header="การดำเนินการ" Width="*">
                                                        <DataGridTemplateColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <Button Style="{StaticResource MicroButton}" Content="คัดลอก Element" 
                                                                        Command="{Binding DataContext.CopyElementHtmlCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" 
                                                                        CommandParameter="{Binding}" />
                                                            </DataTemplate>
                                                        </DataGridTemplateColumn.CellTemplate>
                                                    </DataGridTemplateColumn>
                                                </DataGrid.Columns>
                                            </DataGrid>

                                            <!-- HTML Preview Header -->
                                            <DockPanel Grid.Row="3" Margin="0,0,0,6">
                                                <TextBlock Text="Full HTML ของหน้าที่มี Captcha:" FontWeight="SemiBold" FontSize="12" Foreground="#94A3B8" VerticalAlignment="Center" />
                                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                                                    <TextBlock Text="{Binding DetectedCaptchaCount, StringFormat='พบ {0} จุด'}" FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,0,10,0" />
                                                    <TextBlock Text="{Binding LastCaptchaDetectedTime, StringFormat='เวลา {0}'}" FontSize="11" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,10,0" />
                                                    <Button Style="{StaticResource MicroButton}" Content="คัดลอกโค้ดนี้" Command="{Binding CopyDetectedCaptchaCommand}" />
                                                </StackPanel>
                                            </DockPanel>

                                            <!-- Code Viewer -->
                                            <Border Grid.Row="4" Background="#0C0C0C" CornerRadius="6" Padding="8" BorderThickness="1" BorderBrush="#242424">
                                                <TextBox Text="{Binding DetectedCaptchaHtml, Mode=OneWay}" IsReadOnly="True"
                                                         FontFamily="Consolas" FontSize="12"
                                                         Background="Transparent" Foreground="#F59E0B"
                                                         BorderThickness="0"
                                                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" />
                                            </Border>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Grid>
                    </Grid>

                    <!-- VIEW 2: NETWORK & PROXIFIER -->
                    <Grid Visibility="{Binding IsNavProxies, Converter={StaticResource BoolToVis}}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!-- VIEW HEADER: Title (Left) + Action buttons (Right) -->
                            <Grid Grid.Row="0" Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="Proxy เครือข่าย" FontSize="18" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center" />
                                    <Border Background="#202020" CornerRadius="10" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Proxies.Count, StringFormat='{}{0} รายการ'}" FontSize="11" FontWeight="SemiBold" Foreground="#38BDF8" />
                                    </Border>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Button Style="{StaticResource ActionDarkButton}" Content="อัปเดต Proxifier" Command="{Binding LaunchProxifierCommand}" Margin="0,0,8,0" Padding="12,6" />
                                    <Button Style="{StaticResource PrimaryCtaButton}" Content="+ เพิ่ม Proxy" Command="{Binding AddProxyCommand}" Padding="14,6" />
                                </StackPanel>
                            </Grid>

                            <!-- Proxies List -->
                            <DataGrid Grid.Row="1" ItemsSource="{Binding Proxies}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="ชื่อ Proxy" Binding="{Binding Name}" Width="150" />
                                    <DataGridTextColumn Header="โพรโทคอล" Binding="{Binding Protocol}" Width="100" />
                                    <DataGridTextColumn Header="Host" Binding="{Binding Host}" Width="180" />
                                    <DataGridTextColumn Header="Port" Binding="{Binding Port}" Width="80" />
                                    <DataGridTextColumn Header="Username" Binding="{Binding Username}" Width="120" />
                                    <DataGridTextColumn Header="Proxifier ID" Binding="{Binding ProxifierId}" Width="100" />
                                    <DataGridCheckBoxColumn Header="เปิดใช้งาน" Binding="{Binding IsActive}" Width="90" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Grid>

                    <!-- VIEW 3: AUTO-REPLY RULES -->
                    <Grid Visibility="{Binding IsNavRules, Converter={StaticResource BoolToVis}}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!-- VIEW HEADER: Title (Left) + Action buttons (Right) -->
                            <Grid Grid.Row="0" Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="กฎตอบกลับแชทอัตโนมัติ" FontSize="18" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center" />
                                    <Border Background="#202020" CornerRadius="10" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Rules.Count, StringFormat='{}{0} กฎ'}" FontSize="11" FontWeight="SemiBold" Foreground="#38BDF8" />
                                    </Border>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Button Style="{StaticResource PrimaryCtaButton}" Content="+ เพิ่มกฎใหม่" Command="{Binding AddRuleCommand}" Padding="14,6" />
                                </StackPanel>
                            </Grid>

                            <DataGrid Grid.Row="1" ItemsSource="{Binding Rules}">
                                <DataGrid.Columns>
                                    <DataGridCheckBoxColumn Header="เปิดใช้" Binding="{Binding IsEnabled}" Width="70" />
                                    <DataGridTextColumn Header="ชื่อกฎ" Binding="{Binding Name}" Width="160" />
                                    <DataGridTextColumn Header="เงื่อนไข" Binding="{Binding TriggerType}" Width="140" />
                                    <DataGridTextColumn Header="คำค้นหา" Binding="{Binding Pattern}" Width="140" />
                                    <DataGridTextColumn Header="เพชรขั้นต่ำ" Binding="{Binding MinDiamonds}" Width="90" />
                                    <DataGridTextColumn Header="ข้อความตอบกลับ" Binding="{Binding ResponseTemplate}" Width="*" />
                                    <DataGridTextColumn Header="คูลดาวน์ (วิ)" Binding="{Binding CooldownSeconds}" Width="90" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Grid>

                    <!-- VIEW 4: SETTINGS -->
                    <Grid Visibility="{Binding IsNavSettings, Converter={StaticResource BoolToVis}}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!-- VIEW HEADER: Title (Left) + Action buttons (Right) -->
                            <Grid Grid.Row="0" Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="ตั้งค่าระบบ" FontSize="18" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Button Style="{StaticResource PrimaryCtaButton}" Content="บันทึกการตั้งค่า" Command="{Binding SaveSettingsCommand}" Padding="18,6" />
                                </StackPanel>
                            </Grid>

                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="0,0,12,0">
                                    <!-- 1. Executable Paths -->
                                    <Border Background="#1A1A1A" BorderBrush="#282828" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,12">
                                        <StackPanel>
                                            <TextBlock Text="ตำแหน่งไฟล์โปรแกรม" FontWeight="Bold" FontSize="14" Foreground="#FFFFFF" Margin="0,0,0,10" />
                                            
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="180" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Grid.Row="0" Grid.Column="0" Text="TikTok LIVE Studio.exe:" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,6" />
                                                <ui:TextBox Grid.Row="0" Grid.Column="1" Text="{Binding StudioExePath, UpdateSourceTrigger=PropertyChanged}" Margin="0,6" />

                                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Proxifier.exe:" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,6" />
                                                <ui:TextBox Grid.Row="1" Grid.Column="1" Text="{Binding ProxifierExePath, UpdateSourceTrigger=PropertyChanged}" Margin="0,6" />

                                                <TextBlock Grid.Row="2" Grid.Column="0" Text="ไฟล์โปรไฟล์ Proxifier (.ppx):" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,6" />
                                                <ui:TextBox Grid.Row="2" Grid.Column="1" Text="{Binding ProxifierProfilePath, UpdateSourceTrigger=PropertyChanged}" Margin="0,6" />
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <!-- 2. Performance -->
                                    <Border Background="#1A1A1A" BorderBrush="#282828" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,12">
                                        <StackPanel>
                                            <TextBlock Text="ประสิทธิภาพ" FontWeight="Bold" FontSize="14" Foreground="#FFFFFF" Margin="0,0,10,0" />
                                            <CheckBox Content="ซ่อนหน้าต่างอัตโนมัติเมื่อเปิดโปรแกรม (ลดภาระ GPU)" 
                                                      IsChecked="{Binding AutoHideOnLaunch}" />
                                        </StackPanel>
                                    </Border>

                                    <!-- 3. Captcha Sound & Auto-Save -->
                                    <Border Background="#1A1A1A" BorderBrush="#282828" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,12">
                                        <StackPanel>
                                            <TextBlock Text="เสียงแจ้งเตือนและบันทึกภาพ Captcha" FontWeight="Bold" FontSize="14" Foreground="#FFFFFF" Margin="0,0,10,0" />

                                            <Grid Margin="0,0,0,10">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="180" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Grid.Row="0" Grid.Column="0" Text="เสียงแจ้งเตือน:" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,6" />
                                                <StackPanel Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <CheckBox Content="เปิดเสียงเมื่อตรวจพบ Captcha" IsChecked="{Binding EnableCaptchaSoundAlert}" VerticalAlignment="Center" Margin="0,0,16,0" />
                                                    <CheckBox Content="เล่นเสียงวนซ้ำจนกว่าจะแก้เสร็จ" IsChecked="{Binding LoopCaptchaSoundAlert}" VerticalAlignment="Center" />
                                                </StackPanel>

                                                <TextBlock Grid.Row="1" Grid.Column="0" Text="ระดับความดังเสียง:" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,6" />
                                                <DockPanel Grid.Row="1" Grid.Column="1" Margin="0,6,8,6">
                                                    <TextBlock Text="{Binding CaptchaSoundVolume, StringFormat='{}{0}%'}" DockPanel.Dock="Right" Width="40" TextAlignment="Right" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#38BDF8" Margin="8,0,0,0" />
                                                    <Slider Minimum="0" Maximum="100" Value="{Binding CaptchaSoundVolume}" TickFrequency="5" IsSnapToTickEnabled="True" VerticalAlignment="Center" />
                                                </DockPanel>
                                                <StackPanel Grid.Row="1" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Button Style="{StaticResource ActionDarkButton}" Content="ทดสอบเสียง" Command="{Binding TestSoundCommand}" Margin="0,0,6,0" />
                                                    <Button Style="{StaticResource ActionDarkButton}" Content="หยุดเสียง" Command="{Binding StopSoundCommand}" />
                                                </StackPanel>

                                                <TextBlock Grid.Row="2" Grid.Column="0" Text="ไฟล์เสียงเตือน:" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,6" />
                                                <ui:TextBox Grid.Row="2" Grid.Column="1" Text="{Binding CaptchaSoundFilePath, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="เว้นว่างไว้เพื่อใช้เสียงมาตรฐานของระบบ" Margin="0,6,8,6" />
                                                <Button Grid.Row="2" Grid.Column="2" Style="{StaticResource ActionDarkButton}" Content="เลือกไฟล์..." Command="{Binding BrowseSoundFileCommand}" VerticalAlignment="Center" />
                                            </Grid>

                                            <Separator Margin="0,6,0,10" Background="#262626" />

                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="180" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Grid.Row="0" Grid.Column="0" Text="บันทึกภาพ Captcha:" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,6" />
                                                <StackPanel Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <CheckBox Content="บันทึกภาพลงเครื่องอัตโนมัติ" IsChecked="{Binding AutoSaveCaptchaImage}" VerticalAlignment="Center" />
                                                </StackPanel>

                                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Auto Solve อัตโนมัติ:" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,6" />
                                                <StackPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <CheckBox Content="เปิดใช้งาน Auto Solve เมื่อตรวจพบ" IsChecked="{Binding AutoSolveCaptcha}" VerticalAlignment="Center" />
                                                </StackPanel>

                                                <TextBlock Grid.Row="2" Grid.Column="0" Text="โฟลเดอร์บันทึกภาพ:" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,6" />
                                                <ui:TextBox Grid.Row="2" Grid.Column="1" Text="{Binding CaptchaSaveDirectory, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="โฟลเดอร์เก็บภาพ Captcha" Margin="0,6,8,6" />
                                                <StackPanel Grid.Row="2" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Button Style="{StaticResource ActionDarkButton}" Content="เลือกโฟลเดอร์..." Command="{Binding BrowseSaveDirectoryCommand}" Margin="0,0,6,0" />
                                                    <Button Style="{StaticResource ActionDarkButton}" Content="เปิดโฟลเดอร์" Command="{Binding OpenCaptchaFolderCommand}" />
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <!-- 4. CAPTCHA Solver API Settings -->
                                    <Border Background="#1A1A1A" BorderBrush="#282828" BorderThickness="1" CornerRadius="8" Margin="0,0,0,12" Padding="16">
                                        <StackPanel>
                                            <TextBlock Text="เซิร์ฟเวอร์ AI แก้ Captcha" FontSize="14" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,10" />

                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="180" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Grid.Row="0" Grid.Column="0" Text="โหมดประมวลผล:" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,6" />
                                                <StackPanel Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,6">
                                                    <RadioButton Content="Live AI Server (คลาวด์)" IsChecked="{Binding IsLocalApiSolverMode}" VerticalAlignment="Center" Margin="0,0,20,0" />
                                                    <RadioButton Content="Mock Response (ทดสอบ)" IsChecked="{Binding IsMockSolverMode}" VerticalAlignment="Center" />
                                                </StackPanel>

                                                <TextBlock Grid.Row="1" Grid.Column="0" Text="หน่วงเวลาก่อนแก้ (วินาที):" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,6" />
                                                <DockPanel Grid.Row="1" Grid.Column="1" Margin="0,6,8,6">
                                                    <TextBlock Text="{Binding AutoSolveDelaySeconds, StringFormat='{}{0} วินาที'}" DockPanel.Dock="Right" Width="60" TextAlignment="Right" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#38BDF8" Margin="8,0,0,0" />
                                                    <Slider Minimum="0" Maximum="30" Value="{Binding AutoSolveDelaySeconds}" TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center" />
                                                </DockPanel>
                                                <Button Grid.Row="1" Grid.Column="2" Style="{StaticResource ActionDarkButton}" Content="ทดสอบเชื่อมต่อ AI" Command="{Binding TestSolverApiCommand}" VerticalAlignment="Center" />

                                                <TextBlock Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding SolverApiTestStatus}" Foreground="#38BDF8" FontSize="11" Margin="0,2,0,0" />
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <!-- 5. User Account & License Management -->
                                    <Border Background="#1A1A1A" BorderBrush="#282828" BorderThickness="1" CornerRadius="8" Margin="0,0,0,12" Padding="16">
                                        <StackPanel>
                                            <TextBlock Text="ระบบบัญชีและใบอนุญาตใช้งาน (Account &amp; License)" FontSize="14" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,10" />

                                            <!-- STATE A: เมื่อยังไม่ได้เข้าสู่ระบบ (NOT LOGGED IN) -->
                                            <StackPanel Visibility="{Binding IsUserNotLoggedIn, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="กรุณาเข้าสู่ระบบเพื่อยืนยันสิทธิ์การใช้งานและปลดล็อกโควต้าจอ" Foreground="#94A3B8" FontSize="12" Margin="0,0,0,10" />

                                                <Grid Margin="0,0,0,6">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="180" />
                                                        <ColumnDefinition Width="280" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="ชื่อผู้ใช้ (Username):" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,6" />
                                                    <ui:TextBox Grid.Row="0" Grid.Column="1" Text="{Binding UsernameInput, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="กรอกชื่อผู้ใช้..." Margin="0,6,8,6" />

                                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="รหัสผ่าน (Password):" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,6" />
                                                    <ui:TextBox Grid.Row="1" Grid.Column="1" Text="{Binding PasswordInput, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="กรอกรหัสผ่าน..." Margin="0,6,8,6" />

                                                    <Button Grid.Row="0" Grid.RowSpan="2" Grid.Column="2" Style="{StaticResource PrimaryCtaButton}" Content="เข้าสู่ระบบ" Command="{Binding LoginCommand}" VerticalAlignment="Center" Padding="16,8" />

                                                    <TextBlock Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Text="{Binding LoginErrorMessage}" Foreground="#EF4444" FontSize="12" Margin="0,4,0,0" />
                                                </Grid>
                                            </StackPanel>

                                            <!-- STATE B: เมื่อเข้าสู่ระบบสำเร็จแล้ว (LOGGED IN) -->
                                            <StackPanel Visibility="{Binding IsUserLoggedIn, Converter={StaticResource BoolToVis}}">
                                                <Grid Margin="0,4">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="180" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <!-- บัญชีผู้ใช้ -->
                                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="บัญชีผู้ใช้งาน:" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,6" />
                                                    <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,6">
                                                        <TextBlock Text="{Binding LoggedInUsername}" FontWeight="Bold" Foreground="#FFFFFF" FontSize="13" VerticalAlignment="Center" />
                                                        <Border Background="#334155" CornerRadius="4" Padding="6,2" Margin="8,0,0,0" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding LicenseRole}" FontSize="10" FontWeight="SemiBold" Foreground="#38BDF8" />
                                                        </Border>
                                                    </StackPanel>

                                                    <!-- สิทธิ์และวันหมดอายุ -->
                                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="แพ็กเกจ &amp; วันหมดอายุ:" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,6" />
                                                    <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,6">
                                                        <TextBlock Text="{Binding LicensePlan}" FontWeight="SemiBold" Foreground="#10B981" VerticalAlignment="Center" />
                                                        <TextBlock Text=" (หมดอายุ: " Foreground="#64748B" VerticalAlignment="Center" />
                                                        <TextBlock Text="{Binding LicenseExpiryText}" Foreground="#94A3B8" VerticalAlignment="Center" />
                                                        <TextBlock Text=")" Foreground="#64748B" VerticalAlignment="Center" />
                                                    </StackPanel>

                                                    <!-- โควต้าจอที่ได้รับอนุญาต (Read-only) -->
                                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="โควต้าจอที่ได้รับอนุญาต:" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,6" />
                                                    <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,6">
                                                        <Border Background="#064E3B" BorderBrush="#059669" BorderThickness="1" CornerRadius="6" Padding="10,3">
                                                            <TextBlock Text="{Binding MaxTiktokAccounts, StringFormat='{}{0} บัญชี (จอ)'}" FontWeight="Bold" Foreground="#34D399" FontSize="12" />
                                                        </Border>
                                                        <TextBlock Text="* ควบคุมจากระบบกลางตามสิทธิ์บัญชีของคุณ" Foreground="#64748B" FontSize="11" Margin="10,0,0,0" VerticalAlignment="Center" />
                                                    </StackPanel>

                                                    <!-- Action buttons -->
                                                    <StackPanel Grid.Row="0" Grid.RowSpan="3" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                                                        <Button Style="{StaticResource ActionDarkButton}" Content="รีเฟรชสิทธิ์" Command="{Binding RefreshLicenseCommand}" Margin="0,0,6,0" Padding="12,6" />
                                                        <Button Style="{StaticResource ActionDarkButton}" Content="ออกจากระบบ" Command="{Binding LogoutCommand}" Padding="12,6" />
                                                    </StackPanel>

                                                    <TextBlock Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3" Text="{Binding LoginErrorMessage}" Foreground="#38BDF8" FontSize="11" Margin="0,4,0,0" />
                                                </Grid>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                    <!-- 6. Telegram Bot Notification Settings -->
                                    <Border Background="#1A1A1A" BorderBrush="#282828" BorderThickness="1" CornerRadius="8" Margin="0,0,0,16" Padding="16">
                                        <StackPanel>
                                            <TextBlock Text="แจ้งเตือนผ่าน Telegram" FontSize="14" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,10" />

                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="180" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Grid.Row="0" Grid.Column="0" Text="การแจ้งเตือน:" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,6" />
                                                <StackPanel Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <CheckBox Content="เปิดใช้งานการแจ้งเตือนผ่าน Telegram Bot" IsChecked="{Binding EnableTelegramAlert}" VerticalAlignment="Center" />
                                                </StackPanel>

                                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Bot Token:" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,6" />
                                                <ui:TextBox Grid.Row="1" Grid.Column="1" Text="{Binding TelegramBotToken, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="เช่น 123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ..." Margin="0,6,8,6" />
                                                <Button Grid.Row="1" Grid.Column="2" Style="{StaticResource ActionDarkButton}" Content="ทดสอบส่งข้อความ" Command="{Binding TestTelegramCommand}" VerticalAlignment="Center" />

                                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Chat ID / Group ID:" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,6" />
                                                <ui:TextBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding TelegramChatId, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="เช่น 987654321 หรือ -100123456789" Margin="0,6,0,6" />

                                                <TextBlock Grid.Row="3" Grid.Column="0" Text="เหตุการณ์ที่แจ้งเตือน:" Foreground="#94A3B8" VerticalAlignment="Top" Margin="0,8,0,0" />
                                                <StackPanel Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,6,0,6">
                                                    <CheckBox Content="แจ้งเตือนเมื่อตรวจพบ Captcha" IsChecked="{Binding TelegramAlertOnDetected}" Margin="0,2,0,4" />
                                                    <CheckBox Content="แนบรูปภาพ Screenshot ของ Captcha" IsChecked="{Binding TelegramSendPhoto}" Margin="20,0,0,6" />
                                                    <CheckBox Content="รายงานเมื่อแก้ Captcha สำเร็จ" IsChecked="{Binding TelegramAlertOnSolved}" Margin="0,2,0,4" />
                                                    <CheckBox Content="แจ้งเตือนเมื่อแก้ Captcha ล้มเหลว" IsChecked="{Binding TelegramAlertOnFailed}" Margin="0,2,0,4" />
                                                </StackPanel>

                                                <TextBlock Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding TelegramTestStatus}" Foreground="#38BDF8" FontSize="11" Margin="0,2,0,0" />
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- 3. BOTTOM STATUS BAR (FULL WIDTH) -->
        <Border Grid.Row="2" Background="#161616" BorderThickness="0,1,0,0" BorderBrush="#242424" Padding="16,6">
            <DockPanel LastChildFill="False">
                <!-- Left: Last Log & Status -->
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                    <Border Width="7" Height="7" CornerRadius="3.5" Background="#10B981" Margin="0,0,8,0" VerticalAlignment="Center" />
                    <TextBlock Text="สถานะ: " Foreground="#94A3B8" FontSize="11" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding StatusNotification}" FontWeight="SemiBold" Foreground="#38BDF8" FontSize="11" VerticalAlignment="Center" />
                </StackPanel>

                <!-- Right: Stats -->
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Instances.Count, StringFormat='บัญชี: {0}'}" Foreground="#94A3B8" FontSize="11" Margin="0,0,14,0" />
                    <TextBlock Text="{Binding Proxies.Count, StringFormat='Proxy: {0}'}" Foreground="#94A3B8" FontSize="11" Margin="0,0,14,0" />
                    <TextBlock Text="{Binding Rules.Count, StringFormat='กฎ: {0}'}" Foreground="#94A3B8" FontSize="11" Margin="0,0,14,0" />
                    <TextBlock Text="•  CDP Core v0.1.0" Foreground="#64748B" FontSize="11" />
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
    </Border>
</Window>
