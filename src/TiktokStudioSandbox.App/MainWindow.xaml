<Window x:Class="TiktokStudioSandbox.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:models="clr-namespace:TiktokStudioSandbox.Core.Models;assembly=TiktokStudioSandbox.Core"
        mc:Ignorable="d"
        Title="TikTok LIVE Studio - Multi-Instance &amp; Automation Sandbox v0.1.0" 
        Height="780" Width="1160"
        MinHeight="650" MinWidth="960"
        WindowStartupLocation="CenterScreen"
        Topmost="False"
        ShowInTaskbar="True"
        Background="#202020"
        Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    
    <Grid Background="#181818">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 2. Global Quick Action Toolbar -->
        <Border Grid.Row="0" Background="{DynamicResource SurfaceStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" Padding="16,8">
            <DockPanel LastChildFill="False">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <ui:Button Appearance="Primary" Content="เริ่มทุกจอ" 
                               Command="{Binding StartAllCommand}" Margin="0,0,8,0" Padding="14,6">
                        <ui:Button.Icon>
                            <ui:SymbolIcon Symbol="Play24" />
                        </ui:Button.Icon>
                    </ui:Button>
                    
                    <ui:Button Appearance="Danger" Content="ปิดทุกจอ" 
                               Command="{Binding StopAllCommand}" Margin="0,0,12,0" Padding="14,6">
                        <ui:Button.Icon>
                            <ui:SymbolIcon Symbol="Stop24" />
                        </ui:Button.Icon>
                    </ui:Button>
                    
                    <Separator Margin="4,0,12,0" />
                    
                    <ui:Button Content="ซ่อนทุกจอ" 
                               Command="{Binding HideAllWindowsCommand}" Margin="0,0,8,0" Padding="12,6"
                               ToolTip="ซ่อนหน้าต่าง UI ทั้งหมดเพื่อลดโหลด GPU/CPU (Pseudo-Headless) โดย CDP ยังทำงานได้ปกติ">
                        <ui:Button.Icon>
                            <ui:SymbolIcon Symbol="EyeOff24" />
                        </ui:Button.Icon>
                    </ui:Button>
                    
                    <ui:Button Content="แสดงทุกจอ" 
                               Command="{Binding ShowAllWindowsCommand}" Margin="0,0,8,0" Padding="12,6">
                        <ui:Button.Icon>
                            <ui:SymbolIcon Symbol="Eye24" />
                        </ui:Button.Icon>
                    </ui:Button>
                </StackPanel>

                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                    <ui:Button Appearance="Primary" Content="เพิ่มบัญชีใหม่" 
                               Command="{Binding AddInstanceCommand}" Margin="0,0,8,0" Padding="14,6">
                        <ui:Button.Icon>
                            <ui:SymbolIcon Symbol="Add24" />
                        </ui:Button.Icon>
                    </ui:Button>
                    
                    <ui:Button Content="อัปเดต Proxifier" 
                               Command="{Binding LaunchProxifierCommand}" 
                               ToolTip="สร้างกฎ XML และโหลดเข้า Proxifier ทันที" Padding="12,6">
                        <ui:Button.Icon>
                            <ui:SymbolIcon Symbol="ArrowSync24" />
                        </ui:Button.Icon>
                    </ui:Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- 3. Main Navigation Tabs -->
        <TabControl Grid.Row="1" Margin="16,12,16,8">
            <!-- TAB 1: INSTANCES MANAGEMENT -->
            <TabItem Header="📱 บัญชีสตูดิโอ (Instances)">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,12">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="รายการบัญชีสตูดิโอ" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <Border Background="{DynamicResource CardStrokeColorDefaultBrush}" CornerRadius="10" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Instances.Count, StringFormat='{}{0} บัญชี'}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                            </Border>
                        </StackPanel>
                    </DockPanel>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Instances}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <ui:Card Margin="0,0,0,10" Padding="14,12">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <!-- ROW 0: CLEAN DASHBOARD ROW (Avatar + 2-tier Info Hierarchy + Contextual Actions) -->
                                            <Grid Grid.Row="0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <!-- 1. Profile Avatar with Rounded Border -->
                                                <Grid Grid.Column="0" Margin="0,0,12,0" VerticalAlignment="Center">
                                                    <Border Width="38" Height="38" CornerRadius="19" Visibility="{Binding AvatarVisibility}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1.5">
                                                        <Border.Background>
                                                            <ImageBrush ImageSource="{Binding LoggedInAvatarUrl}" Stretch="UniformToFill" />
                                                        </Border.Background>
                                                    </Border>
                                                    <Border Width="38" Height="38" CornerRadius="19" Background="{DynamicResource SurfaceStrokeColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1.5" Visibility="{Binding FallbackAvatarVisibility}">
                                                        <ui:SymbolIcon Symbol="Person20" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                    </Border>
                                                </Grid>

                                                <!-- 2. Account Identity & Metadata (Structured 2-tier layout) -->
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <!-- Top Line: Name + Status Badge + TikTok @Handle -->
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0" />

                                                        <!-- Status Badge -->
                                                        <Border CornerRadius="4" Padding="7,2" Margin="0,0,6,0" VerticalAlignment="Center" Background="{DynamicResource CardStrokeColorDefaultBrush}">
                                                            <TextBlock Text="{Binding StatusDisplay}" FontSize="11" FontWeight="SemiBold" />
                                                        </Border>

                                                        <!-- TikTok @Handle Badge (When logged in) -->
                                                        <Border Background="{DynamicResource AccentFillColorTertiaryBrush}" CornerRadius="4" Padding="7,2" Margin="0,0,6,0" Visibility="{Binding LoggedInVisibility}" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding LoggedInDisplayId, StringFormat='@{0}'}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                                        </Border>

                                                        <!-- Window Hidden Tag (When running & hidden) -->
                                                        <Border Background="#262626" CornerRadius="4" Padding="6,2" Visibility="{Binding RunningVisibility}" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding WindowVisibilityDisplay}" FontSize="10" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                        </Border>
                                                    </StackPanel>

                                                    <!-- Bottom Line: Subtitle & Metadata -->
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,4,0,0">
                                                        <!-- Nickname (When logged in) -->
                                                        <TextBlock Text="{Binding LoggedInNickname}" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Visibility="{Binding LoggedInVisibility}" TextTrimming="CharacterEllipsis" MaxWidth="220" Margin="0,0,8,0" />
                                                        <!-- Prompt when NOT logged in -->
                                                        <TextBlock Text="ยังไม่เข้าสู่ระบบ (กด 'เข้าสู่ระบบ' เพื่อเชื่อมต่อบัญชี)" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Visibility="{Binding NotLoggedInVisibility}" Margin="0,0,8,0" />

                                                        <TextBlock Text="•" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,0,8,0" />

                                                        <!-- CDP Port -->
                                                        <TextBlock Text="{Binding CdpPort, StringFormat='CDP: {0}'}" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,0,8,0" />

                                                        <TextBlock Text="•" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,0,8,0" />

                                                        <!-- Profile Folder -->
                                                        <TextBlock Text="{Binding ProfileFolderName, StringFormat='📁 {0}'}" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                                    </StackPanel>
                                                </StackPanel>

                                                <!-- 3. Contextual Action Cluster -->
                                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <!-- Login Button (Only when NOT logged in & NOT running) -->
                                                    <ui:Button Appearance="Primary" Content="เข้าสู่ระบบ" Command="{Binding OpenStudioForLoginCommand}" 
                                                               Visibility="{Binding NotLoggedInVisibility}" IsEnabled="{Binding IsNotRunning}" 
                                                               Margin="0,0,6,0" Padding="14,6" FontSize="12" 
                                                               ToolTip="เปิดหน้าต่าง TikTok LIVE Studio เพื่อสแกน QR Code หรือเข้าสู่ระบบ">
                                                        <ui:Button.Icon>
                                                            <ui:SymbolIcon Symbol="Key16" />
                                                        </ui:Button.Icon>
                                                    </ui:Button>

                                                    <!-- Start Button (Only when LOGGED IN & NOT running) -->
                                                    <ui:Button Appearance="Primary" Content="เริ่มทำงาน" Command="{Binding StartCommand}" 
                                                               Visibility="{Binding LoggedInVisibility}" IsEnabled="{Binding IsNotRunning}" 
                                                               Margin="0,0,6,0" Padding="14,6" FontSize="12"
                                                               ToolTip="เปิดทำงาน TikTok LIVE Studio">
                                                        <ui:Button.Icon>
                                                            <ui:SymbolIcon Symbol="Play16" />
                                                        </ui:Button.Icon>
                                                    </ui:Button>

                                                    <!-- Stop Button (Only when RUNNING) -->
                                                    <ui:Button Appearance="Danger" Content="หยุด" Command="{Binding StopCommand}" 
                                                               Visibility="{Binding RunningVisibility}" Margin="0,0,6,0" Padding="12,6" FontSize="12">
                                                        <ui:Button.Icon>
                                                            <ui:SymbolIcon Symbol="Stop16" />
                                                        </ui:Button.Icon>
                                                    </ui:Button>

                                                    <!-- Toggle Window Visibility (Only when RUNNING) -->
                                                    <ui:Button Content="" Command="{Binding ToggleVisibilityCommand}" 
                                                               Visibility="{Binding RunningVisibility}" Margin="0,0,6,0" Padding="10,6" FontSize="12" 
                                                               ToolTip="สลับการซ่อน/แสดงหน้าต่าง UI (SW_HIDE/SW_SHOW)">
                                                        <ui:Button.Icon>
                                                            <ui:SymbolIcon Symbol="Eye16" />
                                                        </ui:Button.Icon>
                                                    </ui:Button>

                                                    <!-- Toggle Detail Drawer / Tools -->
                                                    <ui:Button Content="{Binding DetailButtonText}" Command="{Binding ToggleDetailCommand}" 
                                                               Margin="0,0,6,0" Padding="12,6" FontSize="12" 
                                                               ToolTip="เปิด/ปิดเครื่องมือและคอนโซล CDP">
                                                        <ui:Button.Icon>
                                                            <ui:SymbolIcon Symbol="Wrench16" />
                                                        </ui:Button.Icon>
                                                    </ui:Button>

                                                    <!-- Delete Instance Button -->
                                                    <ui:Button Content="" Command="{Binding DataContext.RemoveInstanceCommand, RelativeSource={RelativeSource AncestorType=TabControl}}" 
                                                               CommandParameter="{Binding}" Padding="8,6" ToolTip="ลบบัญชีนี้">
                                                        <ui:Button.Icon>
                                                            <ui:SymbolIcon Symbol="Delete16" />
                                                        </ui:Button.Icon>
                                                    </ui:Button>
                                                </StackPanel>
                                            </Grid>

                                            <!-- ROW 1: INLINE ERROR BANNER (Only when error occurs) -->
                                            <Border Grid.Row="1" Visibility="{Binding ErrorVisibility}" Background="#2B0D0D" BorderBrush="#DC2626" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,8,0,0">
                                                <DockPanel LastChildFill="True">
                                                    <ui:Button DockPanel.Dock="Right" Content="📋 คัดลอก Error" Command="{Binding CopyErrorCommand}" Padding="8,3" FontSize="11" />
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock Text="⚠️ ข้อผิดพลาด: " FontWeight="Bold" FontSize="11" Foreground="#EF4444" VerticalAlignment="Center" />
                                                        <TextBlock Text="{Binding StatusMessage}" Foreground="#FCA5A5" FontSize="11" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip="{Binding StatusMessage}" />
                                                    </StackPanel>
                                                </DockPanel>
                                            </Border>

                                            <!-- ROW 2: CAPTCHA ALERT POPUP (Clean & Actionable) -->
                                            <Border Grid.Row="2" Visibility="{Binding CaptchaAlertVisibility}" Background="#2B1A00" BorderBrush="#F59E0B" BorderThickness="1.5" CornerRadius="8" Padding="12,8" Margin="0,8,0,0">
                                                <DockPanel LastChildFill="True">
                                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <ui:Button Appearance="Primary" Content="🔍 ดูรายละเอียด" Command="{Binding OpenCaptchaTabCommand}" Padding="10,5" FontSize="11" Margin="0,0,6,0" ToolTip="เปิดลิ้นชักและสลับไปยังแท็บตรวจจับ Captcha ทันที" />
                                                        <ui:Button Content="✕" Command="{Binding DismissCaptchaAlertCommand}" Padding="8,5" FontSize="11" ToolTip="ปิดการแจ้งเตือนนี้ชั่วคราว" />
                                                    </StackPanel>

                                                    <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="🚨 ตรวจพบ CAPTCHA ในหน้าต่างนี้!" FontWeight="Bold" FontSize="12" Foreground="#F59E0B" VerticalAlignment="Center" />
                                                            <Border Background="#F59E0B" CornerRadius="4" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding DetectedCaptchaCount, StringFormat='พบ {0} รายการ'}" FontSize="10" FontWeight="Bold" Foreground="Black" />
                                                            </Border>
                                                            <TextBlock Text="{Binding LastCaptchaDetectedTime, StringFormat='เวลา {0}'}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" Margin="8,0,0,0" />
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding CaptchaAlertMessage}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" MaxWidth="540" Margin="0,2,0,0" />
                                                    </StackPanel>
                                                </DockPanel>
                                            </Border>

                                            <!-- ROW 3: DETAIL PANEL (Collapsible, contains Script Execution & Deep Tools) -->
                                            <Border Grid.Row="3" Visibility="{Binding DetailVisibility}" Margin="0,10,0,0" Padding="12" Background="{DynamicResource SurfaceStrokeColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8">
                                                <StackPanel>
                                                    <!-- Diagnostic Header Bar -->
                                                    <DockPanel LastChildFill="False" Margin="0,0,0,8">
                                                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                                                            <TextBlock Text="⚙️ เครื่องมือดีบักและการเชื่อมต่อ CDP:" FontWeight="SemiBold" FontSize="12" Margin="0,0,8,0" />
                                                            <Border Background="{DynamicResource AccentFillColorTertiaryBrush}" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                                                                <TextBlock Text="{Binding CdpPort, StringFormat='CDP: 127.0.0.1:{0}'}" FontSize="11" FontWeight="SemiBold" />
                                                            </Border>
                                                            <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="11" MaxWidth="380" TextTrimming="CharacterEllipsis" ToolTip="{Binding StatusMessage}" VerticalAlignment="Center" />
                                                        </StackPanel>

                                                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                                                            <Border Visibility="{Binding RunningVisibility}" Background="{DynamicResource SystemFillColorSuccessBrush}" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                                                                <TextBlock Text="🟢 เชื่อมต่ออยู่" FontSize="11" Foreground="White" FontWeight="SemiBold" />
                                                            </Border>
                                                            <ui:Button Content="📋 คัดลอก Error" Command="{Binding CopyErrorCommand}" Visibility="{Binding ErrorVisibility}" Padding="6,2" FontSize="11" Margin="0,0,6,0" />
                                                        </StackPanel>
                                                    </DockPanel>

                                                    <!-- Detail Subtabs -->
                                                    <TabControl SelectedIndex="{Binding SelectedDetailTabIndex}">
                                                        <!-- SUBTAB 0: LOGIN & SESSION TOOLS -->
                                                        <TabItem Header="🔑 จัดการล็อกอิน &amp; เซสชัน">
                                                            <Grid Margin="0,10,0,0">
                                                                <Grid.RowDefinitions>
                                                                    <RowDefinition Height="Auto" />
                                                                    <RowDefinition Height="Auto" />
                                                                    <RowDefinition Height="Auto" />
                                                                    <RowDefinition Height="Auto" />
                                                                </Grid.RowDefinitions>

                                                                <!-- ROW 0: PROFILE SUMMARY CARD -->
                                                                <ui:Card Grid.Row="0" Padding="12" Margin="0,0,0,10">
                                                                    <DockPanel LastChildFill="True">
                                                                        <!-- Right Action Buttons -->
                                                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                                                            <ui:Button Appearance="Primary" Content="🔑 เปิดสตูดิโอเพื่อเข้าสู่ระบบ" Command="{Binding OpenStudioForLoginCommand}" Padding="12,6" FontSize="12" Margin="0,0,6,0" ToolTip="เปิดหน้าต่าง TikTok LIVE Studio ขึ้นมาบนหน้าจอ ให้คุณสแกน QR Code หรือเข้าสู่ระบบเหมือนเปิดโปรแกรมปกติ" />
                                                                            <ui:Button Content="🔄 รีเฟรชโปรไฟล์" Command="{Binding RefreshProfileCommand}" Padding="8,6" FontSize="11" ToolTip="อ่านข้อมูลโปรไฟล์ล่าสุดเพื่ออัปเดตชื่อและรูปโปรไฟล์" />
                                                                        </StackPanel>

                                                                        <!-- Left: User Avatar & Handle Info -->
                                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                            <!-- Avatar -->
                                                                            <Grid Margin="0,0,12,0" VerticalAlignment="Center">
                                                                                <Border Width="42" Height="42" CornerRadius="21" Visibility="{Binding AvatarVisibility}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                                                                    <Border.Background>
                                                                                        <ImageBrush ImageSource="{Binding LoggedInAvatarUrl}" Stretch="UniformToFill" />
                                                                                    </Border.Background>
                                                                                </Border>
                                                                                <Border Width="42" Height="42" CornerRadius="21" Background="{DynamicResource SurfaceStrokeColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" Visibility="{Binding FallbackAvatarVisibility}">
                                                                                    <ui:SymbolIcon Symbol="Person24" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                                                </Border>
                                                                            </Grid>

                                                                            <StackPanel VerticalAlignment="Center">
                                                                                <StackPanel Orientation="Horizontal">
                                                                                    <TextBlock Text="{Binding DisplayNameAndHandle}" FontSize="13" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,0" />
                                                                                    <Border Background="{DynamicResource AccentFillColorTertiaryBrush}" CornerRadius="4" Padding="6,2" Visibility="{Binding LoggedInVisibility}" VerticalAlignment="Center">
                                                                                        <TextBlock Text="🟢 ล็อกอินแล้ว" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                                                                    </Border>
                                                                                    <Border Background="{DynamicResource CardStrokeColorDefaultBrush}" CornerRadius="4" Padding="6,2" Visibility="{Binding NotLoggedInVisibility}" VerticalAlignment="Center">
                                                                                        <TextBlock Text="⚪ ยังไม่เข้าสู่ระบบ" FontSize="10" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                                                    </Border>
                                                                                </StackPanel>
                                                                                <TextBlock Text="{Binding LoggedInUserId, StringFormat='TikTok UID: {0}'}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Visibility="{Binding LoggedInVisibility}" Margin="0,2,0,0" />
                                                                                <TextBlock Text="ยังไม่พบ Session บัญชี (กดปุ่ม 'เปิดสตูดิโอเพื่อเข้าสู่ระบบ' เพื่อสแกน QR Code หรือคัดลอก Session จากบัญชีหลัก)" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Visibility="{Binding NotLoggedInVisibility}" Margin="0,2,0,0" />
                                                                            </StackPanel>
                                                                        </StackPanel>
                                                                    </DockPanel>
                                                                </ui:Card>

                                                                <!-- ROW 1: Simple Profile & Session Action Buttons -->
                                                                <DockPanel Grid.Row="1" Margin="0,0,0,10">
                                                                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                                                                        <ui:Button Content="{Binding ModeBadgeText}" Command="{Binding SwitchModeCommand}" Margin="0,0,8,0" Padding="8,3" FontSize="11" ToolTip="คลิกเพื่อสลับระหว่าง Direct Profile / Default Profile" />
                                                                        <ui:Button Content="📋 คัดลอก Session จากบัญชีหลัก" Command="{Binding CloneSessionFromDefaultCommand}" Padding="8,3" FontSize="11" ToolTip="หากบัญชีหลักเคยล็อกอินผ่านแล้ว สามารถกดคัดลอกมายังโปรไฟล์นี้ได้ทันทีโดยไม่ต้องสแกนใหม่" />
                                                                    </StackPanel>
                                                                </DockPanel>

                                                                <!-- ROW 2: Quick Tokens Section (CDP) -->
                                                                <ui:Card Grid.Row="2" Padding="10" Margin="0,0,0,8">
                                                                    <Grid>
                                                                        <Grid.RowDefinitions>
                                                                            <RowDefinition Height="Auto" />
                                                                            <RowDefinition Height="Auto" />
                                                                        </Grid.RowDefinitions>
                                                                        <DockPanel Grid.Row="0" Margin="0,0,0,8">
                                                                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                                                                                <ui:Button Content="🔄 ดึง Cookies &amp; Tokens ล่าสุด" Command="{Binding FetchSessionInfoCommand}" IsEnabled="{Binding IsRunning}" Padding="8,3" FontSize="11" Margin="0,0,8,0" />
                                                                                <TextBlock Text="{Binding SessionFetchStatus}" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="11" />
                                                                            </StackPanel>
                                                                        </DockPanel>

                                                                        <UniformGrid Grid.Row="1" Columns="2">
                                                                            <Border Background="{DynamicResource SurfaceStrokeColorDefaultBrush}" CornerRadius="4" Padding="8,6" Margin="0,0,4,0">
                                                                                <DockPanel>
                                                                                    <ui:Button DockPanel.Dock="Right" Content="📋" Command="{Binding CopySessionIdCommand}" Padding="6,2" FontSize="11" ToolTip="คัดลอก sessionid" />
                                                                                    <StackPanel>
                                                                                        <TextBlock Text="sessionid:" FontWeight="SemiBold" FontSize="11" />
                                                                                        <TextBlock Text="{Binding SessionIdToken}" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" FontSize="11" Margin="0,2,0,0" />
                                                                                    </StackPanel>
                                                                                </DockPanel>
                                                                            </Border>

                                                                            <Border Background="{DynamicResource SurfaceStrokeColorDefaultBrush}" CornerRadius="4" Padding="8,6" Margin="4,0,0,0">
                                                                                <DockPanel>
                                                                                    <ui:Button DockPanel.Dock="Right" Content="📋" Command="{Binding CopyCsrfTokenCommand}" Padding="6,2" FontSize="11" ToolTip="คัดลอก tt_csrf_token" />
                                                                                    <StackPanel>
                                                                                        <TextBlock Text="tt_csrf_token:" FontWeight="SemiBold" FontSize="11" />
                                                                                        <TextBlock Text="{Binding CsrfToken}" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" FontSize="11" Margin="0,2,0,0" />
                                                                                    </StackPanel>
                                                                                </DockPanel>
                                                                            </Border>
                                                                        </UniformGrid>
                                                                    </Grid>
                                                                </ui:Card>

                                                                <TextBlock Grid.Row="3" Text="💡 คำแนะนำ: เข้าสู่ระบบได้ง่ายๆ เพียงกดปุ่ม 'เปิดสตูดิโอเพื่อเข้าสู่ระบบ' จากนั้นใช้แอป TikTok บนมือถือสแกน QR Code บนหน้าจอตามปกติ หรือกด 'คัดลอก Session จากบัญชีหลัก' หากเคยล็อกอินในบัญชีหลักไว้แล้ว" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="11" TextWrapping="Wrap" />
                                                            </Grid>
                                                        </TabItem>

                                                        <!-- SUBTAB 1: SCRIPT EXECUTION CONSOLE -->
                                                        <TabItem Header="💻 รันสคริปต์ (CDP JavaScript Console)">
                                                            <Grid Margin="0,10,0,0">
                                                                <Grid.RowDefinitions>
                                                                    <RowDefinition Height="Auto" />
                                                                    <RowDefinition Height="Auto" />
                                                                    <RowDefinition Height="*" />
                                                                </Grid.RowDefinitions>

                                                                <!-- Notice if NOT running -->
                                                                <Border Grid.Row="0" Visibility="{Binding NotRunningVisibility}" Background="{DynamicResource CardStrokeColorDefaultBrush}" CornerRadius="6" Padding="12,8" Margin="0,0,0,8">
                                                                    <TextBlock Text="⚠️ หน้าต่างนี้ยังไม่ได้เปิดทำงาน (กรุณากดปุ่ม [Start] ที่ Quick Action ด้านบนก่อน จึงจะสามารถเชื่อมต่อและ Execute สคริปต์ CDP ได้)" Foreground="{DynamicResource SystemFillColorCautionBrush}" FontWeight="Medium" FontSize="12" />
                                                                </Border>

                                                                <!-- Script Input & Toolbar -->
                                                                <Grid Grid.Row="1" Margin="0,0,0,8">
                                                                    <Grid.RowDefinitions>
                                                                        <RowDefinition Height="Auto" />
                                                                        <RowDefinition Height="Auto" />
                                                                    </Grid.RowDefinitions>

                                                                    <ui:TextBox Grid.Row="0" Text="{Binding ScriptInput, UpdateSourceTrigger=PropertyChanged}" 
                                                                                PlaceholderText="พิมพ์โค้ด JavaScript เช่น window.location.href, document.title, fetch(...) ที่ต้องการรันในหน้าต่างนี้..." 
                                                                                MinHeight="55" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Margin="0,0,0,8" />

                                                                    <DockPanel Grid.Row="1" LastChildFill="False">
                                                                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                                                                            <ui:Button Appearance="Primary" Content="▶ รันสคริปต์" Command="{Binding ExecuteScriptCommand}" IsEnabled="{Binding IsRunning}" Margin="0,0,6,0" Padding="12,4" />
                                                                            <ui:Button Content="🌐 Export Full HTML" Command="{Binding ExportFullHtmlCommand}" IsEnabled="{Binding IsRunning}" Margin="0,0,6,0" Padding="10,4" ToolTip="ดึงและส่งออกโค้ด HTML ทั้งหมดของหน้าต่างนี้เป็นไฟล์ .html (Full DOM)" />
                                                                            <ui:Button Content="🗑️ ล้าง Console" Command="{Binding ClearConsoleCommand}" Margin="0,0,6,0" Padding="8,4" />
                                                                            <ui:Button Content="📋 คัดลอกผลลัพธ์" Command="{Binding CopyConsoleCommand}" Margin="0,0,10,0" Padding="8,4" />
                                                                        </StackPanel>

                                                                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                                                                            <TextBlock Text="คำสั่งด่วน:" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0" />
                                                                            <ui:Button Content="URL ปัจจุบัน" Command="{Binding SetScriptSnippetCommand}" CommandParameter="window.location.href" Padding="6,2" FontSize="11" Margin="0,0,4,0" />
                                                                            <ui:Button Content="Title หน้าเว็บ" Command="{Binding SetScriptSnippetCommand}" CommandParameter="document.title" Padding="6,2" FontSize="11" Margin="0,0,4,0" />
                                                                            <ui:Button Content="LocalStorage" Command="{Binding SetScriptSnippetCommand}" CommandParameter="JSON.stringify(window.localStorage)" Padding="6,2" FontSize="11" Margin="0,0,4,0" />
                                                                            <ui:Button Content="Full HTML" Command="{Binding SetScriptSnippetCommand}" CommandParameter="document.documentElement.outerHTML" Padding="6,2" FontSize="11" ToolTip="แทรกคำสั่ง document.documentElement.outerHTML" />
                                                                        </StackPanel>
                                                                    </DockPanel>
                                                                </Grid>

                                                                <!-- Terminal Console Output Box -->
                                                                <Border Grid.Row="2" Background="#121212" CornerRadius="6" Padding="6" BorderThickness="1" BorderBrush="#2A2A2A">
                                                                    <TextBox Text="{Binding ConsoleOutput}" IsReadOnly="True" 
                                                                             FontFamily="Consolas" FontSize="12" 
                                                                             Background="Transparent" Foreground="#39FF14" 
                                                                             BorderThickness="0" Height="130" 
                                                                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" />
                                                                </Border>
                                                            </Grid>
                                                        </TabItem>

                                                        <!-- SUBTAB 2: NETWORK MONITOR (REAL-TIME + SORT/SEARCH EACH COLUMN) -->
                                                        <TabItem Header="🌐 Network Monitor (API เรียลไทม์)">
                                                            <Grid Margin="0,10,0,0">
                                                                <Grid.RowDefinitions>
                                                                    <RowDefinition Height="Auto" />
                                                                    <RowDefinition Height="Auto" />
                                                                    <RowDefinition Height="180" />
                                                                    <RowDefinition Height="150" />
                                                                </Grid.RowDefinitions>

                                                                <!-- Notice if not running -->
                                                                <Border Grid.Row="0" Visibility="{Binding NotRunningVisibility}" Background="{DynamicResource CardStrokeColorDefaultBrush}" CornerRadius="6" Padding="12,8" Margin="0,0,0,8">
                                                                    <TextBlock Text="⚠️ หน้าต่างนี้ยังไม่ได้เปิดทำงาน (กรุณากดปุ่ม [Start] ด้านบนก่อน จึงจะสามารถดักจับ Network API ได้)" Foreground="{DynamicResource SystemFillColorCautionBrush}" FontWeight="Medium" FontSize="12" />
                                                                </Border>

                                                                <!-- Toolbar & Filter Row -->
                                                                <Grid Grid.Row="1" Margin="0,0,0,8">
                                                                    <Grid.RowDefinitions>
                                                                        <RowDefinition Height="Auto" />
                                                                        <RowDefinition Height="Auto" />
                                                                    </Grid.RowDefinitions>

                                                                    <!-- Top Action Row -->
                                                                    <DockPanel Grid.Row="0" Margin="0,0,0,6">
                                                                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                                                                            <ui:Button Appearance="Primary" Content="{Binding NetworkHookButtonText}" Command="{Binding ToggleNetworkHookCommand}" IsEnabled="{Binding IsRunning}" Margin="0,0,6,0" Padding="12,5" FontSize="11" />
                                                                            <Border Background="{DynamicResource SurfaceStrokeColorDefaultBrush}" CornerRadius="4" Padding="6,3" VerticalAlignment="Center" Margin="0,0,8,0">
                                                                                <TextBlock Text="{Binding NetworkHookBadgeText}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource SystemFillColorSuccessBrush}" />
                                                                            </Border>
                                                                            <ui:Button Content="🗑️ ล้างรายการ" Command="{Binding ClearTrafficCommand}" Margin="0,0,8,0" Padding="8,5" FontSize="11" />
                                                                            <TextBlock Text="{Binding NetworkTraffic.Count, StringFormat='ดักจับแล้ว: {0} รายการ'}" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="11" Margin="0,0,12,0" />
                                                                        </StackPanel>

                                                                        <!-- Global Fast Search Box -->
                                                                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                                                                            <ui:TextBox Text="{Binding NetworkSearchText, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="🔍 ค้นหาเร็วทุกคอลัมน์..." Width="220" Padding="8,4" FontSize="11" />
                                                                        </StackPanel>
                                                                    </DockPanel>

                                                                    <!-- Column-Specific Search & Filter Row -->
                                                                    <Border Grid.Row="1" Background="{DynamicResource SurfaceStrokeColorDefaultBrush}" CornerRadius="6" Padding="8,6" Margin="0,0,0,2">
                                                                        <DockPanel LastChildFill="True">
                                                                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                                                                                <TextBlock Text="ค้นหาแต่ละคอลัมน์:" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0" />

                                                                                <!-- Method Column Filter -->
                                                                                <TextBlock Text="Method:" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="11" VerticalAlignment="Center" Margin="0,0,4,0" />
                                                                                <ComboBox ItemsSource="{Binding MethodOptions}" SelectedItem="{Binding NetworkMethodFilter}" Width="85" FontSize="11" Margin="0,0,8,0" Padding="6,2" />

                                                                                <!-- Status Column Filter -->
                                                                                <TextBlock Text="Status:" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="11" VerticalAlignment="Center" Margin="0,0,4,0" />
                                                                                <ComboBox ItemsSource="{Binding StatusOptions}" SelectedItem="{Binding NetworkStatusFilter}" Width="120" FontSize="11" Margin="0,0,8,0" Padding="6,2" />

                                                                                <!-- URL Column Search -->
                                                                                <TextBlock Text="URL:" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="11" VerticalAlignment="Center" Margin="0,0,4,0" />
                                                                                <ui:TextBox Text="{Binding NetworkUrlFilter, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="🔍 กรองข้อความใน URL..." Width="200" FontSize="11" Margin="0,0,8,0" Padding="6,2" />

                                                                                <ui:Button Content="ล้างตัวกรอง" Command="{Binding ResetNetworkFiltersCommand}" FontSize="10" Padding="6,2" ToolTip="รีเซ็ตตัวกรองทั้งหมด" />
                                                                            </StackPanel>
                                                                        </DockPanel>
                                                                    </Border>
                                                                </Grid>

                                                                <!-- DataGrid (Real-time + Sortable Columns) -->
                                                                <DataGrid Grid.Row="2" ItemsSource="{Binding FilteredNetworkTraffic}" SelectedItem="{Binding SelectedTraffic}" 
                                                                          AutoGenerateColumns="False" CanUserAddRows="False" CanUserSortColumns="True" 
                                                                          HeadersVisibility="Column" GridLinesVisibility="Horizontal" Margin="0,0,0,8">
                                                                    <DataGrid.Columns>
                                                                        <DataGridTextColumn Header="เวลา" Binding="{Binding Time, StringFormat='HH:mm:ss'}" SortMemberPath="Time" Width="75" />
                                                                        <DataGridTextColumn Header="Method" Binding="{Binding Method}" SortMemberPath="Method" Width="65" FontWeight="SemiBold" />
                                                                        <DataGridTextColumn Header="สถานะ (Status)" Binding="{Binding StatusDisplay}" SortMemberPath="StatusCode" Width="105" />
                                                                        <DataGridTextColumn Header="เวลา (ms)" Binding="{Binding DurationMs}" SortMemberPath="DurationMs" Width="65" />
                                                                        <DataGridTextColumn Header="Type" Binding="{Binding ResourceType}" SortMemberPath="ResourceType" Width="70" />
                                                                        <DataGridTextColumn Header="URL" Binding="{Binding Url}" SortMemberPath="Url" Width="*" />
                                                                    </DataGrid.Columns>
                                                                </DataGrid>

                                                                <!-- Inspector Card for Selected Request -->
                                                                <ui:Card Grid.Row="3" Padding="8">
                                                                    <TabControl>
                                                                        <TabItem Header="Request Headers">
                                                                            <TextBox Text="{Binding SelectedTraffic.RequestHeaders, Mode=OneWay}" IsReadOnly="True" FontFamily="Consolas" FontSize="11" Background="Transparent" BorderThickness="0" VerticalScrollBarVisibility="Auto" />
                                                                        </TabItem>
                                                                        <TabItem Header="Request Cookies">
                                                                            <TextBox Text="{Binding SelectedTraffic.RequestCookies, Mode=OneWay}" IsReadOnly="True" FontFamily="Consolas" FontSize="11" Background="Transparent" BorderThickness="0" VerticalScrollBarVisibility="Auto" />
                                                                        </TabItem>
                                                                        <TabItem Header="Payload / PostData (JSON)">
                                                                            <DockPanel>
                                                                                <ui:Button DockPanel.Dock="Top" Content="📋 คัดลอก Payload" Command="{Binding CopyPayloadCommand}" HorizontalAlignment="Right" Margin="0,0,0,4" Padding="6,2" FontSize="10" />
                                                                                <TextBox Text="{Binding SelectedTraffic.PostData, Mode=OneWay}" IsReadOnly="True" FontFamily="Consolas" FontSize="11" Background="Transparent" BorderThickness="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" />
                                                                            </DockPanel>
                                                                        </TabItem>
                                                                        <TabItem Header="Response Headers">
                                                                            <TextBox Text="{Binding SelectedTraffic.ResponseHeaders, Mode=OneWay}" IsReadOnly="True" FontFamily="Consolas" FontSize="11" Background="Transparent" BorderThickness="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" />
                                                                        </TabItem>
                                                                        <TabItem Header="Response Body (JSON)">
                                                                            <DockPanel>
                                                                                <ui:Button DockPanel.Dock="Top" Content="📋 คัดลอก Response Body" Command="{Binding CopyResponseBodyCommand}" HorizontalAlignment="Right" Margin="0,0,0,4" Padding="6,2" FontSize="10" />
                                                                                <TextBox Text="{Binding SelectedTraffic.ResponseBody, Mode=OneWay}" IsReadOnly="True" FontFamily="Consolas" FontSize="11" Background="Transparent" BorderThickness="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" />
                                                                            </DockPanel>
                                                                        </TabItem>
                                                                    </TabControl>
                                                                </ui:Card>
                                                            </Grid>
                                                        </TabItem>

                                                        <!-- SUBTAB 3: COOKIES & STORAGE (REAL-TIME + SORT/SEARCH EACH COLUMN) -->
                                                        <TabItem Header="🍪 Cookies &amp; Storage (เรียลไทม์)">
                                                            <Grid Margin="0,10,0,0">
                                                                <Grid.RowDefinitions>
                                                                    <RowDefinition Height="Auto" />
                                                                    <RowDefinition Height="Auto" />
                                                                    <RowDefinition Height="*" />
                                                                </Grid.RowDefinitions>

                                                                <!-- Notice if not running -->
                                                                <Border Grid.Row="0" Visibility="{Binding NotRunningVisibility}" Background="{DynamicResource CardStrokeColorDefaultBrush}" CornerRadius="6" Padding="12,8" Margin="0,0,0,8">
                                                                    <TextBlock Text="⚠️ หน้าต่างนี้ยังไม่ได้เปิดทำงาน (กรุณากดปุ่ม [Start] ด้านบนก่อน จึงจะสามารถดึง Cookies &amp; Storage ได้)" Foreground="{DynamicResource SystemFillColorCautionBrush}" FontWeight="Medium" FontSize="12" />
                                                                </Border>

                                                                <!-- Top Bar with Actions and Real-time Auto-Refresh -->
                                                                <DockPanel Grid.Row="1" Margin="0,0,0,8">
                                                                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                                                                        <ui:Button Appearance="Primary" Content="🔄 ดึงข้อมูลล่าสุด (Fetch)" Command="{Binding FetchCookiesAndStorageCommand}" IsEnabled="{Binding IsRunning}" Margin="0,0,8,0" Padding="12,5" FontSize="11" />
                                                                        <CheckBox Content="⏱️ อัปเดตอัตโนมัติ Realtime (ทุก 3 วิ)" IsChecked="{Binding IsStorageAutoRefresh}" IsEnabled="{Binding IsRunning}" VerticalAlignment="Center" Margin="0,0,12,0" FontSize="11" />
                                                                        <ui:Button Content="📋 คัดลอก Cookie String ทั้งหมด" Command="{Binding CopyAllCookiesStringCommand}" Margin="0,0,12,0" Padding="8,5" FontSize="11" />
                                                                        <TextBlock Text="{Binding StorageStatus}" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="11" MaxWidth="350" TextTrimming="CharacterEllipsis" ToolTip="{Binding StorageStatus}" />
                                                                    </StackPanel>
                                                                </DockPanel>

                                                                <!-- Storage Subtabs -->
                                                                <TabControl Grid.Row="2">
                                                                    <!-- 1. Cookies -->
                                                                    <TabItem Header="🍪 Cookies">
                                                                        <Grid Margin="0,6,0,0">
                                                                            <Grid.RowDefinitions>
                                                                                <RowDefinition Height="Auto" />
                                                                                <RowDefinition Height="200" />
                                                                            </Grid.RowDefinitions>

                                                                            <!-- Filter Bar for Cookies -->
                                                                            <Border Grid.Row="0" Background="{DynamicResource SurfaceStrokeColorDefaultBrush}" CornerRadius="6" Padding="8,4" Margin="0,0,0,6">
                                                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                                    <TextBlock Text="ค้นหาแต่ละคอลัมน์:" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0" />
                                                                                    <TextBlock Text="ชื่อ:" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="11" VerticalAlignment="Center" Margin="0,0,4,0" />
                                                                                    <ui:TextBox Text="{Binding CookieNameFilter, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="🔍 กรองชื่อ..." Width="130" FontSize="11" Margin="0,0,8,0" Padding="6,2" />
                                                                                    <TextBlock Text="Domain:" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="11" VerticalAlignment="Center" Margin="0,0,4,0" />
                                                                                    <ui:TextBox Text="{Binding CookieDomainFilter, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="🔍 กรอง Domain..." Width="130" FontSize="11" Margin="0,0,8,0" Padding="6,2" />
                                                                                    <TextBlock Text="Value:" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="11" VerticalAlignment="Center" Margin="0,0,4,0" />
                                                                                    <ui:TextBox Text="{Binding CookieValueFilter, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="🔍 กรอง Value..." Width="150" FontSize="11" Margin="0,0,8,0" Padding="6,2" />
                                                                                    <ui:Button Content="ล้างตัวกรอง" Command="{Binding ResetCookieFiltersCommand}" FontSize="10" Padding="6,2" />
                                                                                </StackPanel>
                                                                            </Border>

                                                                            <!-- DataGrid Cookies -->
                                                                            <DataGrid Grid.Row="1" ItemsSource="{Binding FilteredCookies}" AutoGenerateColumns="False" CanUserAddRows="False" CanUserSortColumns="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal">
                                                                                <DataGrid.Columns>
                                                                                    <DataGridTextColumn Header="ชื่อ Cookie" Binding="{Binding Name}" SortMemberPath="Name" Width="160" FontWeight="SemiBold" />
                                                                                    <DataGridTextColumn Header="ค่า (Value)" Binding="{Binding Value}" SortMemberPath="Value" Width="*" />
                                                                                    <DataGridTextColumn Header="Domain" Binding="{Binding Domain}" SortMemberPath="Domain" Width="140" />
                                                                                    <DataGridTextColumn Header="Path" Binding="{Binding Path}" SortMemberPath="Path" Width="60" />
                                                                                    <DataGridCheckBoxColumn Header="HttpOnly" Binding="{Binding HttpOnly}" SortMemberPath="HttpOnly" Width="65" />
                                                                                    <DataGridCheckBoxColumn Header="Secure" Binding="{Binding Secure}" SortMemberPath="Secure" Width="60" />
                                                                                    <DataGridTemplateColumn Width="75">
                                                                                        <DataGridTemplateColumn.CellTemplate>
                                                                                            <DataTemplate>
                                                                                                <ui:Button Content="📋 ก๊อปปี้" Padding="6,2" FontSize="10" 
                                                                                                           Command="{Binding DataContext.CopyCookieValueCommand, RelativeSource={RelativeSource AncestorType=TabControl}}"
                                                                                                           CommandParameter="{Binding}" />
                                                                                            </DataTemplate>
                                                                                        </DataGridTemplateColumn.CellTemplate>
                                                                                    </DataGridTemplateColumn>
                                                                                </DataGrid.Columns>
                                                                            </DataGrid>
                                                                        </Grid>
                                                                    </TabItem>

                                                                    <!-- 2. LocalStorage -->
                                                                    <TabItem Header="💾 LocalStorage">
                                                                        <Grid Margin="0,6,0,0">
                                                                            <Grid.RowDefinitions>
                                                                                <RowDefinition Height="Auto" />
                                                                                <RowDefinition Height="200" />
                                                                            </Grid.RowDefinitions>

                                                                            <!-- Filter Bar for LocalStorage -->
                                                                            <Border Grid.Row="0" Background="{DynamicResource SurfaceStrokeColorDefaultBrush}" CornerRadius="6" Padding="8,4" Margin="0,0,0,6">
                                                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                                    <TextBlock Text="ค้นหาแต่ละคอลัมน์:" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0" />
                                                                                    <TextBlock Text="Key:" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="11" VerticalAlignment="Center" Margin="0,0,4,0" />
                                                                                    <ui:TextBox Text="{Binding StorageKeyFilter, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="🔍 กรอง Key (ชื่อตัวแปร)..." Width="180" FontSize="11" Margin="0,0,8,0" Padding="6,2" />
                                                                                    <TextBlock Text="Value:" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="11" VerticalAlignment="Center" Margin="0,0,4,0" />
                                                                                    <ui:TextBox Text="{Binding StorageValueFilter, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="🔍 กรอง Value (ค่า)..." Width="220" FontSize="11" Margin="0,0,8,0" Padding="6,2" />
                                                                                    <ui:Button Content="ล้างตัวกรอง" Command="{Binding ResetStorageFiltersCommand}" FontSize="10" Padding="6,2" />
                                                                                </StackPanel>
                                                                            </Border>

                                                                            <!-- DataGrid LocalStorage -->
                                                                            <DataGrid Grid.Row="1" ItemsSource="{Binding FilteredLocalStorage}" AutoGenerateColumns="False" CanUserAddRows="False" CanUserSortColumns="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal">
                                                                                <DataGrid.Columns>
                                                                                    <DataGridTextColumn Header="Key (ชื่อตัวแปร)" Binding="{Binding Key}" SortMemberPath="Key" Width="220" FontWeight="SemiBold" />
                                                                                    <DataGridTextColumn Header="Value (ค่าใน Storage)" Binding="{Binding Value}" SortMemberPath="Value" Width="*" />
                                                                                    <DataGridTemplateColumn Width="75">
                                                                                        <DataGridTemplateColumn.CellTemplate>
                                                                                            <DataTemplate>
                                                                                                <ui:Button Content="📋 ก๊อปปี้" Padding="6,2" FontSize="10" 
                                                                                                           Command="{Binding DataContext.CopyStorageItemCommand, RelativeSource={RelativeSource AncestorType=TabControl}}"
                                                                                                           CommandParameter="{Binding}" />
                                                                                            </DataTemplate>
                                                                                        </DataGridTemplateColumn.CellTemplate>
                                                                                    </DataGridTemplateColumn>
                                                                                </DataGrid.Columns>
                                                                            </DataGrid>
                                                                        </Grid>
                                                                    </TabItem>

                                                                    <!-- 3. SessionStorage -->
                                                                    <TabItem Header="📦 SessionStorage">
                                                                        <Grid Margin="0,6,0,0">
                                                                            <Grid.RowDefinitions>
                                                                                <RowDefinition Height="Auto" />
                                                                                <RowDefinition Height="200" />
                                                                            </Grid.RowDefinitions>

                                                                            <!-- Filter Bar for SessionStorage -->
                                                                            <Border Grid.Row="0" Background="{DynamicResource SurfaceStrokeColorDefaultBrush}" CornerRadius="6" Padding="8,4" Margin="0,0,0,6">
                                                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                                    <TextBlock Text="ค้นหาแต่ละคอลัมน์:" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0" />
                                                                                    <TextBlock Text="Key:" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="11" VerticalAlignment="Center" Margin="0,0,4,0" />
                                                                                    <ui:TextBox Text="{Binding StorageKeyFilter, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="🔍 กรอง Key (ชื่อตัวแปร)..." Width="180" FontSize="11" Margin="0,0,8,0" Padding="6,2" />
                                                                                    <TextBlock Text="Value:" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="11" VerticalAlignment="Center" Margin="0,0,4,0" />
                                                                                    <ui:TextBox Text="{Binding StorageValueFilter, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="🔍 กรอง Value (ค่า)..." Width="220" FontSize="11" Margin="0,0,8,0" Padding="6,2" />
                                                                                    <ui:Button Content="ล้างตัวกรอง" Command="{Binding ResetStorageFiltersCommand}" FontSize="10" Padding="6,2" />
                                                                                </StackPanel>
                                                                            </Border>

                                                                            <!-- DataGrid SessionStorage -->
                                                                            <DataGrid Grid.Row="1" ItemsSource="{Binding FilteredSessionStorage}" AutoGenerateColumns="False" CanUserAddRows="False" CanUserSortColumns="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal">
                                                                                <DataGrid.Columns>
                                                                                    <DataGridTextColumn Header="Key (ชื่อตัวแปร)" Binding="{Binding Key}" SortMemberPath="Key" Width="220" FontWeight="SemiBold" />
                                                                                    <DataGridTextColumn Header="Value (ค่าใน Storage)" Binding="{Binding Value}" SortMemberPath="Value" Width="*" />
                                                                                    <DataGridTemplateColumn Width="75">
                                                                                        <DataGridTemplateColumn.CellTemplate>
                                                                                            <DataTemplate>
                                                                                                <ui:Button Content="📋 ก๊อปปี้" Padding="6,2" FontSize="10" 
                                                                                                           Command="{Binding DataContext.CopyStorageItemCommand, RelativeSource={RelativeSource AncestorType=TabControl}}"
                                                                                                           CommandParameter="{Binding}" />
                                                                                            </DataTemplate>
                                                                                        </DataGridTemplateColumn.CellTemplate>
                                                                                    </DataGridTemplateColumn>
                                                                                </DataGrid.Columns>
                                                                            </DataGrid>
                                                                        </Grid>
                                                                    </TabItem>
                                                                </TabControl>
                                                            </Grid>
                                                        </TabItem>

                                                        <!-- SUBTAB 4: CAPTCHA RADAR & INSPECTOR -->
                                                        <TabItem Header="🧩 ตรวจจับ Captcha (Captcha Radar)">
                                                            <Grid Margin="0,10,0,0">
                                                                <Grid.RowDefinitions>
                                                                    <RowDefinition Height="Auto" />
                                                                    <RowDefinition Height="Auto" />
                                                                    <RowDefinition Height="160" />
                                                                    <RowDefinition Height="Auto" />
                                                                    <RowDefinition Height="180" />
                                                                </Grid.RowDefinitions>

                                                                <!-- Notice if not running -->
                                                                <Border Grid.Row="0" Visibility="{Binding NotRunningVisibility}" Background="{DynamicResource CardStrokeColorDefaultBrush}" CornerRadius="6" Padding="12,8" Margin="0,0,0,8">
                                                                    <TextBlock Text="⚠️ หน้าต่างนี้ยังไม่ได้เปิดทำงาน (กรุณากดปุ่ม [Start] ด้านบนก่อน จึงจะสามารถเชื่อมต่อและสแกนหา Captcha ใน DOM ได้)" Foreground="{DynamicResource SystemFillColorCautionBrush}" FontWeight="Medium" FontSize="12" />
                                                                </Border>

                                                                <!-- Radar Control Toolbar -->
                                                                <Border Grid.Row="1" Background="{DynamicResource SurfaceStrokeColorDefaultBrush}" CornerRadius="6" Padding="10,8" Margin="0,0,0,8">
                                                                    <DockPanel LastChildFill="True">
                                                                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                                                                            <!-- Radar Live Indicator Badge -->
                                                                            <Border CornerRadius="4" Padding="8,3" Margin="0,0,10,0">
                                                                                <Border.Style>
                                                                                    <Style TargetType="Border">
                                                                                        <Setter Property="Background" Value="#333333" />
                                                                                        <Style.Triggers>
                                                                                            <DataTrigger Binding="{Binding IsCaptchaAlertVisible}" Value="True">
                                                                                                <Setter Property="Background" Value="#DC2626" />
                                                                                            </DataTrigger>
                                                                                            <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                                                                <Setter Property="Background" Value="#10B981" />
                                                                                            </DataTrigger>
                                                                                        </Style.Triggers>
                                                                                    </Style>
                                                                                </Border.Style>
                                                                                <TextBlock FontWeight="Bold" FontSize="11" Foreground="White">
                                                                                    <TextBlock.Style>
                                                                                        <Style TargetType="TextBlock">
                                                                                            <Setter Property="Text" Value="⚪ สถานะ: ยังไม่เริ่มทำงาน" />
                                                                                            <Style.Triggers>
                                                                                                <DataTrigger Binding="{Binding IsCaptchaAlertVisible}" Value="True">
                                                                                                    <Setter Property="Text" Value="🚨 RADAR ALERT: ตรวจพบ CAPTCHA!" />
                                                                                                </DataTrigger>
                                                                                                <MultiDataTrigger>
                                                                                                    <MultiDataTrigger.Conditions>
                                                                                                        <Condition Binding="{Binding IsRunning}" Value="True" />
                                                                                                        <Condition Binding="{Binding IsCaptchaAlertVisible}" Value="False" />
                                                                                                    </MultiDataTrigger.Conditions>
                                                                                                    <Setter Property="Text" Value="🟢 Radar เฝ้าระวังปกติ (ไม่พบ Captcha)" />
                                                                                                </MultiDataTrigger>
                                                                                            </Style.Triggers>
                                                                                        </Style>
                                                                                    </TextBlock.Style>
                                                                                </TextBlock>
                                                                            </Border>

                                                                            <ui:Button Appearance="Primary" Content="🔍 สแกนเดี๋ยวนี้" Command="{Binding ScanCaptchaNowCommand}" IsEnabled="{Binding IsRunning}" Margin="0,0,6,0" Padding="10,4" ToolTip="ส่งคำสั่งตรวจสอบ DOM และ iframes ทันทีเพื่อหา Captcha elements" />
                                                                            <ui:Button Appearance="Caution" Content="📋 คัดลอก Full HTML ทั้งหมด" Command="{Binding CopyCaptchaHtmlCommand}" IsEnabled="{Binding IsRunning}" Margin="0,0,6,0" Padding="10,4" ToolTip="คัดลอก Full HTML ของหน้าต่างที่มี Captcha ลง Clipboard" />
                                                                            <ui:Button Content="💾 Export ไฟล์" Command="{Binding ExportCaptchaHtmlCommand}" Margin="0,0,6,0" Padding="8,4" ToolTip="บันทึกโค้ด Full HTML ออกมาเป็นไฟล์ .html" />
                                                                            <ui:Button Content="🗑️ ล้างผลลัพธ์" Command="{Binding ClearCaptchaResultsCommand}" Margin="0,0,10,0" Padding="8,4" />
                                                                        </StackPanel>

                                                                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                                                                            <CheckBox Content="⏱️ Auto Detect ทุก 5 วิ" IsChecked="{Binding IsCaptchaAutoDetect}" VerticalAlignment="Center" Margin="0,0,8,0" ToolTip="สแกนอัตโนมัติทุกๆ 5 วินาทีขณะที่หน้าต่างเปิดอยู่" />
                                                                            <CheckBox Content="⚡ Auto Copy ลง Clipboard ทันที" IsChecked="{Binding AutoCopyToClipboardOnDetect}" VerticalAlignment="Center" Margin="0,0,4,0" ToolTip="เมื่อตรวจพบ Captcha ให้คัดลอกโค้ด HTML ลง Clipboard ให้เองทันที" />
                                                                        </StackPanel>
                                                                    </DockPanel>
                                                                </Border>

                                                                <!-- Elements Table -->
                                                                <DataGrid Grid.Row="2" ItemsSource="{Binding DetectedCaptchaElements}" SelectedItem="{Binding SelectedCaptchaElement}"
                                                                          AutoGenerateColumns="False" CanUserAddRows="False" CanUserSortColumns="True"
                                                                          HeadersVisibility="Column" GridLinesVisibility="Horizontal" Margin="0,0,0,8"
                                                                          FontFamily="Consolas" FontSize="11">
                                                                    <DataGrid.Columns>
                                                                        <DataGridTextColumn Header="Tag" Binding="{Binding TagName}" Width="70" FontWeight="Bold" />
                                                                        <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="160" />
                                                                        <DataGridTextColumn Header="Class" Binding="{Binding ClassName}" Width="180" />
                                                                        <DataGridTextColumn Header="Layer (Depth)" Binding="{Binding Depth, StringFormat='Depth {0}'}" Width="95" />
                                                                        <DataGridTextColumn Header="Frame URL" Binding="{Binding FrameUrl}" Width="170" />
                                                                        <DataGridTemplateColumn Header="การดำเนินการ" Width="*">
                                                                            <DataGridTemplateColumn.CellTemplate>
                                                                                <DataTemplate>
                                                                                    <ui:Button Content="📋 คัดลอก Element นี้" 
                                                                                               Command="{Binding DataContext.CopyElementHtmlCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" 
                                                                                               CommandParameter="{Binding}" Padding="8,2" FontSize="10" />
                                                                                </DataTemplate>
                                                                            </DataGridTemplateColumn.CellTemplate>
                                                                        </DataGridTemplateColumn>
                                                                    </DataGrid.Columns>
                                                                </DataGrid>

                                                                <!-- Title Bar for HTML Inspector -->
                                                                <DockPanel Grid.Row="3" Margin="0,0,0,4">
                                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                        <TextBlock Text="โค้ด Full HTML ของหน้าที่มี Captcha:" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                                                    </StackPanel>
                                                                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                                                                        <TextBlock Text="{Binding DetectedCaptchaCount, StringFormat='พบ {0} รายการ'}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                                                        <TextBlock Text="{Binding LastCaptchaDetectedTime, StringFormat='เวลา: {0}'}" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                                                        <ui:Button Content="📋 คัดลอกโค้ดนี้" Command="{Binding CopyDetectedCaptchaCommand}" Padding="6,2" FontSize="10" />
                                                                    </StackPanel>
                                                                </DockPanel>

                                                                <!-- HTML Code Box -->
                                                                <Border Grid.Row="4" Background="#121212" CornerRadius="6" Padding="6" BorderThickness="1" BorderBrush="#2A2A2A">
                                                                    <TextBox Text="{Binding DetectedCaptchaHtml, Mode=OneWay}" IsReadOnly="True"
                                                                             FontFamily="Consolas" FontSize="12"
                                                                             Background="Transparent" Foreground="#F59E0B"
                                                                             BorderThickness="0"
                                                                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" />
                                                                </Border>
                                                            </Grid>
                                                        </TabItem>

                                                        <!-- SUBTAB 5: DEBUG LOG (PER ACCOUNT) -->
                                                        <TabItem Header="📋 บันทึกดีบัก (Debug Log)">
                                                            <Grid Margin="0,10,0,0">
                                                                <Grid.RowDefinitions>
                                                                    <RowDefinition Height="Auto" />
                                                                    <RowDefinition Height="Auto" />
                                                                    <RowDefinition Height="200" />
                                                                    <RowDefinition Height="Auto" />
                                                                </Grid.RowDefinitions>

                                                                <!-- Top Action Bar -->
                                                                <DockPanel Grid.Row="0" Margin="0,0,0,6">
                                                                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                                                                        <ui:Button Content="🗑️ ล้าง Log" Command="{Binding ClearLogsCommand}" Margin="0,0,6,0" Padding="8,4" FontSize="11" />
                                                                        <ui:Button Content="📋 คัดลอกทั้งหมด" Command="{Binding CopyAllLogsCommand}" Margin="0,0,6,0" Padding="8,4" FontSize="11" />
                                                                        <ui:Button Content="📄 เปิดไฟล์ Log" Command="{Binding OpenLogFileCommand}" Margin="0,0,6,0" Padding="8,4" FontSize="11" ToolTip="เปิดไฟล์ .log ของบัญชีนี้โดยตรง" />
                                                                        <ui:Button Content="📁 โฟลเดอร์ Log" Command="{Binding OpenLogsFolderCommand}" Margin="0,0,10,0" Padding="8,4" FontSize="11" ToolTip="เปิดโฟลเดอร์เก็บไฟล์ Log ทั้งหมด" />
                                                                        <TextBlock Text="{Binding LogCountSummary}" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="11" />
                                                                    </StackPanel>

                                                                    <!-- Search box -->
                                                                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                                                                        <ui:TextBox Text="{Binding LogSearchText, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="🔍 ค้นหาใน Log..." Width="200" Padding="8,4" FontSize="11" />
                                                                    </StackPanel>
                                                                </DockPanel>

                                                                <!-- Filter Row -->
                                                                <Border Grid.Row="1" Background="{DynamicResource SurfaceStrokeColorDefaultBrush}" CornerRadius="6" Padding="8,6" Margin="0,0,0,6">
                                                                    <DockPanel LastChildFill="True">
                                                                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                                                                            <TextBlock Text="ระดับ (Level):" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="11" VerticalAlignment="Center" Margin="0,0,4,0" />
                                                                            <ComboBox ItemsSource="{Binding LogLevelOptions}" SelectedItem="{Binding LogLevelFilter}" Width="95" FontSize="11" Margin="0,0,10,0" Padding="6,2" />

                                                                            <TextBlock Text="หมวดหมู่:" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="11" VerticalAlignment="Center" Margin="0,0,4,0" />
                                                                            <ComboBox ItemsSource="{Binding LogCategoryOptions}" SelectedItem="{Binding LogCategoryFilter}" Width="105" FontSize="11" Margin="0,0,10,0" Padding="6,2" />

                                                                            <ui:Button Content="ล้างตัวกรอง" Command="{Binding ResetLogFiltersCommand}" FontSize="10" Padding="6,2" ToolTip="รีเซ็ตตัวกรองทั้งหมด" />
                                                                        </StackPanel>

                                                                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                                                                            <TextBlock Text="{Binding LogFilePath, StringFormat='ไฟล์: {0}'}" FontSize="10" Foreground="{DynamicResource TextFillColorTertiaryBrush}" MaxWidth="280" TextTrimming="CharacterEllipsis" ToolTip="{Binding LogFilePath}" />
                                                                        </StackPanel>
                                                                    </DockPanel>
                                                                </Border>

                                                                <!-- Log List DataGrid -->
                                                                <DataGrid Grid.Row="2" ItemsSource="{Binding FilteredLogs}" SelectedItem="{Binding SelectedLog}"
                                                                          AutoGenerateColumns="False" CanUserAddRows="False" CanUserSortColumns="True"
                                                                          HeadersVisibility="Column" GridLinesVisibility="Horizontal" Margin="0,0,0,6"
                                                                          FontFamily="Consolas" FontSize="11">
                                                                    <DataGrid.Columns>
                                                                        <DataGridTextColumn Header="เวลา" Binding="{Binding FormattedTime}" SortMemberPath="Timestamp" Width="85" />
                                                                        <DataGridTemplateColumn Header="ระดับ" SortMemberPath="Level" Width="70">
                                                                            <DataGridTemplateColumn.CellTemplate>
                                                                                <DataTemplate>
                                                                                    <Border CornerRadius="3" Padding="4,1" HorizontalAlignment="Left">
                                                                                        <Border.Style>
                                                                                            <Style TargetType="Border">
                                                                                                <Setter Property="Background" Value="#333333" />
                                                                                                <Style.Triggers>
                                                                                                    <DataTrigger Binding="{Binding LevelDisplay}" Value="DEBUG">
                                                                                                        <Setter Property="Background" Value="#444444" />
                                                                                                    </DataTrigger>
                                                                                                    <DataTrigger Binding="{Binding LevelDisplay}" Value="INFO">
                                                                                                        <Setter Property="Background" Value="#0284C7" />
                                                                                                    </DataTrigger>
                                                                                                    <DataTrigger Binding="{Binding LevelDisplay}" Value="WARN">
                                                                                                        <Setter Property="Background" Value="#D97706" />
                                                                                                    </DataTrigger>
                                                                                                    <DataTrigger Binding="{Binding LevelDisplay}" Value="ERROR">
                                                                                                        <Setter Property="Background" Value="#DC2626" />
                                                                                                    </DataTrigger>
                                                                                                </Style.Triggers>
                                                                                            </Style>
                                                                                        </Border.Style>
                                                                                        <TextBlock Text="{Binding LevelDisplay}" FontWeight="SemiBold" FontSize="10" Foreground="White" />
                                                                                    </Border>
                                                                                </DataTemplate>
                                                                            </DataGridTemplateColumn.CellTemplate>
                                                                        </DataGridTemplateColumn>
                                                                        <DataGridTextColumn Header="หมวดหมู่" Binding="{Binding Category}" SortMemberPath="Category" Width="90" FontWeight="SemiBold" />
                                                                        <DataGridTextColumn Header="ข้อความดีบัก" Binding="{Binding Message}" Width="*" />
                                                                    </DataGrid.Columns>
                                                                </DataGrid>

                                                                <!-- Selected Log Inspector Card -->
                                                                <Border Grid.Row="3" Background="#141414" CornerRadius="4" Padding="8" BorderThickness="1" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" Visibility="{Binding SelectedLogDetailsVisibility}">
                                                                    <DockPanel>
                                                                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                                                                            <TextBlock Text="รายละเอียดข้อความ / Stack Trace:" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                                                            <ui:Button DockPanel.Dock="Right" Content="📋 คัดลอกข้อความนี้" Command="{Binding CopySelectedLogCommand}" HorizontalAlignment="Right" Padding="6,2" FontSize="10" />
                                                                        </DockPanel>
                                                                        <TextBox Text="{Binding SelectedLogFullText, Mode=OneWay}" IsReadOnly="True"
                                                                                 FontFamily="Consolas" FontSize="11" Background="Transparent" Foreground="#E0E0E0"
                                                                                 BorderThickness="0" MaxHeight="80" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" />
                                                                    </DockPanel>
                                                                </Border>
                                                            </Grid>
                                                        </TabItem>

                                                        <!-- SUBTAB 6: LIVE CHAT TEST -->
                                                        <TabItem Header="💬 ทดสอบส่งแชทสด (CDP Chat)">
                                                            <Grid Margin="0,10,0,0">
                                                                <Grid.RowDefinitions>
                                                                    <RowDefinition Height="Auto" />
                                                                    <RowDefinition Height="Auto" />
                                                                </Grid.RowDefinitions>

                                                                <TextBlock Grid.Row="0" Text="ทดสอบส่งข้อความเข้า TikTok LIVE Studio ของบัญชีนี้โดยตรงผ่าน CDP:" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,8" />

                                                                <Grid Grid.Row="1">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="Auto" />
                                                                        <ColumnDefinition Width="Auto" />
                                                                    </Grid.ColumnDefinitions>

                                                                    <ui:TextBox Grid.Column="0" Text="{Binding TestChatMessage, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="พิมพ์ข้อความที่ต้องการทดสอบส่งเข้า TikTok LIVE Studio..." Margin="0,0,8,0" />
                                                                    <ui:Button Grid.Column="1" Appearance="Primary" Content="ส่งแชท (Send)" Command="{Binding SendTestChatCommand}" IsEnabled="{Binding IsRunning}" Margin="0,0,10,0" />
                                                                    <TextBlock Grid.Column="2" Text="{Binding ChatStatusText}" VerticalAlignment="Center" FontWeight="Medium" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                                                </Grid>
                                                            </Grid>
                                                        </TabItem>
                                                    </TabControl>
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                    </ui:Card>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <!-- TAB 2: CAPTCHA RADAR HUB (ศูนย์ตรวจจับ Captcha รวม) -->
            <TabItem Header="🧩 ศูนย์ตรวจจับ Captcha (Captcha Center)">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <DockPanel Grid.Row="0" Margin="0,0,0,10">
                        <StackPanel DockPanel.Dock="Left">
                            <TextBlock Text="ศูนย์กลางเฝ้าระวังและตรวจจับ Captcha (Multi-Account Captcha Hub)" FontSize="16" FontWeight="SemiBold" />
                            <TextBlock Text="เฝ้าระวัง Captcha ทุกหน้าต่างอัตโนมัติ เพื่อดึง Full HTML ของหน้าและ iframe ไปวิเคราะห์ได้ทันที" 
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,4,0,0" />
                        </StackPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <ui:Button Appearance="Primary" Content="🔍 สแกนทุกบัญชีเดี๋ยวนี้ (Scan All)" Command="{Binding ScanAllCaptchasCommand}" Padding="14,6" />
                        </StackPanel>
                    </DockPanel>

                    <!-- Main Split View: Left Account List, Right Inspector -->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="340" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Left Column: Accounts List -->
                        <Border Grid.Column="0" Background="{DynamicResource SurfaceStrokeColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="10">
                            <DockPanel LastChildFill="True">
                                <TextBlock DockPanel.Dock="Top" Text="รายชื่อบัญชี &amp; สถานะ Captcha" FontWeight="SemiBold" FontSize="13" Margin="4,0,0,8" />

                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <ListBox ItemsSource="{Binding Instances}" SelectedItem="{Binding SelectedCaptchaInstance}" SelectedIndex="0"
                                                 Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch">
                                            <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{DynamicResource CardStrokeColorDefaultBrush}" CornerRadius="6" Padding="10,8" Margin="0,0,0,6">
                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                        </Grid.RowDefinitions>

                                                        <!-- Row 0: Name & Port -->
                                                        <DockPanel Grid.Row="0" LastChildFill="True">
                                                            <Border DockPanel.Dock="Right" Background="{DynamicResource AccentFillColorTertiaryBrush}" CornerRadius="4" Padding="5,1">
                                                                <TextBlock Text="{Binding CdpPort, StringFormat=':{0}'}" FontSize="10" FontWeight="SemiBold" />
                                                            </Border>
                                                            <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="12" />
                                                        </DockPanel>

                                                        <!-- Row 1: Radar Status Badge -->
                                                        <Border Grid.Row="1" CornerRadius="4" Padding="6,2" Margin="0,6,0,6" HorizontalAlignment="Left">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Background" Value="#333333" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsCaptchaAlertVisible}" Value="True">
                                                                            <Setter Property="Background" Value="#DC2626" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                                            <Setter Property="Background" Value="#10B981" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <TextBlock FontSize="10" FontWeight="Bold" Foreground="White">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Text" Value="⚪ ออฟไลน์" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsCaptchaAlertVisible}" Value="True">
                                                                                <Setter Property="Text" Value="{Binding DetectedCaptchaCount, StringFormat='🚨 ตรวจพบ Captcha ({0} รายการ)'}" />
                                                                            </DataTrigger>
                                                                            <MultiDataTrigger>
                                                                                <MultiDataTrigger.Conditions>
                                                                                    <Condition Binding="{Binding IsRunning}" Value="True" />
                                                                                    <Condition Binding="{Binding IsCaptchaAlertVisible}" Value="False" />
                                                                                </MultiDataTrigger.Conditions>
                                                                                <Setter Property="Text" Value="🟢 Radar ปกติ (ไม่พบ Captcha)" />
                                                                            </MultiDataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </Border>

                                                        <!-- Row 2: Quick Action Buttons -->
                                                        <StackPanel Grid.Row="2" Orientation="Horizontal">
                                                            <ui:Button Content="🔍 สแกน" Command="{Binding ScanCaptchaNowCommand}" IsEnabled="{Binding IsRunning}" Padding="6,2" FontSize="10" Margin="0,0,4,0" />
                                                            <ui:Button Appearance="Caution" Content="📋 คัดลอก Full HTML" Command="{Binding CopyDetectedCaptchaCommand}" IsEnabled="{Binding IsCaptchaAlertVisible}" Padding="6,2" FontSize="10" Margin="0,0,4,0" />
                                                            <ui:Button Content="💾 Export" Command="{Binding ExportCaptchaHtmlCommand}" IsEnabled="{Binding IsCaptchaAlertVisible}" Padding="6,2" FontSize="10" />
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </ScrollViewer>
                            </DockPanel>
                        </Border>

                        <!-- Right Column: Detail Inspector for Selected Account -->
                        <Border Grid.Column="2" Background="{DynamicResource SurfaceStrokeColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="14">
                            <Grid>
                                <!-- State 1: When No Account is Selected -->
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="{Binding NoSelectedCaptchaVisibility}">
                                    <TextBlock Text="👈 กรุณาคลิกเลือกบัญชีจากรายชื่อทางด้านซ้ายมือ" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Text="เพื่อดูรายการ Captcha Elements และโค้ด Full HTML ตัวเต็มของบัญชีนั้น" FontSize="12" HorizontalAlignment="Center" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,6,0,0" />
                                </StackPanel>

                                <!-- State 2: When an Account is Selected -->
                                <Grid DataContext="{Binding SelectedCaptchaInstance}" Visibility="{Binding DataContext.HasSelectedCaptchaVisibility, RelativeSource={RelativeSource AncestorType=TabItem}}">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="180" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <!-- Top Toolbar of Selected Account -->
                                    <DockPanel Grid.Row="0" Margin="0,0,0,10">
                                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name, StringFormat='บัญชี: {0}'}" FontWeight="Bold" FontSize="14" Margin="0,0,8,0" />
                                            <Border Background="{DynamicResource AccentFillColorDefaultBrush}" CornerRadius="4" Padding="6,2" Margin="0,0,10,0">
                                                <TextBlock Text="{Binding CdpPort, StringFormat='CDP Target: 127.0.0.1:{0}'}" FontSize="11" Foreground="White" />
                                            </Border>
                                            <ui:Button Appearance="Primary" Content="🔍 สแกนเดี๋ยวนี้" Command="{Binding ScanCaptchaNowCommand}" IsEnabled="{Binding IsRunning}" Margin="0,0,6,0" Padding="10,4" />
                                            <ui:Button Appearance="Caution" Content="📋 คัดลอก Full HTML ทั้งหมด" Command="{Binding CopyCaptchaHtmlCommand}" IsEnabled="{Binding IsRunning}" Margin="0,0,6,0" Padding="10,4" />
                                            <ui:Button Content="💾 Export ไฟล์ .html" Command="{Binding ExportCaptchaHtmlCommand}" Margin="0,0,6,0" Padding="8,4" />
                                            <ui:Button Content="🗑️ ล้างผลลัพธ์" Command="{Binding ClearCaptchaResultsCommand}" Margin="0,0,10,0" Padding="8,4" />
                                        </StackPanel>

                                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                                            <CheckBox Content="⏱️ Auto Detect ทุก 5 วิ" IsChecked="{Binding IsCaptchaAutoDetect}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                            <CheckBox Content="⚡ Auto Copy ทันที" IsChecked="{Binding AutoCopyToClipboardOnDetect}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </DockPanel>

                                    <!-- Elements DataGrid -->
                                    <DataGrid Grid.Row="1" ItemsSource="{Binding DetectedCaptchaElements}" SelectedItem="{Binding SelectedCaptchaElement}"
                                              AutoGenerateColumns="False" CanUserAddRows="False" CanUserSortColumns="True"
                                              HeadersVisibility="Column" GridLinesVisibility="Horizontal" Margin="0,0,0,10"
                                              FontFamily="Consolas" FontSize="11">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Tag" Binding="{Binding TagName}" Width="70" FontWeight="Bold" />
                                            <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="160" />
                                            <DataGridTextColumn Header="Class" Binding="{Binding ClassName}" Width="190" />
                                            <DataGridTextColumn Header="Layer (Depth)" Binding="{Binding Depth, StringFormat='Depth {0}'}" Width="95" />
                                            <DataGridTextColumn Header="Frame URL" Binding="{Binding FrameUrl}" Width="180" />
                                            <DataGridTemplateColumn Header="การดำเนินการ" Width="*">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <ui:Button Content="📋 คัดลอก Element นี้" 
                                                                   Command="{Binding DataContext.CopyElementHtmlCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" 
                                                                   CommandParameter="{Binding}" Padding="8,2" FontSize="10" />
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>

                                    <!-- HTML Preview Header -->
                                    <DockPanel Grid.Row="2" Margin="0,0,0,6">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="โค้ด Full HTML ของหน้าที่มี Captcha:" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                                            <TextBlock Text="{Binding DetectedCaptchaCount, StringFormat='พบ {0} รายการ'}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                            <TextBlock Text="{Binding LastCaptchaDetectedTime, StringFormat='เวลา: {0}'}" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                            <ui:Button Content="📋 คัดลอกโค้ดนี้" Command="{Binding CopyDetectedCaptchaCommand}" Padding="8,2" FontSize="11" />
                                        </StackPanel>
                                    </DockPanel>

                                    <!-- Code Viewer -->
                                    <Border Grid.Row="3" Background="#121212" CornerRadius="6" Padding="8" BorderThickness="1" BorderBrush="#2A2A2A">
                                        <TextBox Text="{Binding DetectedCaptchaHtml, Mode=OneWay}" IsReadOnly="True"
                                                 FontFamily="Consolas" FontSize="12"
                                                 Background="Transparent" Foreground="#F59E0B"
                                                 BorderThickness="0"
                                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" />
                                    </Border>
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- Footer Note -->
                    <ui:Card Grid.Row="3" Margin="0,12,0,0" Padding="12">
                        <TextBlock Text="💡 การทำงานของระบบตรวจจับ Captcha: ระบบจะสแกน DOM และ iframes เพื่อค้นหา Element ที่มี ID, Class หรือ Attribute เกี่ยวกับ Captcha โดยอัตโนมัติ และจะทำการดึงโครงสร้าง Full HTML ของหน้าต่างและ iframe ที่มี Captcha มาให้ทั้งหมด เพื่อให้นำไปเปิดดูหรือวิเคราะห์โครงสร้างได้อย่างสมบูรณ์" 
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                    </ui:Card>
                </Grid>
            </TabItem>

            <!-- TAB 3: NETWORK & PROXIFIER -->
            <TabItem Header="🛡️ เครือข่าย &amp; Proxy (Proxifier)">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,12">
                        <StackPanel DockPanel.Dock="Left">
                            <TextBlock Text="การแยกทราฟฟิกด้วย Proxifier (100% Isolation)" FontSize="16" FontWeight="SemiBold" />
                            <TextBlock Text="บังคับให้ทั้ง Web Traffic และ RTMP/UDP Video Stream ออกผ่าน Proxy ของตัวเองเพื่อป้องกันการโดนแบนกลุ่ม" 
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,4,0,0" />
                        </StackPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <ui:Button Content="+ เพิ่ม Proxy" Command="{Binding AddProxyCommand}" Margin="0,0,8,0" />
                            <ui:Button Appearance="Primary" Content="สร้างกฎ XML และโหลดเข้า Proxifier" Command="{Binding LaunchProxifierCommand}" />
                        </StackPanel>
                    </DockPanel>

                    <!-- Proxies List -->
                    <DataGrid Grid.Row="1" ItemsSource="{Binding Proxies}" AutoGenerateColumns="False" 
                              CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ชื่อ Proxy" Binding="{Binding Name}" Width="150" />
                            <DataGridTextColumn Header="โพรโทคอล" Binding="{Binding Protocol}" Width="100" />
                            <DataGridTextColumn Header="Host / IP" Binding="{Binding Host}" Width="180" />
                            <DataGridTextColumn Header="Port" Binding="{Binding Port}" Width="80" />
                            <DataGridTextColumn Header="Username" Binding="{Binding Username}" Width="120" />
                            <DataGridTextColumn Header="Proxifier ID" Binding="{Binding ProxifierId}" Width="100" />
                            <DataGridCheckBoxColumn Header="เปิดใช้งาน" Binding="{Binding IsActive}" Width="90" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <ui:Card Grid.Row="2" Margin="0,12,0,0" Padding="12">
                        <TextBlock Text="💡 หมายเหตุ: ระบบจะจับคู่แอป TikTok LIVE Studio ไปยัง Proxy ที่เลือกไว้ใน Proxifier โดยอัตโนมัติ" 
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </ui:Card>
                </Grid>
            </TabItem>

            <!-- TAB 3: AUTO-REPLY RULES -->
            <TabItem Header="🤖 กฎบอทตอบกลับแชท (Auto Reply)">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,12">
                        <StackPanel DockPanel.Dock="Left">
                            <TextBlock Text="ระบบตอบกลับข้อความอัตโนมัติผ่าน CDP ทางการ" FontSize="16" FontWeight="SemiBold" />
                            <TextBlock Text="รองรับการใช้ Token เช่น {User}, {Nickname}, {GiftName}, {Diamonds} ในเทมเพลต" 
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,4,0,0" />
                        </StackPanel>
                        <ui:Button DockPanel.Dock="Right" Content="+ เพิ่มกฎใหม่" Command="{Binding AddRuleCommand}" />
                    </DockPanel>

                    <DataGrid Grid.Row="1" ItemsSource="{Binding Rules}" AutoGenerateColumns="False" 
                              CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal">
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Header="เปิดใช้" Binding="{Binding IsEnabled}" Width="70" />
                            <DataGridTextColumn Header="ชื่อกฎ" Binding="{Binding Name}" Width="160" />
                            <DataGridTextColumn Header="ประเภทเงื่อนไข" Binding="{Binding TriggerType}" Width="140" />
                            <DataGridTextColumn Header="คำสั่ง/คีย์เวิร์ด (Pattern)" Binding="{Binding Pattern}" Width="140" />
                            <DataGridTextColumn Header="เพชรขั้นต่ำ" Binding="{Binding MinDiamonds}" Width="90" />
                            <DataGridTextColumn Header="ข้อความตอบกลับ (Response Template)" Binding="{Binding ResponseTemplate}" Width="*" />
                            <DataGridTextColumn Header="Cooldown (วิ)" Binding="{Binding CooldownSeconds}" Width="90" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- TAB 4: SETTINGS -->
            <TabItem Header="⚙️ ตั้งค่าระบบ (Settings)">
                <ScrollViewer Margin="0,12,0,0">
                    <StackPanel>
                        <ui:Card Padding="16" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="พาธโปรแกรมที่เกี่ยวข้อง (Executable Paths)" FontWeight="Bold" FontSize="15" Margin="0,0,0,8" />
                                
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="220" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Studio Exe -->
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="TikTok LIVE Studio.exe:" VerticalAlignment="Center" Margin="0,6" />
                                    <ui:TextBox Grid.Row="0" Grid.Column="1" Text="{Binding StudioExePath, UpdateSourceTrigger=PropertyChanged}" Margin="0,6" />

                                    <!-- Proxifier Exe -->
                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Proxifier.exe:" VerticalAlignment="Center" Margin="0,6" />
                                    <ui:TextBox Grid.Row="1" Grid.Column="1" Text="{Binding ProxifierExePath, UpdateSourceTrigger=PropertyChanged}" Margin="0,6" />

                                    <!-- Proxifier Profile Path -->
                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="ไฟล์โปรไฟล์ Proxifier (.ppx):" VerticalAlignment="Center" Margin="0,6" />
                                    <ui:TextBox Grid.Row="2" Grid.Column="1" Text="{Binding ProxifierProfilePath, UpdateSourceTrigger=PropertyChanged}" Margin="0,6" />
                                </Grid>
                            </StackPanel>
                        </ui:Card>

                        <ui:Card Padding="16" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="การรีดประสิทธิภาพ (Resource Optimization)" FontWeight="Bold" FontSize="15" Margin="0,0,0,8" />
                                <CheckBox Content="ซ่อนหน้าต่าง UI โดยอัตโนมัติเมื่อสั่งเปิดโปรแกรม (Auto-Hide on Launch)" 
                                          IsChecked="{Binding AutoHideOnLaunch}" />
                                <TextBlock Text="ระบบจะเรียก Win32 API สั่ง SW_HIDE ทันทีหลังจากสตูดิโอเริ่มทำงาน ทำให้ Chromium Compositor พักการเรนเดอร์ภาพ ช่วยลด GPU Usage ได้ 50-70%" 
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="24,6,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                        </ui:Card>

                        <DockPanel LastChildFill="False">
                            <ui:Button DockPanel.Dock="Right" Appearance="Primary" Content="บันทึกการตั้งค่าทั้งหมด" 
                                       Command="{Binding SaveSettingsCommand}" Padding="20,8" />
                        </DockPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- 4. Bottom Status Bar -->
        <Border Grid.Row="2" Background="{DynamicResource SurfaceStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" Padding="16,6">
            <DockPanel LastChildFill="False">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <TextBlock Text="สถานะระบบ: " Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <TextBlock Text="{Binding StatusNotification}" FontWeight="SemiBold" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                    <TextBlock Text="{Binding Instances.Count, StringFormat='จำนวนบัญชีทั้งหมด: {0}'}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
